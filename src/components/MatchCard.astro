---
import type { Fixture } from '../types';
import { loadTeams, getTeamLogo, getMatchDetailSlug, CURRENT_SEASON, type Season } from '../utils/dataLoader';
import { formatDateLong } from '../utils/dates';

interface Props {
  match: Fixture;
  season?: Season;
}

const { match, season = CURRENT_SEASON } = Astro.props;
const teams = await loadTeams(season);

const isPersiboHome = match.home_team.toUpperCase().includes('PERSIBO');
const isPersiboAway = match.away_team.toUpperCase().includes('PERSIBO');
const isCompleted = match.status === 'COMPLETED';

const [homeScore, awayScore] = match.score ? match.score.split(':') : ['', ''];
const persiboWon = isCompleted && ((isPersiboHome && parseInt(homeScore) > parseInt(awayScore)) || (isPersiboAway && parseInt(awayScore) > parseInt(homeScore)));
const persiboLost = isCompleted && ((isPersiboHome && parseInt(homeScore) < parseInt(awayScore)) || (isPersiboAway && parseInt(awayScore) < parseInt(homeScore)));

const homeTeam = match.home_team;
const awayTeam = match.away_team;

const homeTeamLogo = isPersiboHome ? '/logo-32.png' : (getTeamLogo(teams, homeTeam) || null);
const awayTeamLogo = isPersiboAway ? '/logo-32.png' : (getTeamLogo(teams, awayTeam) || null);

const statusLabel = isCompleted ? (persiboWon ? 'MENANG' : persiboLost ? 'KALAH' : 'SERI') : 'JADWAL';
const statusClass = isCompleted
  ? persiboWon
    ? 'border-green-500/40 text-green-400'
    : persiboLost
      ? 'border-red-500/40 text-red-400'
      : 'border-yellow-500/40 text-yellow-400'
  : 'border-primary/40 text-primary';
---

<article class="relative border border-white/12 bg-[#0c0b0f] p-4 transition-colors hover:border-primary/50">
  <div class="flex items-center justify-between gap-2 border-b border-white/10 pb-2.5">
    <span class="text-[9px] font-bold uppercase tracking-[0.18em] text-white/40">{formatDateLong(match.date)}</span>
    <span class={`border px-1.5 py-0.5 text-[8px] font-bold uppercase tracking-[0.14em] ${statusClass}`}>
      {statusLabel}
    </span>
  </div>

  <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 py-4">
    <div class="min-w-0">
      <div class="flex items-center gap-1.5">
        {homeTeamLogo && (
          <img
            src={homeTeamLogo}
            alt={`Logo ${homeTeam}`}
            class="h-7 w-7 shrink-0 object-contain"
            width="28"
            height="28"
            loading="lazy"
          />
        )}
        <p class={`font-cond text-[15px] font-semibold uppercase leading-[0.95] sm:text-lg ${isPersiboHome ? 'text-white' : 'text-white/70'}`}>
          {homeTeam}
        </p>
      </div>
    </div>

    <div class="flex min-w-[64px] flex-col items-center gap-1">
      {isCompleted ? (
        <span class={`font-cond text-3xl font-bold leading-none tnum ${
          persiboWon ? 'text-green-400' : persiboLost ? 'text-red-400' : 'text-yellow-400'
        }`}>
          {homeScore}<span class="px-1 text-white/25">:</span>{awayScore}
        </span>
      ) : (
        <>
          <span class="font-cond text-2xl font-semibold leading-none text-white/25">VS</span>
          <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-white/45">{match.time ?? '15.30'}</span>
        </>
      )}
    </div>

    <div class="flex min-w-0 flex-row-reverse items-center gap-1.5 text-right">
      {awayTeamLogo && (
        <img
          src={awayTeamLogo}
          alt={`Logo ${awayTeam}`}
          class="h-7 w-7 shrink-0 object-contain"
          width="28"
          height="28"
          loading="lazy"
        />
      )}
      <p class={`font-cond text-[15px] font-semibold uppercase leading-[0.95] sm:text-lg ${isPersiboAway ? 'text-white' : 'text-white/70'}`}>
        {awayTeam}
      </p>
    </div>
  </div>

  <div class="flex items-center justify-between gap-2 border-t border-white/10 pt-3">
    <span class="truncate text-[9px] uppercase tracking-[0.14em] text-white/30">{match.venue}</span>
    <div class="flex shrink-0 items-center gap-2">
      <a
        href={`/pertandingan/${getMatchDetailSlug(match)}`}
        class="text-[9px] font-bold uppercase tracking-[0.18em] text-primary hover:text-primary/80"
      >
        Detail →
      </a>
      {match.match_url && (
        <a
          href={match.match_url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[9px] font-bold uppercase tracking-[0.18em] text-white/40 hover:text-white"
          title="Buka di iLeague.id"
          aria-label={`Buka ${homeTeam} vs ${awayTeam} di iLeague.id`}
        >
          iLeague ↗
        </a>
      )}
    </div>
  </div>
</article>
