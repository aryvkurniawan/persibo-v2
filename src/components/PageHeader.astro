---
interface Props {
  label: string;
  title: string;
  description?: string;
  meta?: string;
}

const { label, title, description, meta } = Astro.props;
---

<header class="border-b border-white/15 pb-6">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
    <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-primary">{label}</p>
    {meta && <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/40">{meta}</span>}
  </div>
  <h1 class="font-cond mt-2 text-5xl font-bold uppercase leading-none text-white lg:text-6xl">{title}</h1>
  {description && <p class="mt-3 max-w-2xl text-sm leading-relaxed text-white/45">{description}</p>}
</header>
