---
interface Props {
  items: Array<{ label: string; href: string }>;
}

const { items } = Astro.props;
---

<nav class="mb-6" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1.5 text-[11px] font-bold uppercase tracking-[0.16em]">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span class="text-white/20">/</span>}
        {index === items.length - 1 ? (
          <span class="text-white/50">{item.label}</span>
        ) : (
          <a href={item.href} class="inline-flex items-center text-white/30 transition-colors hover:text-primary">
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    "item": `${Astro.site || 'https://persibo.com'}${item.href}`
  }))
})} />
