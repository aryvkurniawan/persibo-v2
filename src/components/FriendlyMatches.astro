---
import type { Friendly } from '../types';
import LastMatchCard from './LastMatchCard.astro';

interface Props {
  matches: Friendly[];
}

const { matches } = Astro.props;

const [latest, ...earlier] = matches;
const played = matches.filter((m) => m.home_score !== null && m.away_score !== null);
const results = played.map((m) => {
  const persiboHome = m.home_team.toUpperCase().includes('PERSIBO');
  const own = (persiboHome ? m.home_score : m.away_score) ?? 0;
  const opp = (persiboHome ? m.away_score : m.home_score) ?? 0;
  return own > opp ? 'menang' : own < opp ? 'kalah' : 'seri';
});
const wins = results.filter((r) => r === 'menang').length;
const draws = results.filter((r) => r === 'seri').length;
const losses = results.filter((r) => r === 'kalah').length;
const summary = [`${wins} menang`, draws ? `${draws} seri` : '', `${losses} kalah`].filter(Boolean).join(' · ');
---

{
  latest && (
    <section class="border-b border-white/15">
      <div class="mx-auto max-w-7xl px-4 py-6 lg:px-8">
        <div class="mb-4 flex items-end justify-between border-b border-white/10 pb-3">
          <div>
            <p class="text-[11px] font-bold uppercase tracking-[0.24em] text-primary">
              Pramusim · {matches.length} laga
            </p>
            <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide">Uji coba</h2>
          </div>
          <span class="text-[11px] uppercase tracking-[0.18em] text-white/30">
            {summary}
          </span>
        </div>

        <div class="proto-scroll flex snap-x items-stretch gap-3 overflow-x-auto pb-2">
          <LastMatchCard match={latest} size="large" />
          {earlier.map((match) => <LastMatchCard match={match} size="small" />)}
        </div>
      </div>
    </section>
  )
}
