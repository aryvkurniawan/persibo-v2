---
interface Props {
  positions?: string[];
  onFilterChange?: string;
}

const { positions = ['P. GAWANG', 'BELAKANG', 'TENGAH', 'DEPAN'], onFilterChange = 'handleFilterChange' } = Astro.props;
---

<div class="rounded-xl bg-slate-800/50 shadow-lg p-4 mb-6">
  <h3 class="font-semibold text-white mb-4">Filter</h3>
  <div class="space-y-3">
    <div>
      <label class="block text-sm font-medium text-slate-300 mb-2">Posisi</label>
      <select
        id="position-filter"
        class="w-full px-4 py-3 bg-black/30 border border-primary/20 rounded-lg text-white focus:ring-2 focus:ring-primary focus:border-primary min-h-[44px] text-base"
      >
        <option value="">Semua Posisi</option>
        {positions.map((pos) => (
          <option value={pos}>{pos}</option>
        ))}
      </select>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-300 mb-2">Usia</label>
      <select
        id="age-filter"
        class="w-full px-4 py-3 bg-black/30 border border-primary/20 rounded-lg text-white focus:ring-2 focus:ring-primary focus:border-primary min-h-[44px] text-base"
      >
        <option value="">Semua Usia</option>
        <option value="18-22">18-22 tahun</option>
        <option value="23-27">23-27 tahun</option>
        <option value="28-32">28-32 tahun</option>
        <option value="33+">33+ tahun</option>
      </select>
    </div>
    <button
      id="reset-filter"
      class="w-full bg-slate-700 text-white py-3 rounded-lg hover:bg-slate-600 transition-colors min-h-[44px] font-medium"
    >
      Reset Filter
    </button>
  </div>
</div>
