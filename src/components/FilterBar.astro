---
interface Props {
  positions?: string[];
  onFilterChange?: string;
}

const { positions = ['P. GAWANG', 'BELAKANG', 'TENGAH', 'DEPAN'], onFilterChange = 'handleFilterChange' } = Astro.props;
---

<div class="border border-white/12 bg-[#0c0b0f] p-4">
  <h3 class="border-b border-white/10 pb-3 text-[9px] font-bold uppercase tracking-[0.22em] text-primary">Filter</h3>
  <div class="mt-4 space-y-4">
    <div>
      <label class="mb-1.5 block text-[9px] font-bold uppercase tracking-[0.16em] text-white/40" for="position-filter">Posisi</label>
      <select
        id="position-filter"
        class="min-h-[44px] w-full border border-white/15 bg-black/30 px-3 py-2.5 text-sm text-white focus:border-primary focus:outline-none"
      >
        <option value="">Semua Posisi</option>
        {positions.map((pos) => (
          <option value={pos}>{pos}</option>
        ))}
      </select>
    </div>
    <div>
      <label class="mb-1.5 block text-[9px] font-bold uppercase tracking-[0.16em] text-white/40" for="age-filter">Usia</label>
      <select
        id="age-filter"
        class="min-h-[44px] w-full border border-white/15 bg-black/30 px-3 py-2.5 text-sm text-white focus:border-primary focus:outline-none"
      >
        <option value="">Semua Usia</option>
        <option value="18-22">18-22 tahun</option>
        <option value="23-27">23-27 tahun</option>
        <option value="28-32">28-32 tahun</option>
        <option value="33+">33+ tahun</option>
      </select>
    </div>
    <button
      id="reset-filter"
      class="min-h-[44px] w-full border border-white/20 py-2.5 text-[10px] font-bold uppercase tracking-[0.18em] text-white/70 transition-colors hover:border-primary hover:text-primary"
    >
      Reset Filter
    </button>
  </div>
</div>
