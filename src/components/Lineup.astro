---
import type { MatchDetailLineup, MatchDetailPlayer } from '../types';
import { loadPlayers } from '../utils/dataLoader';

interface Props {
  lineup: MatchDetailLineup;
  teamName: string;
  isHome: boolean;
}

const { lineup, teamName, isHome } = Astro.props;
const players = await loadPlayers();

// Filter out invalid players (those with weird names or jersey numbers)
const isValidPlayer = (p: MatchDetailPlayer): boolean => {
  // Check name exists and is string
  if (!p.name || typeof p.name !== 'string') return false;
  
  const name = p.name.trim();
  
  // Length validation (3-50 characters)
  if (name.length < 3 || name.length > 50) return false;
  
  // Must contain at least one letter (not just numbers/spaces)
  if (!/[A-Za-z]/.test(name)) return false;
  
  // Cannot be only digits
  if (/^\d+$/.test(name)) return false;
  
  // Cannot start with digit followed by letters (e.g., "15ACHMAD")
  if (/^\d+[A-Za-z]/.test(name)) return false;
  
  // Cannot be only digits and spaces (e.g., "9 14 78 23 88...")
  if (/^[\d\s]+$/.test(name)) return false;
  
  // Cannot have 5+ consecutive digits (likely scraped error)
  if (/\d{5,}/.test(name)) return false;
  
  // Jersey number validation (1-99)
  if (!p.jersey_number || typeof p.jersey_number !== 'number') return false;
  if (p.jersey_number < 1 || p.jersey_number > 99) return false;
  
  return true;
};

const validStartingXI = lineup.starting_xi.filter(isValidPlayer);
const validSubstitutes = lineup.substitutes.filter(isValidPlayer);

// The scrape repeats players; keep the first occurrence of each shirt number + name.
const uniquePlayers = (list: MatchDetailPlayer[]) => {
  const seen = new Set<string>();
  return list.filter((p) => {
    const key = `${p.jersey_number}:${p.name}`;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
};

// Group players by position
const groupByPosition = (players: MatchDetailPlayer[]) => {
  const grouped: Record<string, MatchDetailPlayer[]> = {};
  players.forEach(player => {
    const position = player.position || 'Lainnya';
    if (!grouped[position]) {
      grouped[position] = [];
    }
    grouped[position].push(player);
  });
  return grouped;
};

const startingXIGrouped = groupByPosition(uniquePlayers(validStartingXI));
const uniqueSubs = uniquePlayers(validSubstitutes);
const positionOrder = ['Penjaga Gawang', 'Belakang', 'Gelandang', 'Penyerang', 'Lainnya'];
---

<div class="border border-white/12 bg-[#0c0b0f]">
  <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-white/10 px-4 py-3">
    <h3 class="font-cond text-xl font-semibold uppercase leading-none text-white">{teamName}</h3>
    {lineup.coach && (
      <span class="text-[9px] uppercase tracking-[0.14em] text-white/35">Pelatih: {lineup.coach}</span>
    )}
  </div>

  <!-- Starting XI -->
  <div class="px-4 py-3">
    <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-primary">Starting XI</p>
    <div class="mt-2 space-y-3">
      {positionOrder.map(position => {
        const playersInPosition = startingXIGrouped[position] || [];
        if (playersInPosition.length === 0) return null;

        return (
          <div key={position}>
            <p class="mb-1.5 text-[8px] font-bold uppercase tracking-[0.16em] text-white/30">{position}</p>
            <div class="grid grid-cols-1 gap-1 sm:grid-cols-2">
              {playersInPosition.map((player) => {
                const playerData = players.find(p =>
                  p.name.toLowerCase().includes(player.name.toLowerCase().split(' ')[0]) ||
                  player.name.toLowerCase().includes(p.name.toLowerCase().split(' ')[0])
                );
                const slug = playerData ? playerData.name.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '') : null;

                return (
                  <div class="flex items-center gap-2 py-1">
                    <span class="w-6 shrink-0 text-right font-cond text-sm font-bold leading-none text-primary tnum">{player.jersey_number}</span>
                    {slug ? (
                      <a href={`/pemain/${slug}`} class="block truncate text-[13px] text-white/85 transition-colors hover:text-primary">
                        {player.name}
                      </a>
                    ) : (
                      <span class="block truncate text-[13px] text-white/85">{player.name}</span>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Substitutes -->
  {uniqueSubs.length > 0 && (
    <div class="border-t border-white/10 px-4 py-3">
      <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-white/35">Cadangan</p>
      <div class="mt-2 grid grid-cols-1 gap-1 sm:grid-cols-2">
        {uniqueSubs.map((player) => {
          const playerData = players.find(p =>
            p.name.toLowerCase().includes(player.name.toLowerCase().split(' ')[0]) ||
            player.name.toLowerCase().includes(p.name.toLowerCase().split(' ')[0])
          );
          const slug = playerData ? playerData.name.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '') : null;

          return (
            <div class="flex items-center gap-2 py-1">
              <span class="w-6 shrink-0 text-right font-cond text-sm font-bold leading-none text-white/30 tnum">{player.jersey_number}</span>
              {slug ? (
                <a href={`/pemain/${slug}`} class="block truncate text-[13px] text-white/60 transition-colors hover:text-primary">
                  {player.name}
                </a>
              ) : (
                <span class="block truncate text-[13px] text-white/60">{player.name}</span>
              )}
            </div>
          );
        })}
      </div>
    </div>
  )}
</div>
