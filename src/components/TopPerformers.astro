---
import type { PlayerDetail } from '../types';
import { loadPlayerDetails } from '../utils/dataLoader';

interface Props {
  currentPlayer: PlayerDetail;
  statType: 'goals' | 'appearances' | 'saves';
  limit?: number;
}

const { currentPlayer, statType, limit = 5 } = Astro.props;
const allPlayers = await loadPlayerDetails();
const persiboPlayers = allPlayers.filter(p => p.club === 'PERSIBO Bojonegoro');

// Only rows recomputed from our match details are summed; iLeague's scraped
// "Penampilan" counts squad listings and would rank everyone at ~79.
const trusted = (p: PlayerDetail) => (p.club_history || []).filter(h => h.source === 'derived:matchDetails');
const sumField = (p: PlayerDetail, field: 'goals' | 'appearances' | 'saves') =>
  trusted(p).reduce((sum, h) => sum + (parseInt(h[field]) || 0), 0);

// Get top performers based on stat type
let topPerformers: Array<{ player: PlayerDetail; value: number }> = [];

if (statType === 'goals') {
  topPerformers = persiboPlayers
    .map(p => {
      return { player: p, value: sumField(p, 'goals') || p.statistics.goals };
    })
    .filter(p => p.value > 0)
    .sort((a, b) => b.value - a.value)
    .slice(0, limit);
} else if (statType === 'appearances') {
  topPerformers = persiboPlayers
    .map(p => {
      return { player: p, value: sumField(p, 'appearances') || p.statistics.appearances };
    })
    .filter(p => p.value > 0)
    .sort((a, b) => b.value - a.value)
    .slice(0, limit);
} else if (statType === 'saves') {
  topPerformers = persiboPlayers
    .filter(p => p.position?.toUpperCase().includes('GAWANG'))
    .map(p => {
      return { player: p, value: sumField(p, 'saves') };
    })
    .filter(p => p.value > 0)
    .sort((a, b) => b.value - a.value)
    .slice(0, limit);
}

const currentPlayerValue = statType === 'goals'
  ? (sumField(currentPlayer, 'goals') || currentPlayer.statistics.goals)
  : statType === 'appearances'
  ? (sumField(currentPlayer, 'appearances') || currentPlayer.statistics.appearances)
  : sumField(currentPlayer, 'saves');

const currentPlayerRank = topPerformers.findIndex(p => p.player.name === currentPlayer.name) + 1;
const maxValue = topPerformers.length > 0 ? topPerformers[0].value : 1;
---

{topPerformers.length > 0 && (
  <div class="border border-white/12 bg-[#0c0b0f] p-4">
    <div class="mb-3 flex items-center justify-between border-b border-white/10 pb-3">
      <h4 class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">
        {statType === 'goals' && 'Top Scorer'}
        {statType === 'appearances' && 'Most Appearances'}
        {statType === 'saves' && 'Top Goalkeeper'}
      </h4>
      {currentPlayerRank > 0 && currentPlayerRank <= limit && (
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40">Peringkat #{currentPlayerRank}</span>
      )}
    </div>

    <div class="space-y-2">
      {topPerformers.map((item, index) => {
        const slug = item.player.name.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '');
        const isCurrentPlayer = item.player.name === currentPlayer.name;
        const percentage = maxValue > 0 ? (item.value / maxValue) * 100 : 0;
        
        return (
          <a
            href={`/pemain/${slug}`}
            class={`block border-l-2 px-2 py-1.5 transition-colors ${
              isCurrentPlayer
                ? 'border-primary bg-primary/10'
                : 'border-transparent hover:border-white/20'
            }`}
          >
            <div class="flex items-center justify-between gap-2">
              <div class="flex min-w-0 items-center gap-2">
                <span class={`w-4 shrink-0 text-[10px] font-bold tnum ${isCurrentPlayer ? 'text-primary' : 'text-white/30'}`}>{index + 1}</span>
                <p class={`truncate text-[13px] ${isCurrentPlayer ? 'font-semibold text-primary' : 'text-white/85'}`}>
                  {item.player.name}
                </p>
              </div>
              <span class={`shrink-0 font-cond text-lg font-semibold leading-none tnum ${isCurrentPlayer ? 'text-primary' : 'text-white'}`}>
                {item.value}
              </span>
            </div>
            <div class="mt-1.5 h-0.5 w-full bg-white/5">
              <div
                class={`h-full ${isCurrentPlayer ? 'bg-primary' : 'bg-white/25'}`}
                style={`width: ${percentage}%`}
              ></div>
            </div>
          </a>
        );
      })}
      
      {currentPlayerRank > limit && (
        <div class="mt-2 border-t border-white/10 pt-2">
          <div class="flex items-center justify-between px-2 py-1.5">
            <div class="flex min-w-0 items-center gap-2">
              <span class="w-4 shrink-0 text-[10px] font-bold text-primary tnum">{currentPlayerRank}</span>
              <p class="truncate text-[13px] font-semibold text-primary">{currentPlayer.name}</p>
            </div>
            <span class="shrink-0 font-cond text-lg font-semibold leading-none text-primary tnum">{currentPlayerValue}</span>
          </div>
        </div>
      )}
    </div>
  </div>
)}
