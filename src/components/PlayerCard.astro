---
import type { Player } from '../types';

interface Props {
  player: Player;
}

const { player } = Astro.props;
const slug = player.name.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '');
const photo = player.photo_local || player.photo_url;
---

<a
  href={`/pemain/${slug}`}
  class="group flex flex-col border border-white/12 bg-[#0c0b0f] transition-colors hover:border-primary/50"
  data-player-card
  data-player-name={player.name}
  data-player-position={player.position || ''}
  data-player-age={player.age}
>
  <div class="relative aspect-[4/5] w-full overflow-hidden bg-[#161318]">
    {photo ? (
      <img
        src={photo}
        alt={`Foto ${player.name}, ${player.position} PERSIBO Bojonegoro nomor ${player.jersey_number}`}
        class="h-full w-full object-cover object-top opacity-90 transition-opacity group-hover:opacity-100"
        loading="lazy"
        width="400"
        height="500"
      />
    ) : (
      <div class="flex h-full items-center justify-center font-cond text-6xl font-bold text-white/10">
        {player.jersey_number}
      </div>
    )}
    <span class="absolute left-0 top-0 bg-primary px-2 py-1 font-cond text-lg font-bold leading-none text-[#08070a] tnum">
      {player.jersey_number}
    </span>
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-[#0c0b0f] to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 p-3">
      <p class="text-[8px] font-bold uppercase tracking-[0.16em] text-primary">{player.position || 'Pemain'}</p>
      <h3 class="mt-0.5 truncate font-cond text-2xl font-semibold uppercase leading-none text-white">{player.name}</h3>
    </div>
  </div>

  <div class="flex items-center justify-between border-t border-white/10 px-3 py-2.5">
    <span class="truncate text-[9px] uppercase tracking-[0.14em] text-white/35">{player.age} thn</span>
    <span class="shrink-0 text-[9px] font-bold uppercase tracking-[0.18em] text-white/45 transition-colors group-hover:text-primary">Profil →</span>
  </div>
</a>
