---
import type { Standing } from '../types';
import { loadTeams, getTeamLogo, CURRENT_SEASON, type Season } from '../utils/dataLoader';

interface Props {
  standings: Standing[];
  group: string;
  highlightTeam?: string;
  season?: Season;
}

const { standings, group, highlightTeam = 'PERSIBO', season = CURRENT_SEASON } = Astro.props;
const groupStandings = standings.filter(s => s.group === group).sort((a, b) => a.position - b.position);
const teams = await loadTeams(season);
const isHighlighted = (club: string) => club.toUpperCase().includes(highlightTeam.toUpperCase());

const th = 'px-1.5 py-2.5 text-right text-[11px] font-bold uppercase tracking-[0.16em] text-white/30 sm:px-2 lg:px-3';
const td = 'px-1.5 py-2.5 text-right text-[11px] tnum sm:px-2 lg:px-3';
---

<div class="overflow-hidden border border-white/12 bg-[#0c0b0f]">
  <div class="overflow-x-auto">
    <table class="w-full table-fixed">
      <thead>
        <tr class="border-b border-white/10">
          <th class="w-7 px-1.5 py-2.5 text-left sm:px-2 text-[11px] font-bold uppercase tracking-[0.16em] text-white/30 lg:px-3">#</th>
          <th class="px-1.5 py-2.5 text-left sm:px-2 text-[11px] font-bold uppercase tracking-[0.16em] text-white/30 lg:px-3">Klub</th>
          <th class={`${th} w-10`}>Main</th>
          <th class={`${th} hidden w-9 sm:table-cell`}>M</th>
          <th class={`${th} hidden w-9 sm:table-cell`}>S</th>
          <th class={`${th} hidden w-9 sm:table-cell`}>K</th>
          <th class={`${th} hidden w-10 sm:table-cell`}>SG</th>
          <th class={`${th} w-10`}>Pts</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/5">
        {groupStandings.map((standing) => {
          const isPersibo = isHighlighted(standing.club);
          const teamLogo = isPersibo ? '/logo-32.png' : (getTeamLogo(teams, standing.club) || null);
          return (
            <tr class={`transition-colors hover:bg-white/[0.03] ${isPersibo ? 'bg-primary/10' : ''}`}>
              <td class={`${td} text-left ${isPersibo ? 'text-primary' : 'text-white/35'}`}>{standing.position}</td>
              <td class="px-1.5 py-2.5 sm:px-2 lg:px-3">
                <div class="flex items-center gap-2">
                  {teamLogo && (
                    <img
                      src={teamLogo}
                      alt=""
                      class="h-5 w-5 shrink-0 object-contain"
                      loading="lazy"
                      width="20"
                      height="20"
                    />
                  )}
                  <span class={`line-clamp-2 text-[10px] font-semibold uppercase leading-tight tracking-wide sm:line-clamp-1 sm:text-[11px] ${isPersibo ? 'text-primary' : 'text-white/80'}`}>
                    {standing.club}
                  </span>
                </div>
              </td>
              <td class={`${td} ${isPersibo ? 'text-primary' : 'text-white/40'}`}>{standing.played}</td>
              <td class={`${td} hidden sm:table-cell ${isPersibo ? 'text-primary' : 'text-white/60'}`}>{standing.won}</td>
              <td class={`${td} hidden sm:table-cell ${isPersibo ? 'text-primary' : 'text-white/60'}`}>{standing.drawn}</td>
              <td class={`${td} hidden sm:table-cell ${isPersibo ? 'text-primary' : 'text-white/60'}`}>{standing.lost}</td>
              <td class={`${td} hidden sm:table-cell ${isPersibo ? 'text-primary' : 'text-white/60'}`}>{standing.goal_diff > 0 ? `+${standing.goal_diff}` : standing.goal_diff}</td>
              <td class={`${td} font-bold ${isPersibo ? 'text-primary' : 'text-white'}`}>{standing.points}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>
