---
import type { PlayerDetail } from '../types';

interface Props {
  player: PlayerDetail;
}

const { player } = Astro.props;

// One point per season. iLeague files each competition separately, so a player
// with a league and a youth-league campaign in the same year would otherwise
// plot twice on the same x value and draw a spike that never happened.
const bySeason = new Map<string, { appearances: number; goals: number; saves: number; yellow: number; red: number }>();
for (const h of player.club_history || []) {
  const year = parseInt(h.year);
  if (isNaN(year) || year < 2010 || year > 2030) continue;
  const key = String(year);
  const bucket = bySeason.get(key) ?? { appearances: 0, goals: 0, saves: 0, yellow: 0, red: 0 };
  const cards = h.cards?.split('/').map((c) => parseInt(c.trim()) || 0) ?? [0, 0];
  bucket.appearances += parseInt(h.appearances) || 0;
  bucket.goals += parseInt(h.goals) || 0;
  bucket.saves += parseInt(h.saves) || 0;
  bucket.yellow += cards[0] || 0;
  bucket.red += cards[1] || 0;
  bySeason.set(key, bucket);
}

const chartData = [...bySeason.entries()]
  .sort((a, b) => parseInt(a[0]) - parseInt(b[0]))
  .map(([year, s]) => ({
    year,
    competition: '',
    appearances: s.appearances,
    goals: s.goals,
    saves: s.saves,
    cards: [s.yellow, s.red],
  }));

// Show chart if there's any valid history data (even if all stats are 0, show the chart)
const hasHistory = chartData.length > 0;
const totalAppearances = chartData.reduce((sum, d) => sum + d.appearances, 0);
const totalGoals = chartData.reduce((sum, d) => sum + d.goals, 0);
const totalSaves = chartData.reduce((sum, d) => sum + d.saves, 0);
const totalYellowCards = chartData.reduce((sum, d) => sum + (d.cards[0] || 0), 0);
const totalRedCards = chartData.reduce((sum, d) => sum + (d.cards[1] || 0), 0);

// Calculate assists (estimated from club history if available)
const assists = 0; // Will be populated if data available
---

{hasHistory && (
  <div class="space-y-6">
    <!-- Season Statistics Chart -->
    <div class="border border-white/12 bg-[#0c0b0f] p-4">
      <h4 class="mb-3 border-b border-white/10 pb-3 text-[11px] font-bold uppercase tracking-[0.18em] text-primary">Statistik Per Musim</h4>
      <div class="space-y-4">
        <!-- Chart Container -->
        <div class="relative h-64 lg:h-80">
          <canvas 
            id={`season-chart-${player.name.replace(/\s+/g, '-')}`}
            data-chart-data={JSON.stringify(chartData)}
            data-player-position={player.position || ''}
            data-player-name={player.name}
          ></canvas>
        </div>
        
        <!-- Legend -->
        <div class="flex flex-wrap gap-4 text-sm">
          <div class="flex items-center gap-2">
            <div class="h-2 w-2 bg-primary"></div>
            <span class="text-white/45">Main</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="h-2 w-2 bg-accent-teal"></div>
            <span class="text-white/45">Gol</span>
          </div>
          {player.position?.toUpperCase().includes('GAWANG') && totalSaves > 0 && (
            <div class="flex items-center gap-2">
              <div class="h-2 w-2 bg-yellow-500"></div>
              <span class="text-white/45">Saves</span>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Career Totals -->
    <div class="border border-white/12 bg-[#0c0b0f] p-4">
      <h4 class="mb-3 border-b border-white/10 pb-3 text-[11px] font-bold uppercase tracking-[0.18em] text-primary">Total Karir</h4>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="flex flex-col">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/35 mb-1">Total Main</p>
          <p class="text-2xl font-bold text-white">{totalAppearances}</p>
        </div>
        <div class="flex flex-col">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/35 mb-1">Total Gol</p>
          <p class="text-2xl font-bold text-accent-teal">{totalGoals}</p>
        </div>
        {player.position?.toUpperCase().includes('GAWANG') && totalSaves > 0 && (
          <div class="flex flex-col">
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/35 mb-1">Total Saves</p>
            <p class="text-2xl font-bold text-yellow-500">{totalSaves}</p>
          </div>
        )}
        {totalYellowCards > 0 && (
          <div class="flex flex-col">
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/35 mb-1">Kartu Kuning</p>
            <p class="text-2xl font-bold text-yellow-500">{totalYellowCards}</p>
          </div>
        )}
        {totalRedCards > 0 && (
          <div class="flex flex-col">
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-white/35 mb-1">Kartu Merah</p>
            <p class="text-2xl font-bold text-red-500">{totalRedCards}</p>
          </div>
        )}
      </div>
    </div>
  </div>
)}

<script is:inline>
  (function() {
    function initChart() {
      // Find all canvas elements with chart data
      const canvases = document.querySelectorAll('canvas[data-chart-data]');
      
      canvases.forEach((canvas) => {
        const chartDataStr = canvas.getAttribute('data-chart-data');
        const playerPosition = canvas.getAttribute('data-player-position') || '';
        const playerName = canvas.getAttribute('data-player-name') || '';
        
        if (!chartDataStr) return;
        
        let chartData;
        try {
          chartData = JSON.parse(chartDataStr);
        } catch (e) {
          console.error('Error parsing chart data:', e);
          return;
        }
        
        if (!chartData || chartData.length === 0) {
          console.log('No chart data for', playerName);
          return;
        }
        
        // Load Chart.js via script tag if not already loaded (lazy load with intersection observer)
        function loadChartAndInit() {
          if (window.Chart) {
            createChart(window.Chart);
            return;
          }
          
          // Use Intersection Observer to load Chart.js only when chart is visible
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                observer.unobserve(entry.target);
                
                // Load Chart.js only when chart is visible
                if (window.Chart) {
                  createChart(window.Chart);
                  return;
                }
                
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js';
                script.async = true;
                script.onload = function() {
                  if (window.Chart) {
                    createChart(window.Chart);
                  } else {
                    console.error('Chart.js loaded but Chart not available on window');
                  }
                };
                script.onerror = function() {
                  console.error('Failed to load Chart.js');
                };
                document.head.appendChild(script);
              }
            });
          }, { rootMargin: '50px' }); // Start loading 50px before chart is visible
          
          observer.observe(canvas);
        }
        
        function createChart(ChartConstructor) {
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            console.error('Could not get 2d context');
            return;
          }
          
          const labels = chartData.map(d => d.year);
          const appearances = chartData.map(d => d.appearances);
          const goals = chartData.map(d => d.goals);
          const saves = chartData.map(d => d.saves);
          
          const datasets = [
            {
              label: 'Main',
              data: appearances,
              borderColor: 'rgb(249, 115, 22)',
              backgroundColor: 'rgba(249, 115, 22, 0.12)',
              tension: 0.4,
              yAxisID: 'y',
            },
            {
              label: 'Gol',
              data: goals,
              borderColor: 'rgb(20, 184, 166)',
              backgroundColor: 'rgba(20, 184, 166, 0.12)',
              tension: 0.4,
              yAxisID: 'y',
            }
          ];

          // Add saves dataset if player is goalkeeper
          const isGoalkeeper = playerPosition.toUpperCase().includes('GAWANG');
          const totalSaves = chartData.reduce((sum, d) => sum + d.saves, 0);
          
          if (isGoalkeeper && totalSaves > 0) {
            datasets.push({
              label: 'Saves',
              data: saves,
              borderColor: 'rgb(234, 179, 8)',
              backgroundColor: 'rgba(234, 179, 8, 0.1)',
              tension: 0.4,
              yAxisID: 'y1',
            });
          }

          new ChartConstructor(ctx, {
            type: 'line',
            data: { labels, datasets },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  display: false,
                },
                tooltip: {
                  mode: 'index',
                  intersect: false,
                  backgroundColor: 'rgba(12, 11, 15, 0.95)',
                  titleColor: 'rgb(255, 255, 255)',
                  bodyColor: 'rgb(226, 232, 240)',
                  borderColor: 'rgba(255, 255, 255, 0.1)',
                  borderWidth: 1,
                },
              },
              scales: {
                x: {
                  ticks: {
                    color: 'rgb(148, 163, 184)',
                  },
                  grid: {
                    color: 'rgba(255, 255, 255, 0.05)',
                  },
                },
                y: {
                  beginAtZero: true,
                  ticks: {
                    color: 'rgb(148, 163, 184)',
                  },
                  grid: {
                    color: 'rgba(255, 255, 255, 0.05)',
                  },
                },
                y1: {
                  type: 'linear',
                  display: isGoalkeeper && totalSaves > 0,
                  position: 'right',
                  beginAtZero: true,
                  ticks: {
                    color: 'rgb(148, 163, 184)',
                  },
                  grid: {
                    drawOnChartArea: false,
                  },
                },
              },
            },
          });
        }
        
        loadChartAndInit();
      });
    }
    
    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(initChart, 500);
      });
    } else {
      // DOM already ready, but wait for component to render
      setTimeout(initChart, 500);
    }
  })();
</script>

