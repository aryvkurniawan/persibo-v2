---
import type { PlayerDetail } from '../types';

interface Props {
  player: PlayerDetail;
}

const { player } = Astro.props;

// Parse club history untuk chart data
const chartData = (player.club_history || [])
  .filter(h => {
    // Filter out invalid years dan handle "20225" typo (should be 2025)
    let yearStr = h.year;
    if (yearStr === '20225') yearStr = '2025'; // Fix typo
    const year = parseInt(yearStr);
    return !isNaN(year) && year >= 2010 && year <= 2030;
  })
  .sort((a, b) => {
    let yearA = parseInt(a.year === '20225' ? '2025' : a.year);
    let yearB = parseInt(b.year === '20225' ? '2025' : b.year);
    return yearA - yearB;
  })
  .map(h => {
    const yearStr = h.year === '20225' ? '2025' : h.year;
    return {
      year: yearStr,
      competition: h.competition,
      appearances: parseInt(h.appearances) || 0,
      goals: parseInt(h.goals) || 0,
      saves: parseInt(h.saves) || 0,
      cards: h.cards?.split('/').map(c => parseInt(c.trim()) || 0) || [0, 0],
    };
  });

// Show chart if there's any valid history data (even if all stats are 0, show the chart)
const hasHistory = chartData.length > 0;
const totalAppearances = chartData.reduce((sum, d) => sum + d.appearances, 0);
const totalGoals = chartData.reduce((sum, d) => sum + d.goals, 0);
const totalSaves = chartData.reduce((sum, d) => sum + d.saves, 0);
const totalYellowCards = chartData.reduce((sum, d) => sum + (d.cards[0] || 0), 0);
const totalRedCards = chartData.reduce((sum, d) => sum + (d.cards[1] || 0), 0);

// Calculate assists (estimated from club history if available)
const assists = 0; // Will be populated if data available
---

{hasHistory && (
  <div class="space-y-6">
    <!-- Season Statistics Chart -->
    <div class="rounded-xl bg-background-dark/50 p-4 lg:p-6 ring-1 ring-white/10">
      <h4 class="text-lg lg:text-xl font-bold text-white mb-4">Statistik Per Musim</h4>
      <div class="space-y-4">
        <!-- Chart Container -->
        <div class="relative h-64 lg:h-80">
          <canvas 
            id={`season-chart-${player.name.replace(/\s+/g, '-')}`}
            data-chart-data={JSON.stringify(chartData)}
            data-player-position={player.position || ''}
            data-player-name={player.name}
          ></canvas>
        </div>
        
        <!-- Legend -->
        <div class="flex flex-wrap gap-4 text-sm">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-primary"></div>
            <span class="text-slate-300">Main</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-accent-teal"></div>
            <span class="text-slate-300">Gol</span>
          </div>
          {player.position?.toUpperCase().includes('GAWANG') && totalSaves > 0 && (
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <span class="text-slate-300">Saves</span>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Career Totals -->
    <div class="rounded-xl bg-background-dark/50 p-4 lg:p-6 ring-1 ring-white/10">
      <h4 class="text-lg lg:text-xl font-bold text-white mb-4">Total Karir</h4>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="flex flex-col">
          <p class="text-sm text-slate-400 mb-1">Total Main</p>
          <p class="text-2xl font-bold text-white">{totalAppearances}</p>
        </div>
        <div class="flex flex-col">
          <p class="text-sm text-slate-400 mb-1">Total Gol</p>
          <p class="text-2xl font-bold text-accent-teal">{totalGoals}</p>
        </div>
        {player.position?.toUpperCase().includes('GAWANG') && totalSaves > 0 && (
          <div class="flex flex-col">
            <p class="text-sm text-slate-400 mb-1">Total Saves</p>
            <p class="text-2xl font-bold text-yellow-500">{totalSaves}</p>
          </div>
        )}
        {totalYellowCards > 0 && (
          <div class="flex flex-col">
            <p class="text-sm text-slate-400 mb-1">Kartu Kuning</p>
            <p class="text-2xl font-bold text-yellow-500">{totalYellowCards}</p>
          </div>
        )}
        {totalRedCards > 0 && (
          <div class="flex flex-col">
            <p class="text-sm text-slate-400 mb-1">Kartu Merah</p>
            <p class="text-2xl font-bold text-red-500">{totalRedCards}</p>
          </div>
        )}
      </div>
    </div>
  </div>
)}

<script is:inline>
  (function() {
    function initChart() {
      // Find all canvas elements with chart data
      const canvases = document.querySelectorAll('canvas[data-chart-data]');
      
      canvases.forEach((canvas) => {
        const chartDataStr = canvas.getAttribute('data-chart-data');
        const playerPosition = canvas.getAttribute('data-player-position') || '';
        const playerName = canvas.getAttribute('data-player-name') || '';
        
        if (!chartDataStr) return;
        
        let chartData;
        try {
          chartData = JSON.parse(chartDataStr);
        } catch (e) {
          console.error('Error parsing chart data:', e);
          return;
        }
        
        if (!chartData || chartData.length === 0) {
          console.log('No chart data for', playerName);
          return;
        }
        
        // Load Chart.js via script tag if not already loaded (lazy load with intersection observer)
        function loadChartAndInit() {
          if (window.Chart) {
            createChart(window.Chart);
            return;
          }
          
          // Use Intersection Observer to load Chart.js only when chart is visible
          const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                observer.unobserve(entry.target);
                
                // Load Chart.js only when chart is visible
                if (window.Chart) {
                  createChart(window.Chart);
                  return;
                }
                
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js';
                script.async = true;
                script.onload = function() {
                  if (window.Chart) {
                    createChart(window.Chart);
                  } else {
                    console.error('Chart.js loaded but Chart not available on window');
                  }
                };
                script.onerror = function() {
                  console.error('Failed to load Chart.js');
                };
                document.head.appendChild(script);
              }
            });
          }, { rootMargin: '50px' }); // Start loading 50px before chart is visible
          
          observer.observe(canvas);
        }
        
        function createChart(ChartConstructor) {
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            console.error('Could not get 2d context');
            return;
          }
          
          const labels = chartData.map(d => d.year);
          const appearances = chartData.map(d => d.appearances);
          const goals = chartData.map(d => d.goals);
          const saves = chartData.map(d => d.saves);
          
          const datasets = [
            {
              label: 'Main',
              data: appearances,
              borderColor: 'rgb(59, 130, 246)',
              backgroundColor: 'rgba(59, 130, 246, 0.1)',
              tension: 0.4,
              yAxisID: 'y',
            },
            {
              label: 'Gol',
              data: goals,
              borderColor: 'rgb(34, 197, 94)',
              backgroundColor: 'rgba(34, 197, 94, 0.1)',
              tension: 0.4,
              yAxisID: 'y',
            }
          ];

          // Add saves dataset if player is goalkeeper
          const isGoalkeeper = playerPosition.toUpperCase().includes('GAWANG');
          const totalSaves = chartData.reduce((sum, d) => sum + d.saves, 0);
          
          if (isGoalkeeper && totalSaves > 0) {
            datasets.push({
              label: 'Saves',
              data: saves,
              borderColor: 'rgb(234, 179, 8)',
              backgroundColor: 'rgba(234, 179, 8, 0.1)',
              tension: 0.4,
              yAxisID: 'y1',
            });
          }

          new ChartConstructor(ctx, {
            type: 'line',
            data: { labels, datasets },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              plugins: {
                legend: {
                  display: false,
                },
                tooltip: {
                  mode: 'index',
                  intersect: false,
                  backgroundColor: 'rgba(15, 23, 42, 0.95)',
                  titleColor: 'rgb(255, 255, 255)',
                  bodyColor: 'rgb(226, 232, 240)',
                  borderColor: 'rgba(255, 255, 255, 0.1)',
                  borderWidth: 1,
                },
              },
              scales: {
                x: {
                  ticks: {
                    color: 'rgb(148, 163, 184)',
                  },
                  grid: {
                    color: 'rgba(255, 255, 255, 0.05)',
                  },
                },
                y: {
                  beginAtZero: true,
                  ticks: {
                    color: 'rgb(148, 163, 184)',
                  },
                  grid: {
                    color: 'rgba(255, 255, 255, 0.05)',
                  },
                },
                y1: {
                  type: 'linear',
                  display: isGoalkeeper && totalSaves > 0,
                  position: 'right',
                  beginAtZero: true,
                  ticks: {
                    color: 'rgb(148, 163, 184)',
                  },
                  grid: {
                    drawOnChartArea: false,
                  },
                },
              },
            },
          });
        }
        
        loadChartAndInit();
      });
    }
    
    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        setTimeout(initChart, 500);
      });
    } else {
      // DOM already ready, but wait for component to render
      setTimeout(initChart, 500);
    }
  })();
</script>

