---
interface Props {
  placeholder?: string;
  id?: string;
}

const { placeholder = 'Cari pemain...', id = 'search-input' } = Astro.props;
---

<div class="relative">
  <label class="sr-only" for={id}>Cari pemain</label>
  <input
    type="text"
    id={id}
    placeholder={placeholder}
    class="min-h-[44px] w-full border border-white/15 bg-[#0c0b0f] py-3 pl-11 pr-4 text-sm text-white placeholder-white/30 focus:border-primary focus:outline-none"
  />
  <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-lg text-white/30">search</span>
</div>
