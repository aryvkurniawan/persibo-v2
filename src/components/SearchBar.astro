---
interface Props {
  placeholder?: string;
  id?: string;
}

const { placeholder = 'Cari pemain...', id = 'search-input' } = Astro.props;
---

<div class="relative">
  <input
    type="text"
    id={id}
    placeholder={placeholder}
    class="w-full px-4 py-3 pl-12 bg-black/30 border border-primary/20 rounded-lg text-white placeholder-slate-400 focus:ring-2 focus:ring-primary focus:border-primary min-h-[44px] text-base"
  />
  <span class="material-symbols-outlined absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-400">search</span>
</div>
