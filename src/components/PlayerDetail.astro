---
import type { PlayerDetail } from '../types';
import { optimizePlayerPhoto } from '../utils/imageOptimizer';
import PlayerStatsChart from './PlayerStatsChart.astro';
import TopPerformers from './TopPerformers.astro';
import ShareButtons from './ShareButtons.astro';

interface Props {
  player: PlayerDetail;
}

const { player } = Astro.props;
const optimizedPhotoMobile = optimizePlayerPhoto(player.photo_url, 'medium');
const optimizedPhotoDesktop = optimizePlayerPhoto(player.photo_url, 'large');

// Calculate additional stats from club_history
const totalCareerAppearances = player.club_history?.reduce((sum, h) => sum + (parseInt(h.appearances) || 0), 0) || 0;
const totalCareerGoals = player.club_history?.reduce((sum, h) => sum + (parseInt(h.goals) || 0), 0) || 0;
const totalCareerSaves = player.club_history?.reduce((sum, h) => sum + (parseInt(h.saves) || 0), 0) || 0;
const isGoalkeeper = player.position?.toUpperCase().includes('GAWANG');

// Parse cards from club_history
const totalYellowCardsHistory = player.club_history?.reduce((sum, h) => {
  const cards = h.cards?.split('/') || [];
  return sum + (parseInt(cards[0]?.trim()) || 0);
}, 0) || 0;
const totalRedCardsHistory = player.club_history?.reduce((sum, h) => {
  const cards = h.cards?.split('/') || [];
  return sum + (parseInt(cards[1]?.trim()) || 0);
}, 0) || 0;

// Calculate averages
const avgGoalsPerGame = totalCareerAppearances > 0 ? (totalCareerGoals / totalCareerAppearances).toFixed(2) : '0.00';
const avgSavesPerGame = totalCareerAppearances > 0 && isGoalkeeper ? (totalCareerSaves / totalCareerAppearances).toFixed(2) : '0.00';
---

<!-- Back Button -->
<div class="px-4 lg:px-6 pt-4 pb-4">
  <a href="/pemain" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors py-2 px-3 rounded-lg hover:bg-slate-800/50">
    <span class="material-symbols-outlined text-xl">arrow_back</span>
    <span class="text-sm font-medium">Kembali ke Daftar Pemain</span>
  </a>
</div>

<!-- Mobile: Foto di atas -->
<div class="px-4 lg:hidden mb-4">
  <div class="relative w-full overflow-hidden rounded-xl bg-[#231a10] bg-cover bg-top bg-no-repeat aspect-[3/4] max-w-sm mx-auto">
    {optimizedPhotoMobile && (
      <img 
        src={optimizedPhotoMobile} 
        alt={`Foto profil ${player.full_name}, ${player.position} PERSIBO Bojonegoro, usia ${player.age} tahun dari ${player.country}`} 
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        width="400"
        height="600"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-background-dark/80 via-background-dark/20 to-transparent"></div>
  </div>
</div>

<!-- Desktop Layout: Foto Kiri + Info Kanan -->
<div class="lg:grid lg:grid-cols-[350px_1fr] lg:gap-8 lg:px-6">
  <!-- Left Column: Foto Portrait (Desktop Only) -->
  <div class="hidden lg:block lg:col-span-1">
    <div class="sticky top-24">
      <div class="relative w-full overflow-hidden rounded-xl bg-[#231a10] bg-cover bg-top bg-no-repeat aspect-[2/3]">
        {optimizedPhotoDesktop && (
          <img 
            src={optimizedPhotoDesktop} 
            alt={`Foto profil ${player.full_name}, ${player.position} PERSIBO Bojonegoro, usia ${player.age} tahun dari ${player.country}`} 
            class="absolute inset-0 w-full h-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
            width="350"
            height="525"
          />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-background-dark/80 via-background-dark/20 to-transparent"></div>
      </div>
    </div>
  </div>

  <!-- Right Column: Semua Info -->
  <div class="lg:col-span-1 space-y-6 lg:space-y-8">
    <!-- Player Header -->
    <div class="px-4 lg:px-0">
      <h1 class="text-center lg:text-left text-3xl lg:text-4xl font-bold leading-tight tracking-tight text-white">{player.full_name}</h1>
      <p class="pt-2 text-center lg:text-left text-sm lg:text-base font-normal leading-normal text-primary">{player.position} • {player.name}</p>
      
      <!-- Share Buttons -->
      <div class="mt-4 pt-4 border-t border-slate-700">
        <ShareButtons 
          title={`${player.full_name} - ${player.position} PERSIBO Bojonegoro`}
          description={`Profil lengkap ${player.full_name}, ${player.position} dari PERSIBO Bojonegoro. Usia ${player.age} tahun, ${player.country}. Statistik: ${player.statistics.appearances} main, ${player.statistics.goals} gol.`}
          type="player"
        />
      </div>
    </div>

    <!-- Stats -->
    <div class="px-4 lg:px-0">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4">
        <div class="flex flex-col gap-1 rounded-xl bg-background-dark/50 p-4 lg:p-5 text-center ring-1 ring-white/10">
          <p class="text-sm lg:text-base font-medium leading-normal text-white/70">Main</p>
          <p class="text-2xl lg:text-3xl font-bold leading-tight tracking-tight text-white">{player.statistics.appearances}</p>
          {totalCareerAppearances > player.statistics.appearances && (
            <p class="text-xs text-slate-400 mt-1">Total: {totalCareerAppearances}</p>
          )}
        </div>
        <div class="flex flex-col gap-1 rounded-xl bg-background-dark/50 p-4 lg:p-5 text-center ring-1 ring-white/10">
          <p class="text-sm lg:text-base font-medium leading-normal text-white/70">Gol</p>
          <p class="text-2xl lg:text-3xl font-bold leading-tight tracking-tight text-accent-teal">{player.statistics.goals}</p>
          {totalCareerGoals > player.statistics.goals && (
            <p class="text-xs text-slate-400 mt-1">Total: {totalCareerGoals}</p>
          )}
        </div>
        {isGoalkeeper && totalCareerSaves > 0 ? (
          <div class="flex flex-col gap-1 rounded-xl bg-background-dark/50 p-4 lg:p-5 text-center ring-1 ring-white/10">
            <p class="text-sm lg:text-base font-medium leading-normal text-white/70">Saves</p>
            <p class="text-2xl lg:text-3xl font-bold leading-tight tracking-tight text-yellow-500">{totalCareerSaves}</p>
            <p class="text-xs text-slate-400 mt-1">Avg: {avgSavesPerGame}/game</p>
          </div>
        ) : (
          <div class="flex flex-col gap-1 rounded-xl bg-background-dark/50 p-4 lg:p-5 text-center ring-1 ring-white/10">
            <p class="text-sm lg:text-base font-medium leading-normal text-white/70">Assist</p>
            <p class="text-2xl lg:text-3xl font-bold leading-tight tracking-tight text-white">0</p>
          </div>
        )}
        <div class="flex flex-col gap-1 rounded-xl bg-background-dark/50 p-4 lg:p-5 text-center ring-1 ring-white/10">
          <p class="text-sm lg:text-base font-medium leading-normal text-white/70">Kartu</p>
          <p class="text-2xl lg:text-3xl font-bold leading-tight tracking-tight text-yellow-500">{player.statistics.yellow_cards}</p>
          {(player.statistics.red_cards > 0 || totalRedCardsHistory > 0) && (
            <p class="text-xs text-red-500 mt-1">{player.statistics.red_cards || totalRedCardsHistory} Merah</p>
          )}
        </div>
      </div>
      
      {/* Additional Stats Row */}
      {totalCareerAppearances > 0 && (
        <div class="mt-3 lg:mt-4 grid grid-cols-2 lg:grid-cols-3 gap-3 lg:gap-4">
          <div class="flex flex-col gap-1 rounded-xl bg-slate-900/30 p-3 lg:p-4 text-center ring-1 ring-white/5">
            <p class="text-xs lg:text-sm font-medium leading-normal text-white/70">Gol/Main</p>
            <p class="text-lg lg:text-xl font-bold leading-tight tracking-tight text-white">{avgGoalsPerGame}</p>
          </div>
          {totalCareerAppearances > player.statistics.appearances && (
            <div class="flex flex-col gap-1 rounded-xl bg-slate-900/30 p-3 lg:p-4 text-center ring-1 ring-white/5">
              <p class="text-xs lg:text-sm font-medium leading-normal text-white/70">Total Karir</p>
              <p class="text-lg lg:text-xl font-bold leading-tight tracking-tight text-white">{totalCareerAppearances} Main</p>
            </div>
          )}
          {(totalYellowCardsHistory > player.statistics.yellow_cards || totalRedCardsHistory > (player.statistics.red_cards || 0)) && (
            <div class="flex flex-col gap-1 rounded-xl bg-slate-900/30 p-3 lg:p-4 text-center ring-1 ring-white/5">
              <p class="text-xs lg:text-sm font-medium leading-normal text-white/70">Total Kartu</p>
              <p class="text-lg lg:text-xl font-bold leading-tight tracking-tight text-white">{totalYellowCardsHistory + totalRedCardsHistory}</p>
            </div>
          )}
        </div>
      )}
    </div>
    
    <!-- Enhanced Statistics Chart -->
    {player.club_history && player.club_history.length > 0 && (
      <div class="px-4 lg:px-0">
        <PlayerStatsChart player={player} />
      </div>
    )}

    <!-- Personal Details -->
    <div class="px-4 lg:px-0">
      <h3 class="mb-4 text-xl lg:text-2xl font-bold text-white">Detail Pribadi</h3>
      <div class="space-y-4 rounded-xl bg-background-dark/50 p-4 lg:p-6 ring-1 ring-white/10">
        <div class="flex items-center justify-between">
          <p class="text-base lg:text-lg text-white/70">Usia</p>
          <p class="text-base lg:text-lg font-medium text-white">{player.age} tahun</p>
        </div>
        <div class="flex items-center justify-between">
          <p class="text-base lg:text-lg text-white/70">Kebangsaan</p>
          <p class="text-base lg:text-lg font-medium text-white">{player.country}</p>
        </div>
        <div class="flex items-center justify-between">
          <p class="text-base lg:text-lg text-white/70">Posisi</p>
          <p class="text-base lg:text-lg font-medium text-white">{player.position}</p>
        </div>
        <div class="flex items-center justify-between">
          <p class="text-base lg:text-lg text-white/70">Klub</p>
          <p class="text-base lg:text-lg font-medium text-white">{player.club}</p>
        </div>
      </div>
    </div>

    <!-- Club History -->
    {player.club_history && player.club_history.length > 0 && (
      <div class="px-4 lg:px-0">
        <h3 class="mb-4 text-xl lg:text-2xl font-bold text-white">Riwayat Klub</h3>
        <div class="space-y-4 rounded-xl bg-background-dark/50 p-4 lg:p-6 ring-1 ring-white/10">
          {player.club_history.map((history) => (
            <div class="flex items-center justify-between border-b border-white/10 pb-3 last:border-0 last:pb-0">
              <div>
                <p class="text-base lg:text-lg font-medium text-white">{history.club}</p>
                <p class="text-sm lg:text-base text-white/70">{history.competition} • {history.year}</p>
              </div>
              <div class="text-right">
                <p class="text-base lg:text-lg font-medium text-white">{history.appearances} Main</p>
                <p class="text-sm lg:text-base text-white/70">
                  {parseInt(history.goals) > 0 && `${history.goals} Gol`}
                  {isGoalkeeper && parseInt(history.saves) > 0 && ` • ${history.saves} Saves`}
                  {parseInt(history.goals) === 0 && !(isGoalkeeper && parseInt(history.saves) > 0) && '0 Gol'}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
    
    <!-- Top Performers Comparison -->
    {player.club === 'PERSIBO Bojonegoro' && (
      <div class="px-4 lg:px-0 pb-8 lg:pb-0 space-y-6">
        <h3 class="text-xl lg:text-2xl font-bold text-white">Perbandingan dengan Pemain Lain</h3>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6">
          {!isGoalkeeper && (
            <>
              <TopPerformers currentPlayer={player} statType="goals" limit={5} />
              <TopPerformers currentPlayer={player} statType="appearances" limit={5} />
            </>
          )}
          {isGoalkeeper && (
            <TopPerformers currentPlayer={player} statType="saves" limit={5} />
          )}
        </div>
      </div>
    )}
  </div>
</div>
