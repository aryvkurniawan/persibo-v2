---
import type { PlayerDetail } from '../types';

interface Props {
  player: PlayerDetail;
}

const { player } = Astro.props;
---

<!-- Header Image -->
<div class="@container px-4">
  <div class="relative w-full overflow-hidden rounded-xl bg-[#231a10] bg-cover bg-top bg-no-repeat min-h-[400px] md:min-h-[600px]" style={player.photo_url ? `background-image: url("${player.photo_url}"); background-position: center top;` : ''}>
    <div class="absolute inset-0 bg-gradient-to-t from-background-dark/80 via-background-dark/20 to-transparent"></div>
    {player.photo_url && (
      <img src={player.photo_url} alt={`Foto profil ${player.full_name}, ${player.position} PERSIBO Bojonegoro, usia ${player.age} tahun dari ${player.country}`} class="sr-only" />
    )}
  </div>
</div>

<!-- Back Button -->
<div class="px-4 pt-4 pb-2">
  <a href="/pemain" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors py-2 px-3 rounded-lg hover:bg-slate-800/50">
    <span class="material-symbols-outlined text-xl">arrow_back</span>
    <span class="text-sm font-medium">Kembali ke Daftar Pemain</span>
  </a>
</div>

<!-- Player Info Section -->
<div class="relative z-10 -mt-2">
  <div class="px-4">
    <!-- Headline Text -->
    <h1 class="text-center text-3xl font-bold leading-tight tracking-tight text-white">{player.full_name}</h1>
    <!-- Meta Text -->
    <p class="pt-1 text-center text-sm font-normal leading-normal text-primary">{player.position} • {player.name}</p>
  </div>
  <!-- Stats -->
  <div class="flex flex-wrap gap-3 p-4">
    <div class="flex flex-1 flex-col gap-1 rounded-xl bg-background-dark/50 p-4 text-center ring-1 ring-white/10">
      <p class="text-sm font-medium leading-normal text-white/70">Main</p>
      <p class="text-2xl font-bold leading-tight tracking-tight text-white">{player.statistics.appearances}</p>
    </div>
    <div class="flex flex-1 flex-col gap-1 rounded-xl bg-background-dark/50 p-4 text-center ring-1 ring-white/10">
      <p class="text-sm font-medium leading-normal text-white/70">Gol</p>
      <p class="text-2xl font-bold leading-tight tracking-tight text-white">{player.statistics.goals}</p>
    </div>
    <div class="flex flex-1 flex-col gap-1 rounded-xl bg-background-dark/50 p-4 text-center ring-1 ring-white/10">
      <p class="text-sm font-medium leading-normal text-white/70">Assist</p>
      <p class="text-2xl font-bold leading-tight tracking-tight text-white">0</p>
    </div>
    <div class="flex flex-1 flex-col gap-1 rounded-xl bg-background-dark/50 p-4 text-center ring-1 ring-white/10">
      <p class="text-sm font-medium leading-normal text-white/70">Kuning</p>
      <p class="text-2xl font-bold leading-tight tracking-tight text-white">{player.statistics.yellow_cards}</p>
    </div>
  </div>
</div>

<!-- Personal Details -->
<div class="px-4 pt-4 pb-6">
  <h3 class="mb-4 text-xl font-bold text-white">Detail Pribadi</h3>
  <div class="space-y-4 rounded-xl bg-background-dark/50 p-4 ring-1 ring-white/10">
    <div class="flex items-center justify-between">
      <p class="text-base text-white/70">Usia</p>
      <p class="text-base font-medium text-white">{player.age} tahun</p>
    </div>
    <div class="flex items-center justify-between">
      <p class="text-base text-white/70">Kebangsaan</p>
      <p class="text-base font-medium text-white">{player.country}</p>
    </div>
    <div class="flex items-center justify-between">
      <p class="text-base text-white/70">Posisi</p>
      <p class="text-base font-medium text-white">{player.position}</p>
    </div>
    <div class="flex items-center justify-between">
      <p class="text-base text-white/70">Klub</p>
      <p class="text-base font-medium text-white">{player.club}</p>
    </div>
  </div>
</div>

{player.club_history && player.club_history.length > 0 && (
  <div class="px-4 pb-8">
    <h3 class="mb-4 text-xl font-bold text-white">Riwayat Klub</h3>
    <div class="space-y-4 rounded-xl bg-background-dark/50 p-4 ring-1 ring-white/10">
      {player.club_history.map((history) => (
        <div class="flex items-center justify-between border-b border-white/10 pb-3 last:border-0 last:pb-0">
          <div>
            <p class="text-base font-medium text-white">{history.club}</p>
            <p class="text-sm text-white/70">{history.competition} • {history.year}</p>
          </div>
          <div class="text-right">
            <p class="text-base font-medium text-white">{history.appearances} Main</p>
            <p class="text-sm text-white/70">{history.goals} Gol</p>
          </div>
        </div>
      ))}
    </div>
  </div>
)}
