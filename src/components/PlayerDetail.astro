---
import type { PlayerDetail } from '../types';
import PlayerStatsChart from './PlayerStatsChart.astro';
import TopPerformers from './TopPerformers.astro';
import ShareButtons from './ShareButtons.astro';

interface Props {
  player: PlayerDetail;
}

const { player } = Astro.props;

// Archive-only players stopped appearing after 2024-25, so a fixed "Skuad 2025-26"
// header lied about them. Label the page with the newest season they actually played.
const lastSeason = (player.club_history || [])
  .filter((h) => /PERSIBO/i.test(h.club ?? ''))
  .map((h) => String(h.year))
  .filter((y) => /^\d{4}$/.test(y))
  .map(Number)
  .sort((a, b) => b - a)[0];
const seasonLabel = lastSeason ? `Skuad ${lastSeason}-${String((lastSeason + 1) % 100).padStart(2, '0')}` : '';

// Only rows recomputed from our own match details are summed. iLeague's scraped
// "Penampilan" counts squad listings (it totals 21 a match), so adding its history
// inflates everybody: SAMSUL read "Karir: 79" across 12 real appearances.
const trustedHistory = (player.club_history || []).filter((h) => h.source === 'derived:matchDetails');

const totalCareerAppearances = trustedHistory.reduce((sum, h) => sum + (parseInt(h.appearances) || 0), 0);
const totalCareerGoals = trustedHistory.reduce((sum, h) => sum + (parseInt(h.goals) || 0), 0);
const savesRows = (player.club_history || []).filter((h) => (parseInt(h.saves) || 0) > 0);
const totalCareerSaves = savesRows.reduce((sum, h) => sum + (parseInt(h.saves) || 0), 0);
const isGoalkeeper = player.position?.toUpperCase().includes('GAWANG');

const totalYellowCardsHistory = trustedHistory.reduce((sum, h) => {
  const cards = h.cards?.split('/') || [];
  return sum + (parseInt(cards[0]?.trim()) || 0);
}, 0);
const totalRedCardsHistory = trustedHistory.reduce((sum, h) => {
  const cards = h.cards?.split('/') || [];
  return sum + (parseInt(cards[1]?.trim()) || 0);
}, 0);

const avgGoalsPerGame = totalCareerAppearances > 0 ? (totalCareerGoals / totalCareerAppearances).toFixed(2) : '0.00';
const savesAppearances = savesRows.reduce((sum, h) => sum + (parseInt(h.appearances) || 0), 0);
const avgSavesPerGame = savesAppearances > 0 && isGoalkeeper ? (totalCareerSaves / savesAppearances).toFixed(2) : '0.00';
// Career totals only mean something when the rows behind them are trustworthy.
// iLeague's "Penampilan" counts squad listings, so summing its history inflates
// every player; the matches we derive from are the only ones we can vouch for.
const hasCareer = totalCareerAppearances > player.statistics.appearances;

// Showing 0 would claim the keeper never made a save, so when nothing is recorded
// the card reads blank and says so instead.
const savesTracked = totalCareerSaves > 0;

// iLeague publishes no assists, so there is no column for them: a hardcoded 0
// reads as "this player never assisted" rather than "this is not tracked".
const totalCards = totalYellowCardsHistory + totalRedCardsHistory;
const stats = [
  { label: 'Main', value: player.statistics.appearances, total: hasCareer ? totalCareerAppearances : null, accent: false },
  { label: 'Gol', value: player.statistics.goals, total: totalCareerGoals > player.statistics.goals ? totalCareerGoals : null, accent: true },
  ...(isGoalkeeper
    ? [{
        label: 'Saves',
        value: savesTracked ? totalCareerSaves : '—',
        total: null,
        accent: false,
        note: savesTracked ? `${avgSavesPerGame}/laga` : 'tidak dilacak',
      }]
    : []),
  {
    label: 'Kartu',
    value: totalCards,
    total: null,
    accent: false,
    note: totalRedCardsHistory > 0 ? `${totalYellowCardsHistory} kuning · ${totalRedCardsHistory} merah` : `${totalYellowCardsHistory} kuning`,
  },
];
---

<!-- Mobile: Foto di atas -->
<div class="px-4 lg:hidden">
  <div class="relative aspect-[3/4] w-full max-w-sm mx-auto overflow-hidden border border-white/12 bg-[#161318]">
    {player.photo_url && (
      <img
        src={player.photo_url}
        alt={`Foto ${player.full_name}, ${player.position} PERSIBO Bojonegoro`}
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        width="400"
        height="600"
      />
    )}
    <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-[#0c0b0f] to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 p-4">
      <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{player.position || 'Pemain'}</p>
      <h1 class="mt-1 font-cond text-4xl font-bold uppercase leading-none text-white">{player.full_name}</h1>
    </div>
  </div>
</div>

<!-- Desktop Layout -->
<div class="lg:grid lg:grid-cols-[320px_1fr] lg:gap-8 lg:px-6 lg:pt-2">
  <div class="hidden lg:block">
    <div class="sticky top-24">
      <div class="relative aspect-[2/3] w-full overflow-hidden border border-white/12 bg-[#161318]">
        {player.photo_url && (
          <img
            src={player.photo_url}
            alt={`Foto ${player.full_name}, ${player.position} PERSIBO Bojonegoro`}
            class="absolute inset-0 h-full w-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
            width="350"
            height="525"
          />
        )}
        <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-[#0c0b0f] to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 p-4">
          <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{player.position || 'Pemain'}</p>
          <p class="mt-1 font-cond text-3xl font-bold uppercase leading-none text-white">{player.full_name}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 space-y-8 lg:mt-0">
    <!-- Header (desktop; mobile name sits on the photo) -->
    <div class="hidden px-4 lg:block lg:px-0">
      <p class="text-[11px] font-bold uppercase tracking-[0.24em] text-primary">Profil pemain{seasonLabel && ` · ${seasonLabel}`}</p>
      <h1 class="mt-1 font-cond text-5xl font-bold uppercase leading-none text-white lg:text-6xl">{player.full_name}</h1>
      <p class="mt-2 text-sm text-white/50">{player.position} · {player.club}</p>
    </div>

    <!-- Stats -->
    <div class="px-4 lg:px-0">
      <div class={`grid grid-cols-2 gap-2 ${stats.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3'}`}>
        {stats.map((stat) => (
          <div class="border border-white/12 bg-[#0c0b0f] px-4 py-4">
            <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/35">{stat.label}</p>
            <p class={`mt-2 font-cond text-4xl font-bold leading-none tnum ${stat.accent ? 'text-primary' : 'text-white'}`}>{stat.value}</p>
            {stat.total && <p class="mt-1 text-[11px] uppercase tracking-[0.14em] text-white/30">Karir: {stat.total}</p>}
            {stat.note && <p class="mt-1 text-[11px] uppercase tracking-[0.14em] text-white/30">{stat.note}</p>}
          </div>
        ))}
      </div>
    </div>

    <!-- Share -->
    <div class="border-y border-white/10 px-4 py-4 lg:px-0">
      <ShareButtons title={player.full_name} description={`Profil ${player.full_name}, ${player.position} PERSIBO Bojonegoro`} type="player" />
    </div>

    {player.club_history && player.club_history.length > 0 && (
      <div class="px-4 lg:px-0">
        <PlayerStatsChart player={player} />
      </div>
    )}

    <!-- Personal Details -->
    <div class="px-4 lg:px-0">
      <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
        <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Detail Pribadi</h2>
      </div>
      <div class="divide-y divide-white/5 border border-white/12 bg-[#0c0b0f]">
        {[
          { label: 'Usia', value: `${player.age} tahun` },
          { label: 'Kebangsaan', value: player.country },
          { label: 'Posisi', value: player.position },
          { label: 'Klub', value: player.club },
          { label: 'Gol/Main', value: avgGoalsPerGame },
        ].map((row) => (
          <div class="flex items-center justify-between px-4 py-3">
            <span class="text-[10px] uppercase tracking-[0.14em] text-white/35">{row.label}</span>
            <span class="text-sm font-medium text-white">{row.value}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Club History -->
    {player.club_history && player.club_history.length > 0 && (
      <div class="px-4 lg:px-0">
        <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Riwayat Klub</h2>
          <span class="text-[11px] uppercase tracking-[0.18em] text-white/30">{player.club_history.length} musim</span>
        </div>
        <div class="divide-y divide-white/5 border border-white/12 bg-[#0c0b0f]">
          {player.club_history.map((history) => (
            <div class="flex items-center justify-between gap-3 px-4 py-3">
              <div class="min-w-0">
                <p class="truncate text-sm font-medium text-white">{history.club}</p>
                <p class="mt-0.5 text-[11px] uppercase tracking-[0.14em] text-white/30">{history.competition} · {history.year}</p>
              </div>
              <div class="shrink-0 text-right">
                <p class="font-cond text-lg font-semibold leading-none text-white tnum">{history.appearances} <span class="text-[11px] uppercase tracking-[0.14em] text-white/30">main</span></p>
                <p class="mt-1 text-[11px] uppercase tracking-[0.14em] text-white/40">
                  {parseInt(history.goals) > 0 ? `${history.goals} gol` : '0 gol'}
                  {isGoalkeeper && parseInt(history.saves) > 0 && ` · ${history.saves} saves`}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Top Performers -->
    {player.club === 'PERSIBO Bojonegoro' && (
      <div class="space-y-6 px-4 pb-8 lg:px-0 lg:pb-0">
        <div class="flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Perbandingan Skuad</h2>
        </div>
        <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
          {!isGoalkeeper && (
            <>
              <TopPerformers currentPlayer={player} statType="goals" limit={5} />
              <TopPerformers currentPlayer={player} statType="appearances" limit={5} />
            </>
          )}
          {isGoalkeeper && <TopPerformers currentPlayer={player} statType="saves" limit={5} />}
        </div>
      </div>
    )}
  </div>
</div>
