---
import type { Fixture } from '../types';
import { loadTeams, getTeamLogo } from '../utils/dataLoader';
import { optimizeTeamLogo } from '../utils/imageOptimizer';

interface Props {
  match: Fixture;
  isNextMatch?: boolean;
}

const { match, isNextMatch = false } = Astro.props;
const teams = await loadTeams();

const isPersiboHome = match.home_team.toUpperCase().includes('PERSIBO');
const isPersiboAway = match.away_team.toUpperCase().includes('PERSIBO');
const isCompleted = match.status === 'COMPLETED';

// Parse score
const [homeScore, awayScore] = match.score ? match.score.split(':') : ['', ''];
const persiboWon = isCompleted && ((isPersiboHome && parseInt(homeScore) > parseInt(awayScore)) || (isPersiboAway && parseInt(awayScore) > parseInt(homeScore)));
const persiboLost = isCompleted && ((isPersiboHome && parseInt(homeScore) < parseInt(awayScore)) || (isPersiboAway && parseInt(awayScore) < parseInt(homeScore)));
const isDraw = isCompleted && homeScore === awayScore;

// Get team logos
const homeTeamLogoRaw = isPersiboHome ? '/logo-32.png' : (getTeamLogo(teams, match.home_team) || null);
const awayTeamLogoRaw = isPersiboAway ? '/logo-32.png' : (getTeamLogo(teams, match.away_team) || null);
const homeTeamLogo = optimizeTeamLogo(homeTeamLogoRaw, 32);
const awayTeamLogo = optimizeTeamLogo(awayTeamLogoRaw, 32);

// Get opponent name
const opponentName = isPersiboHome ? match.away_team : match.home_team;
const opponentLogo = isPersiboHome ? awayTeamLogo : homeTeamLogo;
---

<div class={`min-w-[200px] flex-shrink-0 rounded-lg p-3 border ${
  isNextMatch 
    ? 'bg-gradient-to-br from-primary/20 to-accent-purple/20 border-primary/30' 
    : isCompleted
      ? persiboWon 
        ? 'bg-green-500/10 border-green-500/30' 
        : persiboLost 
          ? 'bg-red-500/10 border-red-500/30'
          : 'bg-yellow-500/10 border-yellow-500/30'
      : 'bg-slate-800/50 border-slate-700'
}`}>
  {isNextMatch && (
    <div class="flex items-center gap-2 mb-2">
      <span class="material-symbols-outlined text-primary text-sm">schedule</span>
      <span class="text-xs font-bold text-primary">Pertandingan Berikutnya</span>
    </div>
  )}
  
  <div class="text-xs text-slate-400 mb-3 text-center">{match.date}</div>
  
  <div class="flex flex-col gap-3 mb-2">
    <!-- Persibo -->
    <div class="flex items-center justify-center gap-2">
      <img src="/logo-32.png" alt={`Logo PERSIBO Bojonegoro - ${isNextMatch ? 'Jadwal' : 'Hasil'} pertandingan vs ${opponentName}`} class="h-8 w-8 object-contain flex-shrink-0" width="32" height="32" loading="lazy" />
      <span class="text-sm font-bold text-white">PERSIBO</span>
    </div>
    
    <!-- Score or VS -->
    <div class="flex justify-center">
      {isCompleted ? (
        <div class={`text-xl font-bold ${
          persiboWon ? 'text-green-400' : 
          persiboLost ? 'text-red-400' : 
          'text-yellow-400'
        }`}>
          {isPersiboHome ? `${homeScore}:${awayScore}` : `${awayScore}:${homeScore}`}
        </div>
      ) : (
        <span class="text-sm text-slate-500 font-medium">VS</span>
      )}
    </div>
    
    <!-- Opponent -->
    <div class="flex items-center justify-center gap-2">
      {opponentLogo && (
        <img src={opponentLogo} alt={`Logo ${opponentName} - ${isNextMatch ? 'Jadwal' : 'Hasil'} pertandingan vs PERSIBO Bojonegoro`} class="h-8 w-8 object-contain flex-shrink-0" width="32" height="32" loading="lazy" />
      )}
      <span class="text-sm font-bold text-slate-300">{opponentName}</span>
    </div>
  </div>
  
  
  {isNextMatch && (
    <div class="text-xs text-slate-400 text-center mt-2">
      <span class="material-symbols-outlined text-xs align-middle">location_on</span>
      {match.venue}
    </div>
  )}
</div>
