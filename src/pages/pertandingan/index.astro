---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import MatchCard from '../../components/MatchCard.astro';
import { loadFixtures, getCompletedFixtures, getScheduledFixtures } from '../../utils/dataLoader';

const allFixtures = await loadFixtures();
const completedFixtures = getCompletedFixtures(allFixtures);
const scheduledFixtures = getScheduledFixtures(allFixtures);
---

<Layout
  title="Jadwal & Hasil Pertandingan PERSIBO Bojonegoro 2026-27 (Unofficial)"
  description="Jadwal pertandingan dan hasil pertandingan PERSIBO Bojonegoro di Liga Nusantara 2026-27. Informasi lengkap tentang fixture dan hasil match."
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <PageHeader
      label="Liga Nusantara 2026-27"
      title="Jadwal & Hasil"
      meta={`${allFixtures.length} laga`}
      description={
        completedFixtures.length === 0
          ? `${scheduledFixtures.length} laga terjadwal, belum ada yang dimainkan.`
          : `${scheduledFixtures.length} laga terjadwal dan ${completedFixtures.length} laga selesai.`
      }
    />

    {scheduledFixtures.length > 0 && (
      <section class="mt-8">
        <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Jadwal</h2>
          <span class="text-[11px] uppercase tracking-[0.18em] text-white/30">{scheduledFixtures.length} laga</span>
        </div>
        <div class="grid gap-3 lg:grid-cols-2">
          {scheduledFixtures.map((match) => <MatchCard match={match} />)}
        </div>
      </section>
    )}

    {completedFixtures.length > 0 && (
      <section class="mt-10">
        <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Hasil</h2>
          <span class="text-[11px] uppercase tracking-[0.18em] text-white/30">{completedFixtures.length} laga</span>
        </div>
        <div class="grid gap-3 lg:grid-cols-2">
          {completedFixtures.map((match) => <MatchCard match={match} />)}
        </div>
      </section>
    )}

    {allFixtures.length === 0 && (
      <div class="mt-8 border border-white/12 bg-[#0c0b0f] px-6 py-16 text-center">
        <p class="font-cond text-4xl font-bold uppercase leading-none text-white/70">Belum ada data pertandingan</p>
        <p class="mt-3 text-sm text-white/40">Jadwal Liga Nusantara 2026-27 akan tersedia setelah dirilis.</p>
      </div>
    )}
  </div>
</Layout>
