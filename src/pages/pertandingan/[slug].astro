---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LineupPitch from '../../components/LineupPitch.astro';
import MatchTimeline from '../../components/MatchTimeline.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { loadFixtures, getMatchDetailSlug, loadMatchDetails, getMatchDetailByUrl, loadTeams, getTeamLogo, CURRENT_SEASON, ARCHIVE_SEASON, type Season } from '../../utils/dataLoader';
import { formatDateLong } from '../../utils/dates';
import { buildTimeline } from '../../utils/matchTimeline';

export async function getStaticPaths() {
  const paths = [];
  const seasons: Season[] = [CURRENT_SEASON, ARCHIVE_SEASON, '2024-25'];

  for (const season of seasons) {
    const fixtures = await loadFixtures(season);
    const matchDetails = await loadMatchDetails(season);

    for (const fixture of fixtures) {
      const matchDetail = fixture.match_url ? getMatchDetailByUrl(matchDetails, fixture.match_url) : null;
      paths.push({
        params: { slug: getMatchDetailSlug(fixture) },
        props: { fixture, matchDetail: matchDetail || null, season },
      });
    }
  }

  return paths;
}

const { fixture, matchDetail, season } = Astro.props;
const teams = await loadTeams(season);
const seasonLabel = season;
// Liga 2 ran until 2024-25; the competition was renamed Liga Nusantara after that.
const competitionName = season === '2024-25' ? 'Liga 2' : 'Liga Nusantara';

const isCompleted = fixture.status === 'COMPLETED';
const isPersiboHome = fixture.home_team.toUpperCase().includes('PERSIBO');
const isPersiboAway = fixture.away_team.toUpperCase().includes('PERSIBO');
const [homeScore, awayScore] = fixture.score ? fixture.score.split(':') : ['', ''];
const matchState = isCompleted ? `Skor ${fixture.score}` : `Jadwal ${fixture.time}`;
const persiboWon = isCompleted && (parseInt(homeScore) > parseInt(awayScore) ? isPersiboHome : (parseInt(awayScore) > parseInt(homeScore) ? isPersiboAway : false));
const persiboLost = isCompleted && (parseInt(homeScore) < parseInt(awayScore) ? isPersiboHome : (parseInt(awayScore) < parseInt(homeScore) ? isPersiboAway : false));
const isDraw = isCompleted && homeScore === awayScore;

const homeTeamLogo = isPersiboHome ? '/logo-64.png' : (getTeamLogo(teams, fixture.home_team) || null);
const awayTeamLogo = isPersiboAway ? '/logo-64.png' : (getTeamLogo(teams, fixture.away_team) || null);

const hasPlayers = (lineup?: { starting_xi: unknown[]; substitutes: unknown[] }) =>
  Boolean(lineup && (lineup.starting_xi.length > 0 || lineup.substitutes.length > 0));
const homeLineup = hasPlayers(matchDetail?.lineups?.home_team) ? matchDetail!.lineups.home_team : null;
const awayLineup = hasPlayers(matchDetail?.lineups?.away_team) ? matchDetail!.lineups.away_team : null;

// Scraped keys are English snake_case; the page speaks Indonesian.
const STAT_LABELS: Record<string, string> = {
  possession: 'Penguasaan bola',
  shots: 'Total tembakan',
  shots_on_target: 'Tembakan ke gawang',
  shot_accuracy: 'Akurasi tembakan',
  passes_completed: 'Umpan sukses',
  passes_failed: 'Umpan gagal',
  corners: 'Tendangan sudut',
  tackles_won: 'Tekel sukses',
  offsides: 'Offside',
  fouls: 'Pelanggaran',
  yellow_cards: 'Kartu kuning',
  red_cards: 'Kartu merah',
};
const STAT_ORDER = Object.keys(STAT_LABELS);
const statRows = matchDetail?.statistics
  ? Object.entries(matchDetail.statistics)
      .filter(([, value]) => value !== null && typeof value === 'object')
      .sort(([a], [b]) => {
        const ai = STAT_ORDER.indexOf(a);
        const bi = STAT_ORDER.indexOf(b);
        return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
      })
      .map(([key, value]) => {
        const pair = value as { home: number | null; away: number | null };
        const home = pair.home ?? 0;
        const away = pair.away ?? 0;
        const total = home + away;
        return {
          key,
          label: STAT_LABELS[key] ?? key.replace(/_/g, ' '),
          home: pair.home,
          away: pair.away,
          homePct: total > 0 ? (home / total) * 100 : 50,
          awayPct: total > 0 ? (away / total) * 100 : 50,
        };
      })
  : [];

const timeline = matchDetail?.events?.length
  ? buildTimeline(matchDetail.events, fixture.home_team, fixture.away_team, matchDetail.lineups, {
      home: Number(homeScore) || 0,
      away: Number(awayScore) || 0,
    })
  : [];

// Goals only, in order, for the scoreline strip under the hero.
const goals = timeline.filter((event) => event.type === 'goal');

// iLeague sometimes lists more goals than the result implies, or none at all for
// the losing side. Flag it so the strip never quietly contradicts the score.
const goalsUnreconciled =
  isCompleted &&
  (goals.filter((g) => g.side === 'home').length !== Number(homeScore) ||
    goals.filter((g) => g.side === 'away').length !== Number(awayScore));

// Officials are patchy: only the referee is always present, so show what exists.
const officialLabels: Array<[string, string]> = [
  ['referee', 'Wasit'],
  ['assistant_referee_1', 'Asisten 1'],
  ['assistant_referee_2', 'Asisten 2'],
  ['fourth_official', 'Wasit keempat'],
  ['match_commissioner', 'Komisaris laga'],
];
const officials = officialLabels
  .map(([key, label]) => ({ label, name: (matchDetail?.officials as Record<string, string> | undefined)?.[key] ?? '' }))
  .filter((row) => row.name.trim().length > 0);

const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Pertandingan', href: '/pertandingan' },
  { label: 'Detail Pertandingan', href: `/pertandingan/${getMatchDetailSlug(fixture)}` }
];
---

<Layout
  title={`${fixture.home_team} vs ${fixture.away_team} - ${isCompleted ? 'Hasil' : 'Jadwal'} Pertandingan (Unofficial)`}
  description={`${isCompleted ? 'Hasil' : 'Jadwal'} pertandingan ${fixture.home_team} vs ${fixture.away_team} di ${competitionName} ${seasonLabel}. ${matchState}, tanggal ${fixture.date}, venue ${fixture.venue}.`}
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="sr-only">{fixture.home_team} vs {fixture.away_team} - {fixture.date}</h1>

    <!-- Match Header -->
    <div class="border border-white/12 bg-[#0c0b0f]">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 px-4 py-3">
        <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">{competitionName} {seasonLabel}</span>
        <div class="flex flex-col items-end gap-0.5 text-right">
          <span class="text-[11px] uppercase tracking-[0.16em] text-white/40">
            {formatDateLong(fixture.date)}{fixture.time ? ` · ${fixture.time} WIB` : ''}
          </span>
          <span class="text-[11px] uppercase tracking-[0.16em] text-white/25">{fixture.venue}</span>
        </div>
      </div>

      <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 px-4 py-8 lg:gap-8 lg:px-10 lg:py-12">
        <div class="flex flex-col items-center gap-2 text-center">
          {homeTeamLogo && (
            <img src={homeTeamLogo} alt={`Logo ${fixture.home_team}`} class="h-14 w-14 object-contain lg:h-20 lg:w-20" width="80" height="80" loading="lazy" />
          )}
          <h2 class={`font-cond text-xl font-semibold uppercase leading-none lg:text-3xl ${isPersiboHome ? 'text-white' : 'text-white/60'}`}>
            {fixture.home_team}
          </h2>
          <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/30">Kandang</span>
        </div>

        <div class="flex flex-col items-center gap-2">
          {isCompleted ? (
            <>
              <span class={`font-cond text-5xl font-bold leading-none tnum lg:text-7xl ${
                persiboWon ? 'text-green-400' : persiboLost ? 'text-red-400' : 'text-yellow-400'
              }`}>
                {homeScore}<span class="px-1 text-white/20">:</span>{awayScore}
              </span>
              <span class={`border px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.16em] ${
                persiboWon ? 'border-green-500/40 text-green-400' : persiboLost ? 'border-red-500/40 text-red-400' : 'border-yellow-500/40 text-yellow-400'
              }`}>
                {persiboWon ? 'Menang' : persiboLost ? 'Kalah' : 'Seri'}
              </span>
            </>
          ) : (
            <>
              <span class="font-cond text-5xl font-bold leading-none text-white tnum lg:text-7xl">{fixture.time || '—'}</span>
              <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/30">{fixture.time ? 'WIB · Jadwal' : 'Jadwal'}</span>
            </>
          )}
        </div>

        <div class="flex flex-col items-center gap-2 text-center">
          {awayTeamLogo && (
            <img src={awayTeamLogo} alt={`Logo ${fixture.away_team}`} class="h-14 w-14 object-contain lg:h-20 lg:w-20" width="80" height="80" loading="lazy" />
          )}
          <h2 class={`font-cond text-xl font-semibold uppercase leading-none lg:text-3xl ${isPersiboAway ? 'text-white' : 'text-white/60'}`}>
            {fixture.away_team}
          </h2>
          <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/30">Tandang</span>
        </div>
      </div>

      <div class="flex items-center justify-between gap-3 border-t border-white/10 px-4 py-3">
        <ShareButtons
          title={`${fixture.home_team} vs ${fixture.away_team} - ${isCompleted ? fixture.score : fixture.date}`}
          description={`${isCompleted ? 'Hasil' : 'Jadwal'} pertandingan ${fixture.home_team} vs ${fixture.away_team} di ${competitionName} ${seasonLabel}. ${matchState}, tanggal ${fixture.date}.`}
          type="match"
        />
        {fixture.match_url && (
          <a href={fixture.match_url} target="_blank" rel="noopener noreferrer" class="text-[11px] font-bold uppercase tracking-[0.18em] text-white/40 hover:text-primary">
            iLeague ↗
          </a>
        )}
      </div>
    </div>

    <!-- Goals, grouped by side. A flat list reads as "all of these are ours",
         which is exactly wrong when the source only records one team's goals. -->
    {goals.length > 0 && (
      <div class="mt-3 border border-white/12 bg-[#0c0b0f]">
        <div class="grid grid-cols-2 divide-x divide-white/10">
          {(['home', 'away'] as const).map((sideKey) => {
            const sideGoals = goals.filter((goal) => goal.side === sideKey);
            const teamName = sideKey === 'home' ? fixture.home_team : fixture.away_team;
            const teamLogo = sideKey === 'home' ? homeTeamLogo : awayTeamLogo;
            const score = sideKey === 'home' ? homeScore : awayScore;
            return (
              <div class="min-w-0 px-3 py-2.5">
                <div class={`mb-2 flex items-center gap-2 ${sideKey === 'away' ? 'flex-row-reverse text-right' : ''}`}>
                  {teamLogo && <img src={teamLogo} alt="" class="h-4 w-4 shrink-0 object-contain" loading="lazy" width="16" height="16" />}
                  <span class="min-w-0 flex-1 truncate text-[11px] font-bold uppercase tracking-[0.14em] text-white/40">
                    {teamName}
                  </span>
                  {!goalsUnreconciled && (
                    <span class="shrink-0 font-cond text-sm font-bold leading-none text-white tnum">{score}</span>
                  )}
                </div>
                {sideGoals.length > 0 ? (
                  <ul class={`space-y-1 ${sideKey === 'away' ? 'text-right' : ''}`}>
                    {sideGoals.map((goal) => (
                      <li class={`flex items-baseline gap-1.5 text-[11px] leading-tight text-white/80 ${sideKey === 'away' ? 'flex-row-reverse' : ''}`}>
                        <span class="shrink-0 font-cond text-[10px] font-bold text-primary tnum">{goal.label}</span>
                        <span class="min-w-0 break-words text-left">{goal.player}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-[10px] uppercase tracking-[0.12em] text-white/20">Tidak tercatat</p>
                )}
              </div>
            );
          })}
        </div>

        <!-- When the goal list does not add up to the scoreline, say so instead of
             letting readers assume the missing goals never happened. -->
        {goalsUnreconciled && (
          <p class="border-t border-white/10 px-3 py-2 text-[11px] uppercase leading-relaxed tracking-[0.1em] text-white/30">
            Pencetak gol di sumber tidak cocok dengan skor akhir, jadi daftar ini belum lengkap.
          </p>
        )}
      </div>
    )}

    <!-- Lineups: two halves of one pitch, rows by position. -->
    {(homeLineup || awayLineup) && (
      <section class="mt-8">
        <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Lineup</h2>
          <span class="text-[11px] uppercase tracking-[0.18em] text-white/30">Starting XI</span>
        </div>
        <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
          {homeLineup && <LineupPitch lineup={homeLineup} teamName={fixture.home_team} side="home" />}
          {awayLineup && <LineupPitch lineup={awayLineup} teamName={fixture.away_team} side="away" />}
        </div>
        {!awayLineup && (
          <p class="mt-2 text-[10px] uppercase tracking-[0.14em] text-white/25">
            Lineup lawan belum tersedia di sumber.
          </p>
        )}
      </section>
    )}

    <!-- Timeline: chronological, one column per side, running score on goals. -->
    {timeline.length > 0 && (
      <section class="mt-8">
        <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Jalannya laga</h2>
          <span class="text-[11px] uppercase tracking-[0.18em] text-white/30">{timeline.length} kejadian</span>
        </div>
        <MatchTimeline events={timeline} homeTeam={fixture.home_team} awayTeam={fixture.away_team} />
      </section>
    )}

    <!-- Statistics -->
    {statRows.length > 0 && (
      <section class="mt-8">
        <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Statistik</h2>
          <span class="text-[11px] uppercase tracking-[0.18em] text-white/30">
            {isPersiboHome ? 'kiri PERSIBO' : 'kanan PERSIBO'}
          </span>
        </div>
        <div class="border border-white/12 bg-[#0c0b0f]">
          <div class="divide-y divide-white/5">
            {statRows.map((row) => (
              <div class="px-4 py-3">
                <div class="flex items-baseline justify-between gap-3">
                  <span class={`font-cond text-lg font-semibold leading-none tnum ${isPersiboHome ? 'text-primary' : 'text-white'}`}>
                    {row.home ?? '–'}
                  </span>
                  <span class="text-center text-[10px] uppercase tracking-[0.14em] text-white/40">{row.label}</span>
                  <span class={`font-cond text-lg font-semibold leading-none tnum ${isPersiboHome ? 'text-white' : 'text-primary'}`}>
                    {row.away ?? '–'}
                  </span>
                </div>
                <div class="mt-1.5 flex h-0.5 gap-0.5 overflow-hidden">
                  <span class={`h-full ${isPersiboHome ? 'bg-primary/70' : 'bg-white/20'}`} style={`width: ${row.homePct}%`}></span>
                  <span class={`h-full ${isPersiboHome ? 'bg-white/20' : 'bg-primary/70'}`} style={`width: ${row.awayPct}%`}></span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Officials -->
    {officials.length > 0 && (
      <section class="mt-8">
        <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Perangkat laga</h2>
        </div>
        <div class="border border-white/12 bg-[#0c0b0f]">
          <div class="divide-y divide-white/5">
            {officials.map((row) => (
              <div class="flex items-baseline justify-between gap-3 px-4 py-2.5">
                <span class="text-[10px] uppercase tracking-[0.14em] text-white/35">{row.label}</span>
                <span class="text-right text-[12px] text-white/80">{row.name}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- External Link -->
    {fixture.match_url && (
      <div class="mt-8 border-t border-white/10 pt-4">
        <a
          href={fixture.match_url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary hover:text-primary/80"
        >
          Lihat detail di iLeague.id ↗
        </a>
      </div>
    )}
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": `${fixture.home_team} vs ${fixture.away_team}`,
  "startDate": fixture.date,
  "location": {
    "@type": "Place",
    "name": fixture.venue
  },
  "homeTeam": {
    "@type": "SportsTeam",
    "name": fixture.home_team
  },
  "awayTeam": {
    "@type": "SportsTeam",
    "name": fixture.away_team
  },
  ...(fixture.score && {
    "score": {
      "@type": "SportsEvent",
      "homeScore": parseInt(homeScore),
      "awayScore": parseInt(awayScore)
    }
  })
})} />
