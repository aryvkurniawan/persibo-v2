---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Lineup from '../../components/Lineup.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { loadFixtures, getMatchDetailSlug, loadMatchDetails, getMatchDetailByUrl, loadTeams, getTeamLogo, CURRENT_SEASON, ARCHIVE_SEASON, type Season } from '../../utils/dataLoader';
import { formatDateLong } from '../../utils/dates';

export async function getStaticPaths() {
  const paths = [];
  const seasons: Season[] = [CURRENT_SEASON, ARCHIVE_SEASON];

  for (const season of seasons) {
    const fixtures = await loadFixtures(season);
    const matchDetails = await loadMatchDetails(season);

    for (const fixture of fixtures) {
      const matchDetail = fixture.match_url ? getMatchDetailByUrl(matchDetails, fixture.match_url) : null;
      paths.push({
        params: { slug: getMatchDetailSlug(fixture) },
        props: { fixture, matchDetail: matchDetail || null, season },
      });
    }
  }

  return paths;
}

const { fixture, matchDetail, season } = Astro.props;
const teams = await loadTeams(season);
const seasonLabel = season === ARCHIVE_SEASON ? '2025-26' : '2026-27';

const isCompleted = fixture.status === 'COMPLETED';
const isPersiboHome = fixture.home_team.toUpperCase().includes('PERSIBO');
const isPersiboAway = fixture.away_team.toUpperCase().includes('PERSIBO');
const [homeScore, awayScore] = fixture.score ? fixture.score.split(':') : ['', ''];
const matchState = isCompleted ? `Skor ${fixture.score}` : `Jadwal ${fixture.time}`;
const persiboWon = isCompleted && (parseInt(homeScore) > parseInt(awayScore) ? isPersiboHome : (parseInt(awayScore) > parseInt(homeScore) ? isPersiboAway : false));
const persiboLost = isCompleted && (parseInt(homeScore) < parseInt(awayScore) ? isPersiboHome : (parseInt(awayScore) < parseInt(homeScore) ? isPersiboAway : false));
const isDraw = isCompleted && homeScore === awayScore;

const homeTeamLogo = isPersiboHome ? '/logo-64.png' : (getTeamLogo(teams, fixture.home_team) || null);
const awayTeamLogo = isPersiboAway ? '/logo-64.png' : (getTeamLogo(teams, fixture.away_team) || null);

const hasPlayers = (lineup?: { starting_xi: unknown[]; substitutes: unknown[] }) =>
  Boolean(lineup && (lineup.starting_xi.length > 0 || lineup.substitutes.length > 0));
const homeLineup = hasPlayers(matchDetail?.lineups?.home_team) ? matchDetail!.lineups.home_team : null;
const awayLineup = hasPlayers(matchDetail?.lineups?.away_team) ? matchDetail!.lineups.away_team : null;

const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Pertandingan', href: '/pertandingan' },
  { label: 'Detail Pertandingan', href: `/pertandingan/${getMatchDetailSlug(fixture)}` }
];
---

<Layout
  title={`${fixture.home_team} vs ${fixture.away_team} - ${isCompleted ? 'Hasil' : 'Jadwal'} Pertandingan (Unofficial)`}
  description={`${isCompleted ? 'Hasil' : 'Jadwal'} pertandingan ${fixture.home_team} vs ${fixture.away_team} di Liga Nusantara ${seasonLabel}. ${matchState}, tanggal ${fixture.date}, venue ${fixture.venue}.`}
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <Breadcrumb items={breadcrumbItems} />
    <h1 class="sr-only">{fixture.home_team} vs {fixture.away_team} - {fixture.date}</h1>

    <!-- Match Header -->
    <div class="border border-white/12 bg-[#0c0b0f]">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/10 px-4 py-3">
        <span class="text-[9px] font-bold uppercase tracking-[0.18em] text-primary">Liga Nusantara {seasonLabel}</span>
        <div class="flex flex-col items-end gap-0.5 text-right">
          <span class="text-[9px] uppercase tracking-[0.16em] text-white/40">{formatDateLong(fixture.date)} · {fixture.time ?? '15.30'} WIB</span>
          <span class="text-[9px] uppercase tracking-[0.16em] text-white/25">{fixture.venue}</span>
        </div>
      </div>

      <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 px-4 py-8 lg:gap-8 lg:px-10 lg:py-12">
        <div class="flex flex-col items-center gap-2 text-center">
          {homeTeamLogo && (
            <img src={homeTeamLogo} alt={`Logo ${fixture.home_team}`} class="h-14 w-14 object-contain lg:h-20 lg:w-20" width="80" height="80" loading="lazy" />
          )}
          <h2 class={`font-cond text-xl font-semibold uppercase leading-none lg:text-3xl ${isPersiboHome ? 'text-white' : 'text-white/60'}`}>
            {fixture.home_team}
          </h2>
          <span class="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">Kandang</span>
        </div>

        <div class="flex flex-col items-center gap-2">
          {isCompleted ? (
            <>
              <span class={`font-cond text-5xl font-bold leading-none tnum lg:text-7xl ${
                persiboWon ? 'text-green-400' : persiboLost ? 'text-red-400' : 'text-yellow-400'
              }`}>
                {homeScore}<span class="px-1 text-white/20">:</span>{awayScore}
              </span>
              <span class={`border px-2 py-0.5 text-[8px] font-bold uppercase tracking-[0.16em] ${
                persiboWon ? 'border-green-500/40 text-green-400' : persiboLost ? 'border-red-500/40 text-red-400' : 'border-yellow-500/40 text-yellow-400'
              }`}>
                {persiboWon ? 'Menang' : persiboLost ? 'Kalah' : 'Seri'}
              </span>
            </>
          ) : (
            <>
              <span class="font-cond text-5xl font-bold leading-none text-white tnum lg:text-7xl">{fixture.time ?? '15.30'}</span>
              <span class="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">WIB · Jadwal</span>
            </>
          )}
        </div>

        <div class="flex flex-col items-center gap-2 text-center">
          {awayTeamLogo && (
            <img src={awayTeamLogo} alt={`Logo ${fixture.away_team}`} class="h-14 w-14 object-contain lg:h-20 lg:w-20" width="80" height="80" loading="lazy" />
          )}
          <h2 class={`font-cond text-xl font-semibold uppercase leading-none lg:text-3xl ${isPersiboAway ? 'text-white' : 'text-white/60'}`}>
            {fixture.away_team}
          </h2>
          <span class="text-[8px] font-bold uppercase tracking-[0.18em] text-white/30">Tandang</span>
        </div>
      </div>

      <div class="flex items-center justify-between gap-3 border-t border-white/10 px-4 py-3">
        <ShareButtons
          title={`${fixture.home_team} vs ${fixture.away_team} - ${isCompleted ? fixture.score : fixture.date}`}
          description={`${isCompleted ? 'Hasil' : 'Jadwal'} pertandingan ${fixture.home_team} vs ${fixture.away_team} di Liga Nusantara ${seasonLabel}. ${matchState}, tanggal ${fixture.date}.`}
          type="match"
        />
        {fixture.match_url && (
          <a href={fixture.match_url} target="_blank" rel="noopener noreferrer" class="text-[9px] font-bold uppercase tracking-[0.18em] text-white/40 hover:text-primary">
            iLeague ↗
          </a>
        )}
      </div>
    </div>

    <!-- Lineups (scrape only captures the PERSIBO side) -->
    {matchDetail && (homeLineup || awayLineup) && (
      <section class="mt-8">
        <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Lineup</h2>
          <span class="text-[9px] uppercase tracking-[0.18em] text-white/30">Starting XI</span>
        </div>
        <div class={`grid grid-cols-1 gap-3 ${homeLineup && awayLineup ? 'lg:grid-cols-2' : ''}`}>
          {homeLineup && <Lineup lineup={homeLineup} teamName={fixture.home_team} isHome={true} />}
          {awayLineup && <Lineup lineup={awayLineup} teamName={fixture.away_team} isHome={false} />}
        </div>
      </section>
    )}

    <!-- Events Timeline -->
    {matchDetail && matchDetail.events && matchDetail.events.length > 0 && (
      <section class="mt-8">
        <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Timeline</h2>
          <span class="text-[9px] uppercase tracking-[0.18em] text-white/30">{matchDetail.events.length} kejadian</span>
        </div>
        <div class="border border-white/12 bg-[#0c0b0f]">
          <div class="divide-y divide-white/5">
            {matchDetail.events.map((event) => (
              <div class="flex items-center gap-3 px-4 py-3">
                <span class="w-10 shrink-0 text-right font-cond text-lg font-bold leading-none text-primary tnum">{event.minute}'</span>
                <span class="material-symbols-outlined text-base text-white/40">
                  {event.type === 'goal' ? 'sports_soccer' : event.type === 'yellow_card' ? 'warning' : event.type === 'red_card' ? 'block' : 'swap_horiz'}
                </span>
                <p class="min-w-0 flex-1 truncate text-sm text-white/85">{event.player}</p>
                <span class="shrink-0 text-[9px] uppercase tracking-[0.14em] text-white/30">{event.team}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Statistics -->
    {matchDetail && matchDetail.statistics && Object.keys(matchDetail.statistics).length > 0 && (
      <section class="mt-8">
        <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
          <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Statistik</h2>
        </div>
        <div class="border border-white/12 bg-[#0c0b0f]">
          <div class="divide-y divide-white/5">
            {Object.entries(matchDetail.statistics).map(([key, value]) => {
              const isPair = value !== null && typeof value === 'object';
              return (
                <div class="flex items-center justify-between gap-4 px-4 py-3">
                  <span class="shrink-0 text-[10px] uppercase tracking-[0.14em] text-white/40">{key.replace(/_/g, ' ')}</span>
                  {isPair ? (
                    <span class="flex min-w-0 flex-col items-end gap-1 text-right">
                      {Object.entries(value).map(([side, sideValue]) => (
                        <span class="line-clamp-2 max-w-[22rem] break-words text-[10px] leading-snug text-white/60">
                          <span class="mr-1 uppercase tracking-[0.14em] text-white/30">{side}</span>
                          {String(sideValue)}
                        </span>
                      ))}
                    </span>
                  ) : (
                    <span class="font-cond text-lg font-semibold leading-none text-white tnum">{String(value)}</span>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- External Link -->
    {fixture.match_url && (
      <div class="mt-8 border-t border-white/10 pt-4">
        <a
          href={fixture.match_url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary hover:text-primary/80"
        >
          Lihat detail di iLeague.id ↗
        </a>
      </div>
    )}
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": `${fixture.home_team} vs ${fixture.away_team}`,
  "startDate": fixture.date,
  "location": {
    "@type": "Place",
    "name": fixture.venue
  },
  "homeTeam": {
    "@type": "SportsTeam",
    "name": fixture.home_team
  },
  "awayTeam": {
    "@type": "SportsTeam",
    "name": fixture.away_team
  },
  ...(fixture.score && {
    "score": {
      "@type": "SportsEvent",
      "homeScore": parseInt(homeScore),
      "awayScore": parseInt(awayScore)
    }
  })
})} />
