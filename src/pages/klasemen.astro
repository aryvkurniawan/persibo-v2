---
import Layout from '../layouts/Layout.astro';
import StandingsTable from '../components/StandingsTable.astro';
import { loadStandings } from '../utils/dataLoader';

const standings = await loadStandings();
const groups = ['A', 'B', 'C', 'D'];
---

<Layout 
  title="Klasemen Liga Nusantara 2025-2026 - PERSIBO Bojonegoro (Unofficial)"
  description="Lihat klasemen lengkap Liga Nusantara 2025-2026. Posisi PERSIBO Bojonegoro dan semua tim di grup A, B, C, D dengan statistik lengkap. Website Unofficial."
>
  <div class="max-w-7xl mx-auto px-4 lg:px-6 py-4 lg:py-6">
    <!-- Intro Text -->
    <section class="mb-6 lg:mb-8">
      <div class="rounded-xl bg-slate-800/50 p-6 lg:p-8 border border-slate-700">
        <h1 class="text-2xl lg:text-3xl font-extrabold text-white mb-3 lg:mb-4">Klasemen Liga Nusantara 2025-2026</h1>
        <div class="space-y-3 lg:space-y-4 text-slate-300 leading-relaxed text-sm lg:text-base">
          <p>
            Berikut adalah klasemen lengkap <strong class="text-white">Liga Nusantara 2025-2026</strong> untuk semua grup (A, B, C, D). <strong class="text-primary">PERSIBO Bojonegoro</strong> saat ini berlaga di <strong class="text-primary">Grup C</strong> bersama tim-tim lainnya.
          </p>
          <p>
            Klasemen ini menampilkan posisi, jumlah pertandingan (Main), kemenangan (Menang), hasil seri (Seri), kekalahan (Kalah), selisih gol (Gol), dan total poin (Poin) untuk setiap tim. Gunakan quick jump di bawah untuk langsung melihat grup tertentu.
          </p>
        </div>
      </div>
    </section>

    <!-- Quick Jump to Group -->
    <div class="mb-4 lg:mb-6 sticky lg:static top-20 lg:top-0 z-10 bg-background-dark/95 backdrop-blur-sm pb-2">
      <div class="flex gap-2 lg:gap-3 overflow-x-auto lg:overflow-x-visible pb-2 [-ms-scrollbar-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:justify-center lg:flex-wrap">
        {groups.map((group) => (
          <a 
            href={`#grup-${group}`}
            class="min-w-[60px] lg:min-w-0 flex-shrink-0 text-center py-2 px-4 lg:px-6 rounded-lg bg-slate-800/50 border border-primary/20 text-white font-medium hover:bg-primary/20 transition-colors text-sm lg:text-base"
          >
            Grup {group}
          </a>
        ))}
      </div>
    </div>

    <div class="space-y-6 lg:space-y-8">
      {groups.map((group) => (
        <div id={`grup-${group}`} class="scroll-mt-24 lg:scroll-mt-8">
          <h2 class="text-slate-100 text-[22px] lg:text-2xl font-extrabold leading-tight tracking-[-0.015em] pb-3 lg:pb-4">Grup {group}</h2>
          <StandingsTable standings={standings} group={group} />
        </div>
      ))}
    </div>
  </div>
</Layout>
