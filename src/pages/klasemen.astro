---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import StandingsTable from '../components/StandingsTable.astro';
import { loadStandings, getPersiboStanding } from '../utils/dataLoader';

const standings = await loadStandings();
const persibo = getPersiboStanding(standings);
const groups = [...new Set(standings.map((standing) => standing.group))].sort();
const totalPlayed = standings.reduce((sum, row) => sum + (row.played || 0), 0);
---

<Layout
  title="Klasemen Liga Nusantara 2026-27 - PERSIBO Bojonegoro (Unofficial)"
  description={`Lihat klasemen lengkap Liga Nusantara 2026-27. Posisi PERSIBO Bojonegoro di Grup ${persibo?.group ?? '-'} dan semua tim di setiap grup dengan statistik lengkap.`}
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <PageHeader
      label="Liga Nusantara 2026-27"
      title="Klasemen"
      description={`Posisi PERSIBO Bojonegoro di Grup ${persibo?.group ?? '-'}. ${persibo?.played === 0 ? 'Belum ada laga dimainkan.' : `${persibo?.played} laga dimainkan.`}`}
    />

    <!-- A table of zeroes ranks teams by nothing. Say so rather than letting the
         position column imply a standing that no match has produced yet. -->
    {totalPlayed === 0 && (
      <p class="mt-6 border border-white/12 border-l-2 border-l-primary bg-[#0c0b0f] px-4 py-3 text-[11px] leading-relaxed text-white/45">
        Belum ada pertandingan yang dimainkan, jadi urutan di bawah ini belum berarti apa-apa.
        Klasemen sungguhan terisi setelah matchday pertama pada 13 November 2026.
      </p>
    )}

    <!-- Quick Jump to Group -->
    <div class="mb-6 mt-6">
      <div class="flex gap-2 overflow-x-auto pb-2 [-ms-scrollbar-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:flex-wrap">
        {groups.map((group) => (
          <a
            href={`#grup-${group}`}
            class="shrink-0 border border-white/15 px-5 py-2.5 text-center text-[10px] font-bold uppercase tracking-[0.18em] text-white/70 transition-colors hover:border-primary hover:text-primary"
          >
            Grup {group}
          </a>
        ))}
      </div>
    </div>

    <div class="space-y-8">
      {groups.map((group) => (
        <section id={`grup-${group}`} class="scroll-mt-32 lg:scroll-mt-24">
          <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
            <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Grup {group}</h2>
            <span class="text-[11px] uppercase tracking-[0.18em] text-white/30">
              <span class="sm:hidden">Main · Poin</span>
              <span class="hidden sm:inline">M · S · K · SG · Poin</span>
            </span>
          </div>
          <StandingsTable standings={standings} group={group} />
        </section>
      ))}
    </div>
  </div>
</Layout>
