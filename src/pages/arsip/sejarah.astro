---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import history from '../../data/history.json';

// Seasons before 2024-25 exist only as text archives (RSSSF). They carry scores
// but no lineups, cards or referees, so this page shows what is real and says
// plainly what is not, rather than rendering empty stat blocks.
const { honours, seasons } = history;

const tierTone: Record<string, string> = {
  'Divisi Utama': 'text-primary',
  Piala: 'text-primary',
  'Divisi Satu': 'text-white/80',
  'Divisi Dua': 'text-white/80',
  'Liga 3': 'text-white/80',
  AFC: 'text-white/60',
};

const slug = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// The archive seasons that live in src/data/seasons/ and have full detail.
const detailedSeasons = [
  { season: '2025-26', href: '/arsip/2025-26', note: '12 laga, XI + cadangan + wasit' },
  { season: '2024-25', href: '/arsip/2024-25', note: '23 laga, XI + cadangan + wasit' },
];
---

<Layout
  title="Sejarah PERSIBO Bojonegoro - Prestasi dan Musim Lama (Unofficial)"
  description={`Sejarah PERSIBO Bojonegoro: ${honours.length} gelar dan ${seasons.length} musim lama dengan hasil pertandingan, dari arsip RSSSF.`}
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <PageHeader
      label="Arsip"
      title="Sejarah"
      meta={`${honours.length} gelar`}
      description="Rekam jejak PERSIBO Bojonegoro sebelum era Liga Nusantara. Skor pertandingan diambil dari arsip RSSSF; susunan pemain, kartu, dan wasit tidak pernah diterbitkan untuk musim-musim ini."
    />

    <!-- Honours -->
    <section class="mt-8">
      <div class="mb-4 flex items-end justify-between border-b border-white/15 pb-3">
        <h2 class="font-cond text-2xl font-bold uppercase tracking-wide text-white">Prestasi</h2>
        <span class="text-[10px] uppercase tracking-[0.18em] text-white/30">{honours.length} gelar</span>
      </div>
      <ul class="grid gap-px bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
        {honours.map((item) => (
          <li class="bg-[#0c0b0f] px-4 py-4">
            <p class={`font-cond text-xl font-bold leading-none ${tierTone[item.tier] ?? 'text-white/70'}`}>{item.year}</p>
            <p class="mt-2 text-[13px] leading-snug text-white/70">{item.title}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Seasons with full match detail -->
    <section class="mt-10">
      <div class="mb-4 flex items-end justify-between border-b border-white/15 pb-3">
        <h2 class="font-cond text-2xl font-bold uppercase tracking-wide text-white">Arsip lengkap</h2>
        <span class="text-[10px] uppercase tracking-[0.18em] text-white/30">punya detail laga</span>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {detailedSeasons.map((item) => (
          <a
            href={item.href}
            class="group flex items-center justify-between border border-white/12 bg-[#0c0b0f] px-4 py-4 transition-colors hover:border-primary"
          >
            <span>
              <span class="font-cond text-2xl font-bold uppercase leading-none text-white group-hover:text-primary">{item.season}</span>
              <span class="mt-1 block text-[12px] text-white/40">{item.note}</span>
            </span>
            <span class="material-symbols-outlined text-white/30 group-hover:text-primary">arrow_forward</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Older seasons: scores only -->
    <section class="mt-10">
      <div class="mb-4 flex items-end justify-between border-b border-white/15 pb-3">
        <h2 class="font-cond text-2xl font-bold uppercase tracking-wide text-white">Musim lama</h2>
        <span class="text-[10px] uppercase tracking-[0.18em] text-white/30">skor saja</span>
      </div>

      <div class="mb-6 max-w-2xl space-y-3 border border-white/10 bg-[#0c0b0f] px-4 py-4 text-[13px] leading-relaxed text-white/45">
        <p>
          Untuk musim sebelum 2024-25, sumber mana pun hanya menyimpan skor akhir.
          Tidak ada susunan pemain, pencetak gol, kartu, atau wasit — jadi halaman ini
          tidak menampilkannya. Angka rekor dihitung dari hasil pertandingan yang tersimpan,
          bukan disalin dari tabel.
        </p>
        <p>
          Penamaan musim di sepak bola Indonesia tidak seragam.
          <span class="text-white/70">Dua tahun</span> berarti kompetisi yang dimulai
          pertengahan tahun, seperti 2009-10. <span class="text-white/70">Satu tahun</span>
          berarti kompetisi dalam satu tahun kalender, seperti 2013. Periode 2011-2014
          diperumit dualisme federasi dan sanksi, sehingga beberapa musim berjalan
          tidak seperti biasanya.
        </p>
      </div>

      <div class="space-y-10">
        {seasons.map((season) => {
          const r = season.record;
          return (
            <article id={slug(season.season)} class="scroll-mt-28 lg:scroll-mt-24">
              <div class="flex flex-wrap items-end justify-between gap-3 border-b border-white/15 pb-3">
                <div>
                  <h3 class="font-cond text-3xl font-bold uppercase leading-none text-white">{season.season}</h3>
                  <p class="mt-1 text-[11px] uppercase tracking-[0.16em] text-white/35">
                    {season.competition}
                    {season.window && <span class="text-white/20"> · {season.window}</span>}
                  </p>
                </div>
                <p class="font-cond text-lg font-bold uppercase text-primary">{season.result}</p>
              </div>

              <p class="mt-3 max-w-2xl text-[13px] leading-relaxed text-white/45">{season.note}</p>

              <dl class="mt-4 grid grid-cols-3 gap-px bg-white/10">
                {[
                  ['Main', r.played],
                  ['Menang', r.won],
                  ['Seri', r.drawn],
                  ['Kalah', r.lost],
                  ['Gol', `${r.goals_for}-${r.goals_against}`],
                  ['Poin', r.points],
                ].map(([label, value]) => (
                  <div class="bg-[#0c0b0f] px-3 py-3 text-center">
                    <dt class="text-[10px] uppercase tracking-[0.14em] text-white/30">{label}</dt>
                    <dd class="mt-1 font-cond text-xl font-bold leading-none text-white tnum">{value}</dd>
                  </div>
                ))}
              </dl>

              {season.matches.length > 0 ? (
                <>
                  <div class="mt-5 flex items-end justify-between">
                    <h4 class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/40">
                      Pertandingan tersimpan
                    </h4>
                    <span class="text-[10px] uppercase tracking-[0.16em] text-white/25">
                      {season.matches.length} laga
                    </span>
                  </div>

                  {season.matches.length !== r.played && (
                    <p class="mt-2 text-[12px] leading-relaxed text-white/35">
                      {season.matches.length > r.played
                        ? `Rekor di atas hanya menghitung ${r.played} laga liga; daftar ini juga memuat laga gugur.`
                        : `Arsip sumber hanya mencatat ${season.matches.length} dari ${r.played} laga; sisanya hilang sebelum sempat didokumentasikan.`}
                    </p>
                  )}

                  <ul class="mt-3 divide-y divide-white/[0.06] border border-white/12 bg-[#0c0b0f]">
                    {season.matches.map((match) => {
                      const persiboHome = match.home.toLowerCase().includes('persibo');
                      const own = persiboHome ? match.home_score : match.away_score;
                      const theirs = persiboHome ? match.away_score : match.home_score;
                      const outcome = own > theirs ? 'M' : own === theirs ? 'S' : 'K';
                      const tone = outcome === 'M' ? 'text-primary' : outcome === 'K' ? 'text-white/30' : 'text-white/55';
                      return (
                        <li class="flex items-center gap-3 px-3 py-2.5">
                          <span class={`w-4 shrink-0 font-cond text-sm font-bold ${tone}`}>{outcome}</span>
                          <span class={`min-w-0 flex-1 truncate text-[13px] ${persiboHome ? 'font-semibold text-white/85' : 'text-white/55'}`}>
                            {match.home}
                          </span>
                          <span class="shrink-0 font-cond text-sm font-bold text-white tnum">
                            {match.home_score}–{match.away_score}
                          </span>
                          <span class={`min-w-0 flex-1 truncate text-right text-[13px] ${!persiboHome ? 'font-semibold text-white/85' : 'text-white/55'}`}>
                            {match.away}
                          </span>
                          {match.round && (
                            <span class="hidden w-24 shrink-0 truncate text-right text-[10px] uppercase tracking-[0.12em] text-white/25 sm:block">
                              {match.round.replace(/ \[.*$/, '')}
                            </span>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </>
              ) : (
                <p class="mt-5 border border-dashed border-white/12 px-4 py-4 text-[13px] text-white/35">
                  Tidak ada daftar pertandingan yang bertahan untuk musim ini. Hanya rekor akhirnya yang tercatat.
                </p>
              )}

              <p class="mt-4 border-t border-white/[0.06] pt-3 text-[11px] leading-relaxed text-white/45">
                Sumber:{' '}
                <a href={season.source} target="_blank" rel="noopener noreferrer" class="text-white/45 underline decoration-white/20 hover:text-primary">RSSSF</a>
                {season.credit && season.credit.length > 0 && (
                  <> — disusun oleh {season.credit.join(', ')}. Digunakan dengan mencantumkan penulis sesuai syarat RSSSF.</>
                )}
              </p>
            </article>
          );
        })}
      </div>
    </section>

    <div class="mt-10 flex flex-wrap items-center gap-6 border-t border-white/10 pt-6">
      <a href="/arsip/pemain" class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary hover:text-primary/80">
        Semua pemain →
      </a>
      <a href="/arsip/2025-26" class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/40 hover:text-white/70">
        Arsip 2025-26
      </a>
      <a href="/" class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/40 hover:text-white/70">
        Kembali ke musim 2026-27
      </a>
    </div>
  </div>
</Layout>
