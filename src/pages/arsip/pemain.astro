---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PlayerTable from '../../components/PlayerTable.astro';
import faces from '../../data/players/faces.json';
import { loadPlayerDetails } from '../../utils/dataLoader';

type Face = {
  player_id: number;
  name: string;
  seasons: string[];
  photo_url: string;
  photo_local?: string;
};

// Everyone who has worn the shirt, newest season first. iLeague re-registers
// players each year, so this list is the one place that remembers them across
// seasons even after their registration lapses.
const players = (faces as Face[])
  .map((player) => ({
    ...player,
    seasons: [...player.seasons].sort().reverse(),
    latest: [...player.seasons].sort().reverse()[0] ?? '',
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const bySeason = players.reduce<Record<string, number>>((acc, player) => {
  for (const season of player.seasons) acc[season] = (acc[season] ?? 0) + 1;
  return acc;
}, {});

const seasonLabels = Object.keys(bySeason).sort().reverse();
const currentSquad = players.filter((p) => p.seasons.includes('2025-26')).length;

// Every archived player now has a profile, including the 2024-25-only ones that
// the scraper backfilled. Slug comes from the same rule the route uses, so a row
// can never point at a page that does not exist.
const slugify = (name: string) => name.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '');
// Both spellings point at the same record: faces.json carries the full name
// ("ADRE ARIDO GEOVANI") while the squad list and the profile page use the short
// one ("ADRE ARIDO"). Without the alias map 27 rows stayed unclickable.
// Keys are normalised because iLeague mixes cases: full_name is sometimes
// "Ilham Maulana" and sometimes "ILHAM MAULANA", and an exact lookup dropped four rows.
const keyOf = (value: string) => value.toUpperCase().replace(/[^A-Z0-9]/g, '');
const detailByName = new Map<string, Awaited<ReturnType<typeof loadPlayerDetails>>[number]>();
for (const detail of await loadPlayerDetails()) {
  detailByName.set(keyOf(detail.name), detail);
  if (detail.full_name) detailByName.set(keyOf(detail.full_name), detail);
}
const rows = players.map((player) => {
  const detail = detailByName.get(keyOf(player.name));
  const photo = player.photo_local || player.photo_url || null;
  return {
    name: player.name,
    slug: detail ? slugify(detail.name) : null,
    position: detail?.position || '',
    age: detail?.age || '',
    photo,
    seasons: player.seasons,
  };
});
---

<Layout
  title="Arsip Pemain PERSIBO Bojonegoro - Semua yang Pernah Berkostum (Unofficial)"
  description={`Arsip ${players.length} pemain yang pernah memperkuat PERSIBO Bojonegoro, lengkap dengan musim dan fotonya.`}
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <PageHeader
      label="Arsip pemain"
      title="Pernah di Persibo"
      meta={`${players.length} pemain`}
      description={`Setiap pemain yang pernah tampil untuk PERSIBO Bojonegoro sejak 2024-25, lengkap dengan fotonya. ${currentSquad} di antaranya masih tercatat di skuad 2025-26.`}
    />

    <div class="mt-6 flex flex-wrap gap-2">
      {seasonLabels.map((season) => (
        <span class="border border-white/12 bg-[#0c0b0f] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-white/50">
          {season} <span class="text-primary">{bySeason[season]}</span>
        </span>
      ))}
    </div>

    <div class="mt-6">
      <a href="/arsip/sejarah" class="inline-flex items-center gap-2 border border-white/15 px-4 py-2 text-[10px] font-bold uppercase tracking-[0.16em] text-white/60 transition-colors hover:border-primary hover:text-primary">
        Sejarah &amp; gelar
        <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>

    <div class="mt-8">
      <PlayerTable rows={rows} showSeasons />
    </div>
  </div>
</Layout>
