---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PlayerTable from '../../components/PlayerTable.astro';
import faces from '../../data/players/faces.json';
import { loadPlayers } from '../../utils/dataLoader';

type Face = {
  player_id: number;
  name: string;
  seasons: string[];
  photo_url: string;
  photo_local?: string;
};

// Everyone who has worn the shirt, newest season first. iLeague re-registers
// players each year, so this list is the one place that remembers them across
// seasons even after their registration lapses.
const players = (faces as Face[])
  .map((player) => ({
    ...player,
    seasons: [...player.seasons].sort().reverse(),
    latest: [...player.seasons].sort().reverse()[0] ?? '',
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const bySeason = players.reduce<Record<string, number>>((acc, player) => {
  for (const season of player.seasons) acc[season] = (acc[season] ?? 0) + 1;
  return acc;
}, {});

const seasonLabels = Object.keys(bySeason).sort().reverse();
const currentSquad = players.filter((p) => p.seasons.includes('2025-26')).length;

// Only the current squad has a profile page, so older names render as plain
// text rather than a link that would 404. Match on the portrait instead of the
// name: this file carries full names ("ADRE ARIDO GEOVANI") while the squad
// list uses short ones ("ADRE ARIDO"), so names never line up.
const profileByPhoto = new Map(
  (await loadPlayers()).map((p) => [
    p.photo_local ?? p.photo_url,
    p.name.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, ''),
  ])
);
const rows = players.map((player) => {
  const photo = player.photo_local || player.photo_url || null;
  return {
    name: player.name,
    slug: profileByPhoto.get(photo) ?? null,
    position: '',
    age: '',
    photo,
    seasons: player.seasons,
  };
});
---

<Layout
  title="Arsip Pemain PERSIBO Bojonegoro - Semua yang Pernah Berkostum (Unofficial)"
  description={`Arsip ${players.length} pemain yang pernah memperkuat PERSIBO Bojonegoro, lengkap dengan musim dan fotonya.`}
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <PageHeader
      label="Arsip pemain"
      title="Pernah di Persibo"
      meta={`${players.length} pemain`}
      description={`Setiap pemain yang pernah tampil untuk PERSIBO Bojonegoro sejak 2024-25, lengkap dengan fotonya. ${currentSquad} di antaranya masih tercatat di skuad 2025-26.`}
    />

    <div class="mt-6 flex flex-wrap gap-2">
      {seasonLabels.map((season) => (
        <span class="border border-white/12 bg-[#0c0b0f] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.16em] text-white/50">
          {season} <span class="text-primary">{bySeason[season]}</span>
        </span>
      ))}
    </div>

    <div class="mt-8 max-w-3xl">
      <PlayerTable rows={rows} showSeasons />
    </div>
  </div>
</Layout>
