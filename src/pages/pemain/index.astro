---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PlayerCard from '../../components/PlayerCard.astro';
import SearchBar from '../../components/SearchBar.astro';
import FilterBar from '../../components/FilterBar.astro';
import { loadPlayers, loadPlayerDetails } from '../../utils/dataLoader';

const players = await loadPlayers();
const playerDetails = await loadPlayerDetails();

// Merge player data with details for position info and photo
const playersWithDetails = players.map(player => {
  const detail = playerDetails.find(pd => pd.name === player.name);
  return {
    ...player,
    position: detail?.position || player.position || '',
    photo_url: player.photo_local || player.photo_url || detail?.photo_url
  };
});
---

<Layout
  title="Daftar Pemain PERSIBO Bojonegoro - Skuad Lengkap (Unofficial)"
  description="Lihat daftar lengkap pemain PERSIBO Bojonegoro. Informasi pemain, posisi, statistik, dan profil lengkap seluruh skuad tim."
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <PageHeader
      label="Skuad 2025-26 · Arsip"
      title="Pemain"
      meta={`${playersWithDetails.length} pemain`}
      description="Skuad terakhir PERSIBO Bojonegoro yang terdaftar di Liga Nusantara 2025-26. Data skuad 2026-27 menyusul setelah pendaftaran."
    />

    <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-4 lg:gap-6">
      <div class="lg:col-span-1">
        <div class="space-y-3 lg:sticky lg:top-24">
          <SearchBar />

          <button id="filter-toggle" class="flex w-full items-center justify-between border border-white/15 bg-[#0c0b0f] px-4 py-3 text-white lg:hidden" aria-expanded="false" aria-controls="filter-panel">
            <span class="text-[10px] font-bold uppercase tracking-[0.18em]">Filter</span>
            <span class="material-symbols-outlined text-lg text-white/40" id="filter-icon">expand_more</span>
          </button>

          <div id="filter-panel" class="hidden lg:block">
            <FilterBar />
          </div>
        </div>
      </div>

      <div class="lg:col-span-3">
        <div id="players-container" class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:gap-4">
          {playersWithDetails.map((player) => (
            <PlayerCard player={player} />
          ))}
        </div>

        <p id="no-results" class="hidden py-16 text-center text-sm text-white/40">
          Tidak ada pemain yang ditemukan.
        </p>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  (function() {
    function init() {
      const searchInput = document.getElementById('search-input');
      const positionFilter = document.getElementById('position-filter');
      const ageFilter = document.getElementById('age-filter');
      const resetFilter = document.getElementById('reset-filter');
      const playersContainer = document.getElementById('players-container');
      const noResults = document.getElementById('no-results');
      const filterToggle = document.getElementById('filter-toggle');
      const filterPanel = document.getElementById('filter-panel');
      const filterIcon = document.getElementById('filter-icon');

      if (!searchInput || !playersContainer) return;

      const playerCards = playersContainer.querySelectorAll('[data-player-card]');

      if (filterToggle && filterPanel && filterIcon) {
        filterToggle.addEventListener('click', () => {
          const isHidden = filterPanel.classList.contains('hidden');
          filterPanel.classList.toggle('hidden', !isHidden);
          filterToggle.setAttribute('aria-expanded', String(isHidden));
          filterIcon.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
        });
      }

      function filterPlayers() {
        const searchTerm = (searchInput?.value || '').toLowerCase();
        const selectedPosition = positionFilter?.value || '';
        const selectedAge = ageFilter?.value || '';

        let visibleCount = 0;

        playerCards.forEach((card) => {
          const playerName = (card.getAttribute('data-player-name') || '').toLowerCase();
          const playerPosition = card.getAttribute('data-player-position') || '';
          const playerAge = parseInt(card.getAttribute('data-player-age') || '0');

          const matchesSearch = !searchTerm || playerName.includes(searchTerm);
          const matchesPosition = !selectedPosition || playerPosition === selectedPosition;

          let matchesAge = true;
          if (selectedAge) {
            if (selectedAge === '18-22') matchesAge = playerAge >= 18 && playerAge <= 22;
            else if (selectedAge === '23-27') matchesAge = playerAge >= 23 && playerAge <= 27;
            else if (selectedAge === '28-32') matchesAge = playerAge >= 28 && playerAge <= 32;
            else if (selectedAge === '33+') matchesAge = playerAge >= 33;
          }

          if (matchesSearch && matchesPosition && matchesAge) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCount === 0) {
          playersContainer.classList.add('hidden');
          if (noResults) noResults.classList.remove('hidden');
        } else {
          playersContainer.classList.remove('hidden');
          if (noResults) noResults.classList.add('hidden');
        }
      }

      if (searchInput) searchInput.addEventListener('input', filterPlayers);
      if (positionFilter) positionFilter.addEventListener('change', filterPlayers);
      if (ageFilter) ageFilter.addEventListener('change', filterPlayers);
      if (resetFilter) {
        resetFilter.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          if (positionFilter) positionFilter.value = '';
          if (ageFilter) ageFilter.value = '';
          filterPlayers();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
