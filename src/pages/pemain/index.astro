---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PlayerTable from '../../components/PlayerTable.astro';
import SearchBar from '../../components/SearchBar.astro';
import FilterBar from '../../components/FilterBar.astro';
import { loadPlayers, loadPlayerDetails } from '../../utils/dataLoader';

const players = await loadPlayers();
const playerDetails = await loadPlayerDetails();

const slugify = (name: string) => name.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '');

// Career totals come from the history table, not the hero figures: the hero is
// scraped separately and often still reads zero for players who appeared.
const rows = players.map((player) => {
  const detail = playerDetails.find((pd) => pd.name === player.name);
  const totals = detail?.club_history?.reduce(
    (acc, row) => ({
      appearances: acc.appearances + (parseInt(row.appearances) || 0),
      goals: acc.goals + (parseInt(row.goals) || 0),
      saves: acc.saves + (parseInt(row.saves) || 0),
    }),
    { appearances: 0, goals: 0, saves: 0 }
  );
  return {
    name: player.name,
    slug: slugify(player.name),
    position: detail?.position || player.position || '',
    age: player.age,
    jersey: player.jersey_number,
    photo: player.photo_local || player.photo_url || detail?.photo_url || null,
    seasons: [],
    appearances: totals?.appearances ?? 0,
    goals: totals?.goals ?? 0,
    saves: totals?.saves ?? 0,
  };
});
---

<Layout
  title="Daftar Pemain PERSIBO Bojonegoro - Skuad Lengkap (Unofficial)"
  description="Lihat daftar lengkap pemain PERSIBO Bojonegoro. Informasi pemain, posisi, statistik, dan profil lengkap seluruh skuad tim."
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <PageHeader
      label="Skuad 2025-26 · Arsip"
      title="Pemain"
      meta={`${rows.length} pemain`}
      description="Skuad terakhir PERSIBO Bojonegoro yang terdaftar di Liga Nusantara 2025-26. Data skuad 2026-27 menyusul setelah pendaftaran."
    />

    <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-4 lg:gap-6">
      <div class="lg:col-span-1">
        <div class="space-y-3 lg:sticky lg:top-24">
          <SearchBar />

          <button id="filter-toggle" class="flex w-full items-center justify-between border border-white/15 bg-[#0c0b0f] px-4 py-3 text-white lg:hidden" aria-expanded="false" aria-controls="filter-panel">
            <span class="text-[10px] font-bold uppercase tracking-[0.18em]">Filter</span>
            <span class="material-symbols-outlined text-lg text-white/40" id="filter-icon">expand_more</span>
          </button>

          <div id="filter-panel" class="hidden lg:block">
            <FilterBar />
          </div>
        </div>
      </div>

      <div class="lg:col-span-3">
        <PlayerTable rows={rows} />
      </div>
    </div>
  </div>
</Layout>


