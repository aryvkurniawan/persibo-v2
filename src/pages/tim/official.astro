---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { loadOfficials } from '../../utils/dataLoader';

const officials = await loadOfficials();

const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Tim', href: '/tim' },
  { label: 'Official & Staff', href: '/tim/official' }
];
---

<Layout 
  title="Official & Staff PERSIBO Bojonegoro (Unofficial)"
  description="Lihat daftar lengkap official dan staff PERSIBO Bojonegoro. Pelatih kepala, asisten pelatih, manager tim, dan seluruh staff pendukung. Website Unofficial."
>
  <div class="px-4 py-4">
    <Breadcrumb items={breadcrumbItems} />
    
    <!-- Intro Text -->
    <section class="mb-6">
      <div class="rounded-xl bg-slate-800/50 p-6 border border-slate-700">
        <h1 class="text-2xl font-extrabold text-white mb-3">Official & Staff PERSIBO Bojonegoro</h1>
        <p class="text-slate-300 leading-relaxed">
          Berikut adalah daftar lengkap <strong class="text-white">official dan staff PERSIBO Bojonegoro</strong> yang mengelola tim di musim Liga Nusantara 2025-26. Tim ini didukung oleh pelatih kepala, asisten pelatih, manager tim, dan seluruh staff pendukung yang berdedikasi untuk kesuksesan tim.
        </p>
      </div>
    </section>
    
    <div class="flex items-center gap-3 mb-6">
      <a href="/tim" class="text-slate-400 hover:text-white transition-colors">
        <span class="material-symbols-outlined text-2xl">arrow_back</span>
      </a>
      <h2 class="text-2xl font-extrabold text-white">Daftar Official & Staff</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {officials.map((official) => (
        <div class="rounded-xl bg-slate-800/50 shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
          {official.photo_url && (
            <div class="w-full h-80 md:h-96 bg-cover bg-top bg-no-repeat" style={`background-image: url("${official.photo_url}"); background-position: center top;`}>
              <div class="w-full h-full bg-gradient-to-t from-slate-800/80 to-transparent"></div>
              <img src={official.photo_url} alt={`Foto ${official.name}, ${official.position} PERSIBO Bojonegoro`} class="sr-only" />
            </div>
          )}
          <div class="p-4">
            <h3 class="text-xl font-bold text-white mb-2">{official.name}</h3>
            {official.position && (
              <p class="text-slate-400 mb-4">{official.position}</p>
            )}
            <p class="text-sm text-slate-500">Tim: {official.team}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
