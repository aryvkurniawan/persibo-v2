---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { loadOfficials } from '../../utils/dataLoader';

const officials = await loadOfficials();

const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Tim', href: '/tim' },
  { label: 'Ofisial & Staf', href: '/tim/official' }
];

const initials = (name: string) =>
  name.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---

<Layout
  title="Ofisial & Staf PERSIBO Bojonegoro (Unofficial)"
  description="Daftar official dan staff PERSIBO Bojonegoro: pelatih kepala, asisten pelatih, manager tim, dan staff pendukung."
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <Breadcrumb items={breadcrumbItems} />

    <PageHeader
      label="Struktur tim"
      title="Ofisial & Staf"
      meta={`${officials.length} orang`}
      description="Pelatih, manajer, dan staf pendukung PERSIBO Bojonegoro."
    />

    <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4 lg:gap-4">
      {officials.map((official) => {
        const photo = official.photo_local || official.photo_url;
        return (
          <div class="border border-white/12 bg-[#0c0b0f]">
            <div class="relative aspect-[3/4] w-full overflow-hidden bg-[#161318]">
              <div class="absolute inset-0 flex items-center justify-center font-cond text-5xl font-bold text-white/10 select-none">
                {initials(official.name)}
              </div>
              {photo && (
                <img
                  src={photo}
                  alt={`Foto ${official.name}, ${official.position} PERSIBO Bojonegoro`}
                  class="absolute inset-0 h-full w-full object-cover object-top opacity-90"
                  loading="lazy"
                  width="400"
                  height="533"
                  onerror="this.remove()"
                />
              )}
              <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[#0c0b0f] to-transparent"></div>
            </div>
            <div class="border-t border-white/10 p-3">
              <h2 class="line-clamp-2 font-cond text-lg font-semibold uppercase leading-[1.05] text-white">{official.name}</h2>
              {official.position && (
                <p class="mt-1 text-[9px] font-bold uppercase tracking-[0.14em] text-primary">{official.position}</p>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
