---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const menu = [
  {
    title: 'Profil Tim',
    desc: 'Sejarah, visi misi, dan prestasi',
    href: '/tim/profil',
    icon: 'shield',
  },
  {
    title: 'Official & Staff',
    desc: 'Pelatih, manajer, dan staf pendukung',
    href: '/tim/official',
    icon: 'groups',
  },
  {
    title: 'Berita',
    desc: 'Kabar terbaru Laskar Angling Dharma',
    href: '/tim/berita',
    icon: 'newspaper',
  },
];
---

<Layout
  title="Tim PERSIBO Bojonegoro (Unofficial)"
  description="Informasi lengkap tentang tim PERSIBO Bojonegoro: profil, official, dan berita."
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <PageHeader
      label="Laskar Angling Dharma"
      title="Tim"
      meta="Liga Nusantara 2026-27"
      description="PERSIBO Bojonegoro, klub kebanggaan Bojonegoro. Didirikan 12 Maret 1949."
    />

    <div class="mt-8 grid grid-cols-1 gap-3 md:grid-cols-3">
      {menu.map((item) => (
        <a href={item.href} class="group border border-white/12 bg-[#0c0b0f] p-5 transition-colors hover:border-primary/60">
          <div class="flex items-start justify-between">
            <span class="material-symbols-outlined text-2xl text-primary">{item.icon}</span>
            <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/30 transition-colors group-hover:text-primary">→</span>
          </div>
          <h2 class="font-cond mt-6 text-2xl font-semibold uppercase leading-none text-white">{item.title}</h2>
          <p class="mt-2 text-xs leading-relaxed text-white/40">{item.desc}</p>
        </a>
      ))}
    </div>

    <div class="mt-10 border-t border-white/10 pt-6">
      <p class="text-[10px] uppercase tracking-[0.16em] text-white/30">
        Tidak berafiliasi dengan manajemen resmi PERSIBO Bojonegoro
      </p>
    </div>
  </div>
</Layout>
