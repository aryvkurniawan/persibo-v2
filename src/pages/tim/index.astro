---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PlayerTable from '../../components/PlayerTable.astro';
import { loadFixtures, loadOfficials, loadPlayers, loadPlayerDetails, loadStandings, getPersiboStanding, getTeamLogo, loadTeams, CURRENT_SEASON } from '../../utils/dataLoader';
import { formatDateShort, parseFixtureDate } from '../../utils/dates';

const fixtures = await loadFixtures(CURRENT_SEASON);
const officials = await loadOfficials();
const players = await loadPlayers();
const playerDetails = await loadPlayerDetails();
const standings = await loadStandings(CURRENT_SEASON);
const teams = await loadTeams(CURRENT_SEASON);
const persibo = getPersiboStanding(standings);

const today = new Date();
const upcoming = [...fixtures]
  .filter((f) => {
    const date = parseFixtureDate(f.date);
    return date ? date >= new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate())) : true;
  })
  .sort((a, b) => (parseFixtureDate(a.date)?.getTime() ?? 0) - (parseFixtureDate(b.date)?.getTime() ?? 0));
const next = upcoming[0] ?? null;
const played = fixtures.filter((f) => f.status === 'COMPLETED').length;
const group = persibo?.group ?? '-';

// Same shape the squad table expects, so /tim and /pemain stay in step.
const slugify = (name: string) => name.toLowerCase().replace(/\s+/g, '-').replace(/[^\w\-]+/g, '');
const squad = players.map((player) => {
  const detail = playerDetails.find((pd) => pd.name === player.name);
  const totals = detail?.club_history?.reduce(
    (acc, row) => ({
      appearances: acc.appearances + (parseInt(row.appearances) || 0),
      goals: acc.goals + (parseInt(row.goals) || 0),
      saves: acc.saves + (parseInt(row.saves) || 0),
    }),
    { appearances: 0, goals: 0, saves: 0 }
  );
  return {
    name: player.name,
    slug: slugify(player.name),
    position: detail?.position || player.position || '',
    age: player.age,
    jersey: player.jersey_number,
    photo: player.photo_local || player.photo_url || detail?.photo_url || null,
    seasons: [],
    appearances: totals?.appearances ?? 0,
    goals: totals?.goals ?? 0,
    saves: totals?.saves ?? 0,
  };
});

const byPosition = squad.reduce<Record<string, number>>((acc, p) => {
  const key = p.position || 'LAINNYA';
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});

const nextLogo = next
  ? next.home_team.toUpperCase().includes('PERSIBO')
    ? getTeamLogo(teams, next.away_team)
    : getTeamLogo(teams, next.home_team)
  : null;

const nextIsHome = next?.home_team.toUpperCase().includes('PERSIBO') ?? false;
const nextOpponent = next ? (nextIsHome ? next.away_team : next.home_team) : null;
---

<Layout
  title="Tim PERSIBO Bojonegoro (Unofficial)"
  description="Informasi lengkap tentang tim PERSIBO Bojonegoro: profil, ofisial, dan berita."
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <PageHeader
      label="Laskar Angling Dharma"
      title="Tim"
      meta="Liga Nusantara 2026-27"
      description="PERSIBO Bojonegoro, klub kebanggaan Bojonegoro. Didirikan 12 Maret 1949."
    />

    <!-- The season has not kicked off, so results and standings have nothing to
         say. Lead with what exists: the next fixture, then the people. -->
    <div class="mt-8 grid gap-3 lg:grid-cols-3">
      {next ? (
        <a
          href={`/pertandingan#${next.match_url}`}
          class="group flex flex-col border border-white/12 bg-[#0c0b0f] p-5 transition-colors hover:border-primary/60 lg:col-span-2"
        >
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-primary">Laga berikutnya</p>
            <p class="text-[11px] uppercase tracking-[0.16em] text-white/35">Matchday 01 · Grup {group}</p>
          </div>
          <div class="mt-4 flex flex-1 items-center gap-4">
            <div class="flex min-w-0 flex-1 items-center gap-3">
              <img src="/logo-32.png" alt="PERSIBO Bojonegoro" width="40" height="40" class="h-10 w-10 shrink-0 object-contain" />
              <div class="min-w-0">
                <p class="truncate font-cond text-lg font-bold uppercase leading-none text-white">PERSIBO</p>
                <p class="mt-1 text-[11px] uppercase tracking-[0.14em] text-white/30">Bojonegoro</p>
              </div>
            </div>
            <p class="shrink-0 font-cond text-sm font-bold text-white/25">VS</p>
            <div class="flex min-w-0 flex-1 items-center justify-end gap-3 text-right">
              <div class="min-w-0">
                <p class="truncate font-cond text-lg font-bold uppercase leading-none text-white">{nextOpponent}</p>
                <p class="mt-1 text-[11px] uppercase tracking-[0.14em] text-white/30">{nextIsHome ? 'Tandang' : 'Kandang'}</p>
              </div>
              {nextLogo && <img src={nextLogo} alt={nextOpponent ?? ''} width="40" height="40" class="h-10 w-10 shrink-0 object-contain" />}
            </div>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-white/10 pt-3 text-[10px] uppercase tracking-[0.14em] text-white/40">
            <span class="text-white/70">{formatDateShort(next.date)}</span>
            <span>{next.venue ?? 'Bojonegoro'}</span>
            <span class="ml-auto font-bold text-primary transition-colors group-hover:text-primary/80">Jadwal lengkap →</span>
          </div>
        </a>
      ) : (
        <div class="border border-white/12 bg-[#0c0b0f] p-5 lg:col-span-2">
          <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-primary">Laga berikutnya</p>
          <p class="mt-3 text-sm text-white/50">Jadwal musim 2026-27 belum dirilis.</p>
        </div>
      )}

      <div class="flex flex-col border border-white/12 bg-[#0c0b0f] p-5">
        <p class="border-b border-white/10 pb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-primary">Musim 2026-27</p>
        <dl class="mt-4 flex-1 space-y-3">
          <div class="flex items-baseline justify-between">
            <dt class="text-[10px] uppercase tracking-[0.14em] text-white/35">Grup</dt>
            <dd class="font-cond text-xl font-bold leading-none text-white">{group}</dd>
          </div>
          <div class="flex items-baseline justify-between">
            <dt class="text-[10px] uppercase tracking-[0.14em] text-white/35">Laga terjadwal</dt>
            <dd class="font-cond text-xl font-bold leading-none text-white tnum">{fixtures.length}</dd>
          </div>
          <div class="flex items-baseline justify-between">
            <dt class="text-[10px] uppercase tracking-[0.14em] text-white/35">Sudah dimainkan</dt>
            <dd class="font-cond text-xl font-bold leading-none text-white/40 tnum">{played}</dd>
          </div>
        </dl>
        {played === 0 && (
          <p class="mt-4 border-t border-white/10 pt-3 text-[10px] leading-relaxed text-white/30">
            Klasemen dan statistik menyusul setelah pertandingan pertama.
          </p>
        )}
      </div>
    </div>

    <!-- Officials -->
    <section class="mt-10">
      <div class="mb-3 flex items-end justify-between border-b border-white/15 pb-3">
        <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Ofisial & Staf</h2>
        <a href="/tim/official" class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary hover:text-primary/80">
          Semua {officials.length} orang →
        </a>
      </div>
      <ul class="grid gap-x-6 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
        {officials.map((person) => (
          <li class="flex items-baseline justify-between gap-3 border-b border-white/[0.06] py-2">
            <span class="truncate text-[11px] font-semibold uppercase tracking-wide text-white/80">{person.name}</span>
            <span class="shrink-0 text-[11px] uppercase tracking-[0.12em] text-white/30">{person.position}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Squad -->
    <section class="mt-10">
      <div class="mb-3 flex flex-wrap items-end justify-between gap-2 border-b border-white/15 pb-3">
        <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Skuad</h2>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] uppercase tracking-[0.14em] text-white/30">
          <span>{players.length} pemain</span>
          <span class="text-white/15">·</span>
          {Object.entries(byPosition).map(([position, count], index) => (
            <span>{position} <span class="text-white/50">{count}</span></span>
          ))}
          <a href="/pemain" class="ml-2 font-bold text-primary hover:text-primary/80">Semua →</a>
        </div>
      </div>
      <p class="mb-3 text-[10px] leading-relaxed text-white/30">
        Skuad terakhir yang terdaftar di Liga Nusantara 2025-26. Pendaftaran 2026-27 belum dibuka.
      </p>
      <PlayerTable rows={squad} />
    </section>

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-white/10 pt-6">
      <a href="/tim/profil" class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary hover:text-primary/80">Profil tim →</a>
      <a href="/tim/berita" class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary hover:text-primary/80">Berita →</a>
      <a href="/pertandingan" class="text-[10px] font-bold uppercase tracking-[0.18em] text-white/40 hover:text-white/70">Jadwal lengkap</a>
      <p class="ml-auto text-[10px] uppercase tracking-[0.16em] text-white/25">
        Tidak berafiliasi dengan manajemen resmi PERSIBO Bojonegoro
      </p>
    </div>
  </div>
</Layout>
