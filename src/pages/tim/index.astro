---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Tim', href: '/tim' }
];
---

<Layout 
  title="Tim PERSIBO Bojonegoro (Unofficial)"
  description="Informasi lengkap tentang tim PERSIBO Bojonegoro. Profil tim, official, berita, dan galeri. Website Unofficial."
>
  <div class="max-w-7xl mx-auto px-4 lg:px-6 py-4 lg:py-6">
    <Breadcrumb items={breadcrumbItems} />
    
    <!-- Intro Text -->
    <section class="mb-6 lg:mb-8">
      <div class="rounded-xl bg-slate-800/50 p-6 lg:p-8 border border-slate-700">
        <h1 class="text-2xl lg:text-3xl font-extrabold text-white mb-3 lg:mb-4">Tim PERSIBO Bojonegoro</h1>
        <p class="text-slate-300 leading-relaxed text-sm lg:text-base">
          Jelajahi informasi lengkap tentang <strong class="text-white">PERSIBO Bojonegoro</strong>. Dari profil tim yang mencakup sejarah, visi misi, dan prestasi, hingga daftar official dan staff yang mengelola tim. Akses juga berita terbaru dan galeri foto tim.
        </p>
      </div>
    </section>
    
    <div class="mb-6 lg:mb-8">
      <h2 class="text-xl lg:text-2xl font-extrabold text-white mb-2">Menu</h2>
      <p class="text-slate-400 text-sm lg:text-base">Pilih menu di bawah untuk melihat informasi lebih detail</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-6">
      <!-- Profil Tim -->
      <a href="/tim/profil" class="group">
        <div class="rounded-xl bg-gradient-to-br from-primary/20 to-accent-purple/20 p-6 border border-primary/30 hover:border-primary/50 transition-all hover:shadow-lg hover:shadow-primary/20">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-14 h-14 rounded-full bg-primary/20 flex items-center justify-center group-hover:bg-primary/30 transition-colors">
              <span class="material-symbols-outlined text-3xl text-primary">info</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-white mb-1">Profil Tim</h2>
              <p class="text-slate-400 text-sm">Sejarah, visi misi, dan prestasi</p>
            </div>
          </div>
          <p class="text-slate-300 text-sm">Pelajari lebih lanjut tentang sejarah dan perjalanan PERSIBO Bojonegoro dari masa ke masa.</p>
        </div>
      </a>

      <!-- Official -->
      <a href="/tim/official" class="group">
        <div class="rounded-xl bg-gradient-to-br from-accent-teal/20 to-primary/20 p-6 border border-accent-teal/30 hover:border-accent-teal/50 transition-all hover:shadow-lg hover:shadow-accent-teal/20">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-14 h-14 rounded-full bg-accent-teal/20 flex items-center justify-center group-hover:bg-accent-teal/30 transition-colors">
              <span class="material-symbols-outlined text-3xl text-accent-teal">groups</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-white mb-1">Official & Staff</h2>
              <p class="text-slate-400 text-sm">Pelatih, manajer, dan staff</p>
            </div>
          </div>
          <p class="text-slate-300 text-sm">Lihat daftar lengkap official dan staff yang mengelola tim PERSIBO Bojonegoro.</p>
        </div>
      </a>

      <!-- Berita -->
      <a href="/tim/berita" class="group">
        <div class="rounded-xl bg-gradient-to-br from-accent-purple/20 to-primary/20 p-6 border border-accent-purple/30 hover:border-accent-purple/50 transition-all hover:shadow-lg hover:shadow-accent-purple/20">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-14 h-14 rounded-full bg-accent-purple/20 flex items-center justify-center group-hover:bg-accent-purple/30 transition-colors">
              <span class="material-symbols-outlined text-3xl text-accent-purple">newspaper</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-white mb-1">Berita</h2>
              <p class="text-slate-400 text-sm">Artikel dan update terbaru</p>
            </div>
          </div>
          <p class="text-slate-300 text-sm">Baca berita terbaru tentang PERSIBO Bojonegoro dan perkembangan tim.</p>
        </div>
      </a>

      <!-- Galeri -->
      <a href="/tim/galeri" class="group">
        <div class="rounded-xl bg-slate-800/50 p-6 border border-slate-700 hover:border-slate-600 transition-all opacity-60">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-14 h-14 rounded-full bg-slate-700/50 flex items-center justify-center">
              <span class="material-symbols-outlined text-3xl text-slate-500">photo_library</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-slate-400 mb-1">Galeri</h2>
              <p class="text-slate-600 text-sm">Foto-foto tim dan pertandingan</p>
            </div>
          </div>
          <div class="flex items-center gap-2 text-slate-500 text-sm">
            <span class="material-symbols-outlined text-base">construction</span>
            <span>Dalam perbaikan</span>
          </div>
        </div>
      </a>
    </div>

    <!-- Credit & Disclaimer -->
    <div class="mt-8 lg:mt-12 mb-4 space-y-4">
      <!-- Credit -->
      <div class="rounded-xl bg-slate-800/50 p-6 border border-slate-700">
        <p class="text-sm text-slate-400 text-center">
          <span class="font-medium text-slate-300">Jengker</span> Proudly Present <span class="font-medium text-slate-300">Persibo v2</span>
        </p>
      </div>
      
      <!-- Disclaimer Card -->
      <div class="rounded-lg bg-slate-800/30 p-4 border border-slate-700/50">
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 mt-0.5">
            <span class="material-symbols-outlined text-slate-500 text-lg">info</span>
          </div>
          <div class="flex-1">
            <p class="text-xs text-slate-400 leading-relaxed">
              <span class="font-medium text-slate-300">Website Unofficial</span> – Website ini tidak berafiliasi dengan manajemen resmi PERSIBO Bojonegoro. Semua informasi disediakan untuk tujuan informatif semata.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
