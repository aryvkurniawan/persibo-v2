---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Galeri PERSIBO Bojonegoro (Unofficial)"
  description="Galeri foto PERSIBO Bojonegoro: foto tim, pertandingan, dan momen-momen penting. Website Unofficial."
>
  <div class="max-w-7xl mx-auto px-4 lg:px-6 py-4 lg:py-6">
    <div class="flex items-center gap-3 mb-6 lg:mb-8">
      <a href="/tim" class="text-slate-400 hover:text-white transition-colors">
        <span class="material-symbols-outlined text-2xl">arrow_back</span>
      </a>
      <h1 class="text-2xl lg:text-3xl font-extrabold text-white">Galeri</h1>
    </div>

    <div class="rounded-xl bg-slate-800/50 p-8 lg:p-12 text-center">
      <div class="mb-6">
        <span class="material-symbols-outlined text-6xl text-slate-500 mb-4 inline-block">construction</span>
        <h2 class="text-xl font-bold text-slate-400 mb-2">Halaman Sedang Dalam Perbaikan</h2>
        <p class="text-slate-400 text-sm">Fitur galeri akan segera hadir dengan koleksi foto tim, pertandingan, dan momen-momen penting PERSIBO Bojonegoro.</p>
      </div>
      <a href="/tim" class="inline-flex items-center gap-2 text-primary hover:text-primary/80 transition-colors">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>Kembali ke Menu Tim</span>
      </a>
    </div>
  </div>
</Layout>
