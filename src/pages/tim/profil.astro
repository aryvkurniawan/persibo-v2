  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Kapan PERSIBO Bojonegoro didirikan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PERSIBO Bojonegoro didirikan pada 12 Maret 1949 atas prakarsa Raden Temenggung Sukardi yang saat itu menjabat sebagai Bupati Bojonegoro."
      }
    },
    {
      "@type": "Question",
      "name": "Apa julukan PERSIBO Bojonegoro?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "PERSIBO Bojonegoro dikenal dengan julukan Laskar Angling Dharma dan pernah mendapat reputasi sebagai The Giant Killer."
      }
    },
    {
      "@type": "Question",
      "name": "Apa prestasi tertinggi PERSIBO Bojonegoro?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Prestasi tertinggi PERSIBO Bojonegoro adalah Juara Piala Indonesia 2012, yang membawa mereka mewakili Indonesia di AFC Cup 2013."
      }
    },
    {
      "@type": "Question",
      "name": "Di kompetisi apa PERSIBO Bojonegoro bermain saat ini?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Saat ini (Desember 2025), PERSIBO Bojonegoro berlaga di Liga 3 (Liga Nusantara) 2025-26 di Grup C dengan target promosi kembali ke Liga 2."
      }
    }
  ]
})} />
