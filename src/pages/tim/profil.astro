---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHeader from '../../components/PageHeader.astro';

const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Tim', href: '/tim' },
  { label: 'Profil Tim', href: '/tim/profil' }
];

const achievements = [
  { title: 'Juara Piala Indonesia', year: '2012 · prestasi tertinggi' },
  { title: 'Partisipasi AFC Cup', year: '2013 · mewakili Indonesia' },
  { title: 'Juara Divisi Utama', year: '2009/2010 · promosi ke ISL' },
  { title: 'Juara Divisi Satu', year: '2007' },
  { title: 'Juara Divisi Dua', year: '2004' },
  { title: 'Juara Liga 3 Jawa Timur', year: '2023/2024' },
  { title: 'Runner-up Liga 3 Nasional', year: '2023/2024 · promosi ke Liga 2' },
];

const faqs = [
  {
    q: 'Kapan PERSIBO Bojonegoro didirikan?',
    a: 'PERSIBO Bojonegoro didirikan pada 12 Maret 1949 atas prakarsa Raden Temenggung Sukardi yang saat itu menjabat sebagai Bupati Bojonegoro.',
  },
  {
    q: 'Apa julukan PERSIBO Bojonegoro?',
    a: 'PERSIBO Bojonegoro dikenal dengan julukan Laskar Angling Dharma dan pernah mendapat reputasi sebagai The Giant Killer setelah menumbangkan tim-tim besar di ajang Copa Indonesia.',
  },
  {
    q: 'Apa prestasi tertinggi PERSIBO Bojonegoro?',
    a: 'Prestasi tertinggi PERSIBO Bojonegoro adalah Juara Piala Indonesia 2012, yang membawa mereka mewakili Indonesia di AFC Cup 2013.',
  },
  {
    q: 'Di kompetisi apa PERSIBO Bojonegoro bermain saat ini?',
    a: 'Musim 2026-27, PERSIBO Bojonegoro berlaga di Liga Nusantara Grup B dengan target promosi kembali ke Liga 2.',
  },
  {
    q: 'Apakah website ini website resmi PERSIBO Bojonegoro?',
    a: 'Tidak. Situs ini dikelola penggemar untuk menyediakan informasi tentang PERSIBO Bojonegoro, dan tidak berafiliasi dengan manajemen resmi klub.',
  },
];
---

<Layout
  title="Profil Tim PERSIBO Bojonegoro (Unofficial)"
  description="Profil lengkap PERSIBO Bojonegoro: sejarah, visi misi, dan daftar prestasi tim sepak bola kebanggaan Bojonegoro."
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <Breadcrumb items={breadcrumbItems} />

    <PageHeader
      label="Didirikan 12 Maret 1949"
      title="Profil Tim"
      meta="Laskar Angling Dharma"
      description="Sejarah, visi misi, dan prestasi PERSIBO Bojonegoro — klub kebanggaan Bojonegoro, Jawa Timur."
    />

    <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_0.55fr] lg:gap-10">
      <div class="space-y-8">
        <!-- Sejarah -->
        <section>
          <div class="mb-3 border-b border-white/15 pb-3">
            <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Sejarah</h2>
          </div>
          <div class="space-y-4 text-sm leading-relaxed text-white/55">
            <p>
              Persibo Bojonegoro didirikan pada <strong class="text-white">12 Maret 1949</strong> atas prakarsa Raden Temenggung Sukardi, Bupati Bojonegoro saat itu. Sempat vakum pada 1960, klub bangkit pada milenium baru dan menanjak dari Divisi Dua.
            </p>
            <p>
              Persibo dikenal sebagai <strong class="text-primary">Laskar Angling Dharma</strong> dan sempat dijuluki <em class="text-accent-teal">"The Giant Killer"</em> setelah menumbangkan Arema, Persik, dan Pelita Jaya di Copa Indonesia.
            </p>
            <div class="border-l-2 border-primary bg-white/[0.02] px-4 py-3">
              <p>
                Masa keemasan terjadi pada 2010–2012: juara Divisi Utama 2009/2010, puncaknya <strong class="text-primary">Juara Piala Indonesia 2012</strong>, lalu mewakili Indonesia di <strong class="text-accent-teal">AFC Cup 2013</strong>.
              </p>
            </div>
          </div>
        </section>

        <!-- Perjalanan terkini -->
        <section>
          <div class="mb-3 border-b border-white/15 pb-3">
            <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Perjalanan Terkini</h2>
          </div>
          <div class="divide-y divide-white/5 border border-white/12 bg-[#0c0b0f]">
            {[
              { year: '2023/24', text: 'Promosi ke Liga 2 setelah menjadi runner-up Liga 3 Nasional.' },
              { year: '2024/25', text: 'Berlaga di Liga 2, sempat memimpin Grup 3, lalu kalah 1-2 dari Persipura di play-off degradasi.' },
              { year: '2025/26', text: 'Kembali ke Liga Nusantara dengan target promosi.' },
              { year: '2026/27', text: 'Musim aktif. Liga Nusantara Grup B.' },
            ].map((row) => (
              <div class="flex items-start gap-4 px-4 py-3">
                <span class="w-16 shrink-0 font-cond text-lg font-bold leading-none text-primary tnum">{row.year}</span>
                <p class="text-sm leading-relaxed text-white/60">{row.text}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- Visi Misi -->
        <section>
          <div class="mb-3 border-b border-white/15 pb-3">
            <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Visi & Misi</h2>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="border border-white/12 bg-[#0c0b0f] p-4">
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">Visi</p>
              <p class="mt-2 text-sm leading-relaxed text-white/60">
                Mengembalikan kejayaan Persibo sebagai klub profesional yang disegani di kasta tertinggi sepak bola Indonesia dan kebanggaan masyarakat Bojonegoro.
              </p>
            </div>
            <div class="border border-white/12 bg-[#0c0b0f] p-4">
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-accent-teal">Misi</p>
              <ul class="mt-2 space-y-2 text-sm leading-relaxed text-white/60">
                <li>Promosi ke Liga 2 secepatnya.</li>
                <li>Tata kelola klub yang transparan dan profesional.</li>
                <li>Sinergi manajemen, Boromania, dan pemerintah daerah.</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- FAQ -->
        <section>
          <div class="mb-3 border-b border-white/15 pb-3">
            <h2 class="font-cond text-2xl font-bold uppercase leading-none tracking-wide text-white">Pertanyaan Umum</h2>
          </div>
          <div class="divide-y divide-white/5 border border-white/12 bg-[#0c0b0f]">
            {faqs.map((faq) => (
              <div class="px-4 py-3">
                <h3 class="text-sm font-semibold text-white">{faq.q}</h3>
                <p class="mt-1 text-sm leading-relaxed text-white/50">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>
      </div>

      <aside class="space-y-6">
        <div class="border border-white/12 bg-[#0c0b0f] p-5">
          <div class="flex items-center gap-3">
            <img src="/logo-64.png" alt="Logo PERSIBO Bojonegoro" class="h-14 w-14 object-contain" width="56" height="56" />
            <div>
              <p class="font-cond text-2xl font-bold uppercase leading-none text-white">PERSIBO</p>
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary">Bojonegoro</p>
            </div>
          </div>
          <div class="mt-4 space-y-2 border-t border-white/10 pt-4 text-[10px] uppercase tracking-[0.14em] text-white/40">
            <p>Julukan · Laskar Angling Dharma</p>
            <p>Berdiri · 12 Maret 1949</p>
            <p>Stadion · Letjen Haji Sudirman</p>
            <p>Kompetisi · Liga Nusantara 2026-27</p>
            <p>Suporter · Boromania</p>
          </div>
        </div>

        <div class="border border-white/12 bg-[#0c0b0f]">
          <p class="border-b border-white/10 px-4 py-3 text-[11px] font-bold uppercase tracking-[0.18em] text-primary">Prestasi</p>
          <ul class="divide-y divide-white/5">
            {achievements.map((item) => (
              <li class="px-4 py-2.5">
                <p class="text-[13px] font-medium text-white/85">{item.title}</p>
                <p class="mt-0.5 text-[11px] uppercase tracking-[0.14em] text-white/30">{item.year}</p>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SportsTeam",
  "name": "PERSIBO Bojonegoro",
  "alternateName": "Laskar Angling Dharma",
  "foundingDate": "1949-03-12",
  "sport": "Soccer",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "JL. UNTUNG SUROPATI NO. 39",
    "addressLocality": "Bojonegoro",
    "addressRegion": "Jawa Timur",
    "postalCode": "62115",
    "addressCountry": "ID"
  },
  "memberOf": {
    "@type": "SportsOrganization",
    "name": "Liga Nusantara"
  }
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
})} />
