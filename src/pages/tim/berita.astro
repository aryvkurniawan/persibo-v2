---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MatchPreviewPanel from '../../components/MatchPreviewPanel.astro';

const siteUrl = (Astro.site || Astro.url.origin).toString().replace(/\/+$/, '');

const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Tim', href: '/tim' },
  { label: 'Berita', href: '/tim/berita' }
];

const articles = [
  {
    href: '/tim/berita/persibo-tundukkan-persitara-2-0-uji-coba',
    tag: 'Uji Coba',
    date: '25 Oktober 2026',
    datePublished: '2026-10-25',
    title: 'Persibo Tundukkan Persitara 2-0 di Laga Uji Coba Perdana di Stadion Letjen H. Soedirman',
    excerpt: 'Dua gol Sehabudin Ahmad dan Putra Chaniago membawa Persibo Bojonegoro menang 2-0 atas Persitara Jakarta Utara di laga uji coba jelang Liga Nusantara 2026-27.',
    image: '/img/persibo-persitara.jpg',
  },
  {
    href: '/tim/berita/persibo-lawan-persika-karanganyar-jumat-12-desember',
    tag: 'Laga',
    date: '8 Desember 2025',
    datePublished: '2025-12-08',
    title: 'Persibo Bojonegoro Lawan Persika Karanganyar Jumat 12 Desember',
    excerpt: 'Persibo Bojonegoro akan melanjutkan petualangannya di Liga 3 Nusantara 2025-2026 dengan menghadapi Persika Karanganyar pada Jumat, 12 Desember 2025 sore.',
    // No photo of this match exists - the article was written before it was
    // played. Show the fixture itself rather than borrowing another match's photo.
    preview: { home: 'Persibo', away: 'Persika', date: '12 Des 2025', venue: 'UNS' },
  },
  {
    href: '/tim/berita/bangkit-persibo-raih-kemenangan-perdana-tumbangkan-persikutim',
    tag: 'Hasil',
    date: '4 Desember 2025',
    datePublished: '2025-12-04',
    title: 'Bangkit! Persibo Raih Kemenangan Perdana di Liga 3, Tumbangkan Persikutim 2-1',
    excerpt: 'Persibo Bojonegoro berhasil memetik kemenangan krusial di laga kedua Grup C Liga 3 Nusantara. Laskar Angling Dharma sukses menumbangkan Persikutim United dengan skor akhir 2-1.',
    image: '/img/persibo-persikutam.jpg',
  },
  {
    href: '/tim/berita/pukulan-telak-injury-time-persibo-tumbang-rans',
    tag: 'Hasil',
    date: '29 November 2025',
    datePublished: '2025-11-29',
    title: 'Pukulan Telak di Injury Time, Persibo Tumbang 0-1 dari RANS Nusantara FC',
    excerpt: 'Langkah awal Persibo Bojonegoro di pentas Liga 3 Nusantara 2025-2026 harus ternodai setelah menelan kekalahan pahit 0-1 dari RANS Nusantara FC.',
    image: '/img/persibo-rans.jpg',
  },
  {
    href: '/tim/berita/siap-tempur-solo-launching-skuad-jersey-2025',
    tag: 'Tim',
    date: '25 November 2025',
    datePublished: '2025-11-25',
    title: 'Siap Tempur di Solo! Persibo Resmi Luncurkan Skuad dan Jersey Anyar',
    excerpt: 'Persibo Bojonegoro resmi memperkenalkan komposisi skuad dan jubah perang terbaru untuk mengarungi Liga 3 Nusantara musim 2025-2026 di Hotel Eastern, Bojonegoro.',
    image: '/img/persibo-persikutam.jpg',
    video: true,
  },
  {
    href: '/tim/berita/drama-penalti-degradasi-liga-2',
    tag: 'Liga 2',
    date: '28 Februari 2025',
    datePublished: '2025-02-28',
    title: 'Drama Penalti Menit Akhir: Kilas Balik Persibo Terdegradasi ke Liga 3',
    excerpt: 'Perjalanan Laskar Angling Dharma harus menemui jalan terjal pada awal tahun ini. Persibo Bojonegoro harus menelan pil pahit terdegradasi dari Liga 2.',
    image: '/img/drama-pinalti.jpg',
  },
];
---

<Layout
  title="Berita PERSIBO Bojonegoro (Unofficial)"
  description="Berita terbaru tentang PERSIBO Bojonegoro. Update terkini tentang tim, pertandingan, dan perkembangan Laskar Angling Dharma di Liga Nusantara 2025-2026."
>
  <div class="mx-auto max-w-7xl px-4 py-8 lg:px-6 lg:py-12">
    <Breadcrumb items={breadcrumbItems} />

    <PageHeader
      label="Dari ruang ganti"
      title="Berita"
      meta={`${articles.length} artikel`}
      description="Kabar terbaru PERSIBO Bojonegoro di Liga Nusantara."
    />

    <div class="mt-8 grid gap-3 md:grid-cols-2 lg:gap-4">
      {articles.map((article) => (
        <a href={article.href} class="group flex flex-col border border-white/12 bg-[#0c0b0f] transition-colors hover:border-primary/50">
          <div class="relative aspect-[16/9] w-full overflow-hidden bg-[#161318]">
            {article.video ? (
              <>
                <video class="h-full w-full object-cover opacity-85" muted playsinline preload="metadata">
                  <source src="/video/launching-2025.mp4#t=0.5" type="video/mp4" />
                </video>
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="material-symbols-outlined text-5xl text-white/80">play_circle</span>
                </div>
              </>
            ) : article.preview ? (
              <MatchPreviewPanel
                home={article.preview.home}
                away={article.preview.away}
                homeCrest="/logo-64.png"
                awayCrest="/img/teams/persika-karanganyar.png"
                date={article.preview.date}
                venue={article.preview.venue}
                competition="Liga Nusantara"
              />
            ) : (
              <img
                src={article.image}
                alt=""
                class="h-full w-full object-cover opacity-85 transition-opacity group-hover:opacity-100"
                loading="lazy"
                width="800"
                height="450"
              />
            )}
            <span class="absolute left-0 top-0 bg-primary px-1.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[#08070a]">
              {article.tag}
            </span>
          </div>

          <div class="flex flex-1 flex-col p-4">
            <span class="text-[11px] font-bold uppercase tracking-[0.16em] text-white/35">{article.date}</span>
            <h2 class="mt-1.5 font-cond text-xl font-semibold uppercase leading-[1.02] text-white transition-colors group-hover:text-primary sm:text-2xl">
              {article.title}
            </h2>
            <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-white/45">{article.excerpt}</p>
            <p class="mt-auto pt-3 text-[11px] font-bold uppercase tracking-[0.18em] text-primary">
              Baca selengkapnya <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
            </p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Berita PERSIBO Bojonegoro",
  "description": "Berita terbaru tentang PERSIBO Bojonegoro",
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": articles.map((article, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "NewsArticle",
        "headline": article.title,
        "datePublished": article.datePublished,
        "image": `${siteUrl}${article.image}`
      }
    }))
  }
})} />
