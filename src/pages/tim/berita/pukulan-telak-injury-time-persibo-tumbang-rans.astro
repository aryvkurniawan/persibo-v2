---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import { optimizeImage } from '../../../utils/imageOptimizer';

const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Tim', href: '/tim' },
  { label: 'Berita', href: '/tim/berita' },
  { label: 'Pukulan Telak di Injury Time, Persibo Tumbang 0-1 dari RANS', href: '/tim/berita/pukulan-telak-injury-time-persibo-tumbang-rans' }
];

const publishedDate = '2025-11-29T00:00:00+07:00';
const modifiedDate = '2025-11-29T00:00:00+07:00';
const author = 'persibo.com';
const authorUrl = 'https://persibo.com';
---

<Layout 
  title="Pukulan Telak di Injury Time, Persibo Tumbang 0-1 dari RANS Nusantara FC di Laga Perdana - PERSIBO Bojonegoro (Unofficial)"
  description="Langkah awal Persibo Bojonegoro di Liga 3 Nusantara 2025-2026 harus ternodai setelah menelan kekalahan pahit 0-1 dari RANS Nusantara FC. Gol dramatis di menit ke-94 menjadi pembeda. Website Unofficial."
  ogImage="/img/persibo-rans.jpg"
>
  <div class="px-4 lg:px-6 py-4 lg:py-6 max-w-4xl mx-auto">
    <Breadcrumb items={breadcrumbItems} />
    
    <!-- Back Button -->
    <div class="mb-4">
      <a href="/tim/berita" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors py-2 px-3 rounded-lg hover:bg-slate-800/50">
        <span class="material-symbols-outlined text-xl">arrow_back</span>
        <span class="text-sm font-medium">Kembali ke Berita</span>
      </a>
    </div>

    <!-- Article Header -->
    <article class="mb-8">
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-4 flex-wrap">
          <span class="text-xs font-medium text-primary bg-primary/20 px-3 py-1 rounded-full">Liga 3 Nusantara</span>
          <span class="text-xs text-slate-400">29 November 2025</span>
          <span class="text-xs text-slate-500">•</span>
          <span class="text-xs text-slate-400">persibo.com</span>
        </div>
        
        <h1 class="text-2xl md:text-3xl font-extrabold text-white mb-4 leading-tight">
          Pukulan Telak di Injury Time, Persibo Tumbang 0-1 dari RANS Nusantara FC di Laga Perdana
        </h1>
        
        <div class="flex items-center gap-3 text-sm text-slate-400 mb-4">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-base">location_on</span>
            <span>SOLO</span>
          </div>
          <span class="text-slate-500">•</span>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-base">stadium</span>
            <span>Stadion Sriwedari</span>
          </div>
        </div>
        
        <!-- Share Buttons -->
        <div class="mb-6 pt-4 border-t border-slate-700">
          <ShareButtons 
            title="Pukulan Telak di Injury Time, Persibo Tumbang 0-1 dari RANS Nusantara FC di Laga Perdana"
            description="Langkah awal Persibo Bojonegoro di Liga 3 Nusantara 2025-2026 harus ternodai setelah menelan kekalahan pahit 0-1 dari RANS Nusantara FC. Gol dramatis di menit ke-94 menjadi pembeda."
            type="article"
          />
        </div>
      </div>

      <!-- Featured Image -->
      <div class="mb-6 rounded-xl overflow-hidden">
        <img 
          src={optimizeImage('/img/persibo-rans.jpg', { width: 1200, height: 675, quality: 75, format: 'webp', fit: 'cover' }, Astro.site || Astro.url.origin)} 
          alt="Pertandingan Persibo Bojonegoro vs RANS Nusantara FC di Stadion Sriwedari, Solo" 
          class="w-full h-auto object-cover"
          loading="lazy"
          width="800"
          height="450"
        />
        <p class="text-xs text-slate-400 mt-2 text-center">Foto: Laga perdana Persibo Bojonegoro melawan RANS Nusantara FC di Liga 3 Nusantara 2025-2026</p>
      </div>

      <!-- Article Content -->
      <div class="prose prose-invert prose-slate max-w-none">
        <div class="space-y-4 text-slate-300 leading-relaxed">
          <p class="text-lg font-medium text-white">
            <strong>SOLO, persibo.com</strong> – Langkah awal Persibo Bojonegoro di pentas Liga 3 Nusantara 2025-2026 harus ternodai setelah menelan kekalahan pahit <strong class="text-primary">0-1</strong> dari <strong class="text-white">RANS Nusantara FC</strong>. Dalam laga perdana yang digelar di <strong class="text-white">Stadion Sriwedari, Solo</strong>, pada <strong class="text-primary">Sabtu (29/11/2025)</strong>, gol dramatis di penghujung laga menjadi pembeda.
          </p>

          <p>
            Petaka bagi Laskar Angling Dharma datang pada masa <em>injury time</em>, tepatnya di <strong class="text-white">menit ke-94</strong>. Saat pertandingan seolah akan berakhir imbang tanpa gol, sebuah tendangan keras dari pemain RANS Nusantara, <strong class="text-primary">Sultan Akbar</strong>, tak mampu dihalau dan sukses menggetarkan jala gawang Persibo. Gol tersebut seketika membuyarkan asa Laskar Angling Dharma untuk mengamankan setidaknya satu poin di laga pembuka yang krusial ini.
          </p>

          <div class="bg-slate-800/50 border-l-4 border-primary rounded-lg p-4 my-6">
            <p class="text-slate-200">
              <strong class="text-white">Gol di Menit Ke-94</strong><br/>
              Tendangan keras dari <strong class="text-primary">Sultan Akbar</strong> di masa injury time menjadi gol tunggal yang menentukan nasib pertandingan. Persibo harus menelan kekalahan pahit di laga perdana mereka.
            </p>
          </div>

          <p>
            Sepanjang <strong class="text-white">90 menit waktu normal</strong>, kedua tim sebenarnya menampilkan permainan yang cukup berimbang. Baik Persibo maupun RANS sama-sama bermain disiplin dan sempat menciptakan beberapa peluang, namun pertahanan solid dari kedua kubu membuat skor kacamata <strong class="text-primary">0-0</strong> bertahan hingga turun minum dan hampir sepanjang babak kedua.
          </p>

          <p>
            Sayangnya, <strong class="text-white">kelengahan di detik-detik akhir</strong> harus dibayar mahal. RANS Nusantara berhasil memanfaatkan satu peluang emas mereka menjadi gol kemenangan, meninggalkan kekecewaan mendalam bagi para pemain dan suporter Persibo yang hadir di stadion.
          </p>

          <h2 class="text-xl font-bold text-white mt-8 mb-4">Pelajaran Berharga untuk Laga Berikutnya</h2>

          <p>
            Meskipun hasil ini menjadi awal yang kurang ideal, kekalahan ini menjadi <strong class="text-primary">pelajaran berharga</strong> bagi skuad Persibo. Tim dituntut untuk segera bangkit, melupakan hasil pahit ini, dan mengalihkan fokus penuh ke laga berikutnya demi menjaga asa lolos dari fase grup.
          </p>

          <p>
            Dengan semangat <strong class="text-white">"Hujan turun, tapi langkah tak mundur"</strong>, Laskar Angling Dharma harus segera move on dan mempersiapkan diri sebaik mungkin untuk pertandingan selanjutnya. Setiap poin di fase grup sangat berharga untuk mencapai target promosi kembali ke Liga 2.
          </p>

          <!-- Match Summary Box -->
          <div class="bg-gradient-to-r from-slate-800/50 to-slate-900/50 rounded-lg p-6 border border-slate-700 my-6">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <span class="material-symbols-outlined text-primary">sports_soccer</span>
              Ringkasan Pertandingan
            </h3>
            <div class="grid grid-cols-2 gap-4 text-sm">
              <div>
                <p class="text-slate-400 mb-1">Tanggal</p>
                <p class="text-white font-medium">29 November 2025</p>
              </div>
              <div>
                <p class="text-slate-400 mb-1">Venue</p>
                <p class="text-white font-medium">Stadion Sriwedari, Solo</p>
              </div>
              <div>
                <p class="text-slate-400 mb-1">Skor</p>
                <p class="text-white font-bold text-lg">0 - 1</p>
              </div>
              <div>
                <p class="text-slate-400 mb-1">Pencetak Gol</p>
                <p class="text-white font-medium">Sultan Akbar (94')</p>
              </div>
            </div>
          </div>

          <!-- Sources -->
          <div class="border-t border-slate-700 pt-6 mt-8">
            <h3 class="text-lg font-bold text-white mb-3">Sumber:</h3>
            <ul class="space-y-2 text-sm text-slate-400">
              <li>
                <span class="text-slate-500">[1]</span>{' '}
                <a href="https://www.metrotvnews.com/play/kj2CDg7x-rans-nusantara-fc-petik-kemenangan-tipis-1-0-atas-persibo-bojonegoro" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary/80 underline">
                  Metro TV News - RANS Nusantara FC Petik Kemenangan Tipis 1-0 Atas Persibo Bojonegoro
                </a>
              </li>
              <li>
                <span class="text-slate-500">[2]</span>{' '}
                <a href="https://www.youtube.com/watch?v=jMqayNvPy-Y" target="_blank" rel="noopener noreferrer" class="text-primary hover:text-primary/80 underline">
                  YouTube - Dokumentasi Pertandingan
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </article>

    <!-- Related Articles / Back to News -->
    <div class="mt-8 pt-6 border-t border-slate-700">
      <a href="/tim/berita" class="inline-flex items-center gap-2 text-primary hover:text-primary/80 font-medium">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>Kembali ke Daftar Berita</span>
      </a>
    </div>
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": "Pukulan Telak di Injury Time, Persibo Tumbang 0-1 dari RANS Nusantara FC di Laga Perdana",
  "image": `${Astro.site || Astro.url.origin}/img/persibo-rans.jpg`,
  "datePublished": publishedDate,
  "dateModified": modifiedDate,
  "author": {
    "@type": "Organization",
    "name": author,
    "url": authorUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "PERSIBO Bojonegoro (Unofficial)",
    "logo": {
      "@type": "ImageObject",
      "url": `${Astro.site || Astro.url.origin}/logo-128.png`
    }
  },
  "description": "Langkah awal Persibo Bojonegoro di Liga 3 Nusantara 2025-2026 harus ternodai setelah menelan kekalahan pahit 0-1 dari RANS Nusantara FC. Gol dramatis di menit ke-94 menjadi pembeda.",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${Astro.site || Astro.url.origin}/tim/berita/pukulan-telak-injury-time-persibo-tumbang-rans`
  }
})} />
