---
import type { GetStaticPaths } from 'astro';
import '../../../styles/global.css';

// Poster hanya perlu ada saat dev untuk di-screenshot. Di build produksi
// route ini sengaja dikosongkan supaya tidak masuk dist/ dan sitemap.
export const getStaticPaths: GetStaticPaths = () =>
  import.meta.env.DEV ? [{ params: { slide: 'gresik' } }] : [];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Poster prediksi Persibo vs Gresik United — PERSIBO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Lexend:wght@400;500;600;700;800&display=swap"
    />
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        background: #0b0910;
      }
    </style>
  </head>
  <body>
    <!-- SLIDE 1: prediksi skor -->
    <section
      id="slide-1"
      class="relative overflow-hidden bg-[#0b0910] text-[#f5f2ec]"
      style="width:1080px;height:1350px;font-family:'Lexend',sans-serif"
    >
      <div
        class="pointer-events-none absolute inset-0"
        style="background:radial-gradient(circle at 82% 6%, rgba(249,115,22,0.16), transparent 46%)"
      >
      </div>

      <div class="relative flex h-full flex-col px-[3rem] py-[2.8rem]">
        <div class="flex items-center justify-between text-[22px] font-bold uppercase tracking-[0.26em]">
          <p class="flex items-center gap-[0.6rem] text-white/55">
            <span class="inline-block h-[0.5rem] w-[0.5rem] bg-primary"></span>
            Liga Nusantara 2026-27
          </p>
          <p class="text-white/35">Prediksi · Grup B</p>
        </div>
        <div class="mt-[0.9rem] h-px w-full bg-white/15"></div>

        <div class="mt-[1.6rem] border border-white/12 bg-[#0c0b0f] px-[2rem] py-[1.6rem]">
          <div class="flex items-start justify-between gap-[1rem]">
            <div>
              <p class="flex items-center gap-[0.7rem] text-[22px] font-bold uppercase tracking-[0.28em] text-white/45">
                <span class="inline-block h-px w-[1.6rem] bg-primary"></span>
                Matchday 3 · Minggu
              </p>
              <div class="mt-[0.8rem] flex items-end gap-[1.1rem]">
                <p class="font-cond text-[11rem] font-bold leading-[0.66] text-primary">22</p>
                <div class="pb-[0.5rem]">
                  <p class="font-cond text-[4.2rem] font-semibold uppercase leading-none">Nov</p>
                  <p class="mt-[0.3rem] text-[22px] font-semibold tracking-[0.3em] text-white/45">2026</p>
                </div>
              </div>
            </div>
            <div class="shrink-0 border-l border-white/15 pl-[1.3rem] text-right">
              <p class="text-[21px] uppercase tracking-[0.24em] text-white/40">Kick-off</p>
              <p class="font-cond mt-[0.3rem] text-[4.4rem] font-semibold leading-none">15.30</p>
              <p class="mt-[0.25rem] text-[22px] uppercase tracking-[0.2em] text-white/40">WIB</p>
              <p class="mt-[0.9rem] text-[21px] uppercase tracking-[0.24em] text-white/40">Stadion</p>
              <p class="mt-[0.3rem] max-w-[15rem] text-[22px] font-semibold uppercase leading-[1.35] tracking-[0.06em] text-white/80">
                Letjen H. Soedirman
              </p>
            </div>
          </div>
        </div>

        <div class="mt-[1.6rem] grid grid-cols-[1fr_auto_1fr] items-center gap-[1rem] border-y border-white/15 py-[1.6rem]">
          <div class="flex flex-col items-start gap-[0.6rem]">
            <img src="/logo.png" alt="" class="h-[8.5rem] w-[8.5rem] object-contain" />
            <p class="font-cond text-[3.6rem] font-bold uppercase leading-none">Persibo</p>
          </div>
          <div class="flex flex-col items-center">
            <p class="font-cond text-[5rem] leading-none text-white/25">VS</p>
            <p class="mt-[0.4rem] text-[21px] uppercase tracking-[0.2em] text-white/40">Kandang</p>
          </div>
          <div class="flex flex-col items-end gap-[0.6rem] text-right">
            <img src="/img/teams/gresik-united-fc.png" alt="" class="h-[8.5rem] w-[8.5rem] object-contain" />
            <p class="font-cond text-[3.6rem] font-bold uppercase leading-none">Gresik Utd</p>
          </div>
        </div>

        <div class="mt-[1.6rem] flex flex-col items-center">
          <p class="text-[22px] font-bold uppercase tracking-[0.3em] text-white/45">Prediksi skor</p>
          <p class="font-cond mt-[0.3rem] text-[12rem] font-bold leading-none text-primary">1 : 0</p>
          <p class="mt-[0.5rem] font-cond text-[3.2rem] font-bold uppercase tracking-[0.08em] text-white">
            Persibo menang
          </p>
          <p class="mt-[0.5rem] text-[22px] uppercase tracking-[0.18em] text-white/40">
            Alternatif: 1-1 · 2-0
          </p>
        </div>

        <p class="mt-auto pt-[1.2rem] text-center text-[20px] uppercase tracking-[0.12em] text-white/35">
          Analisis berdasarkan dua laga pertama, bukan hasil pertandingan
        </p>

        <div class="mt-[1.4rem] flex items-center justify-between bg-primary px-[1.5rem] py-[1.35rem] text-[#08070a]">
          <p class="text-[24px] font-extrabold uppercase tracking-[0.2em]">Jadwal &amp; klasemen lengkap</p>
          <p class="font-cond text-[1.7rem] font-bold uppercase tracking-[0.12em]">persibo.com →</p>
        </div>

        <div class="mt-[1.2rem] flex items-end justify-between">
          <div>
            <p class="font-cond text-[2.6rem] font-bold uppercase leading-none text-white">
              Persibo<span class="text-primary">.</span>
            </p>
            <p class="mt-[0.35rem] text-[21px] uppercase tracking-[0.22em] text-white/35">Laskar Angling Dharma</p>
          </div>
          <p class="text-[20px] uppercase tracking-[0.18em] text-white/25">© 2026 Persibo Bojonegoro</p>
        </div>
      </div>
    </section>

    <!-- SLIDE 2: perbandingan statistik -->
    <section
      id="slide-2"
      class="relative overflow-hidden bg-[#0b0910] text-[#f5f2ec]"
      style="width:1080px;height:1350px;font-family:'Lexend',sans-serif"
    >
      <div
        class="pointer-events-none absolute inset-0"
        style="background:radial-gradient(circle at 82% 6%, rgba(249,115,22,0.16), transparent 46%)"
      >
      </div>

      <div class="relative flex h-full flex-col px-[3rem] py-[2.8rem]">
        <div class="flex items-center justify-between text-[22px] font-bold uppercase tracking-[0.26em]">
          <p class="flex items-center gap-[0.6rem] text-white/55">
            <span class="inline-block h-[0.5rem] w-[0.5rem] bg-primary"></span>
            Liga Nusantara 2026-27
          </p>
          <p class="text-white/35">Prediksi · Grup B</p>
        </div>
        <div class="mt-[0.9rem] h-px w-full bg-white/15"></div>

        <div class="mt-[1.8rem] flex items-end justify-between border-b border-white/15 pb-[1.2rem]">
          <div>
            <p class="text-[22px] font-bold uppercase tracking-[0.28em] text-white/45">Dua laga pertama</p>
            <p class="font-cond mt-[0.4rem] text-[5rem] font-bold uppercase leading-[0.8] text-primary">
              Perbandingan
            </p>
          </div>
          <div class="flex items-center gap-[0.8rem] pb-[0.6rem] text-[21px] font-semibold uppercase tracking-[0.16em]">
            <span class="text-white/85">Persibo</span>
            <span class="text-white/25">vs</span>
            <span class="text-white/85">Gresik</span>
          </div>
        </div>

        <div class="mt-[1.2rem] flex flex-col justify-evenly">
          <div class="border-b border-white/12 py-[1.1rem]">
            <div class="flex items-baseline justify-between gap-[1rem]">
              <p class="font-cond text-[4.6rem] font-bold leading-none text-white">1</p>
              <p class="text-center text-[22px] font-semibold uppercase tracking-[0.14em] text-white/45">Gol</p>
              <p class="font-cond text-[4.6rem] font-bold leading-none text-primary">1</p>
            </div>
            <div class="mt-[0.7rem] flex h-[0.9rem] overflow-hidden rounded-full border border-white/12">
              <div class="bg-white/25" style="width:50%"></div>
              <div class="flex-1 bg-primary/70"></div>
            </div>
          </div>

          <div class="border-b border-white/12 py-[1.1rem]">
            <div class="flex items-baseline justify-between gap-[1rem]">
              <p class="font-cond text-[4.6rem] font-bold leading-none text-white">6</p>
              <p class="text-center text-[22px] font-semibold uppercase tracking-[0.14em] text-white/45">
                Tembakan tepat sasaran
              </p>
              <p class="font-cond text-[4.6rem] font-bold leading-none text-primary">18</p>
            </div>
            <div class="mt-[0.7rem] flex h-[0.9rem] overflow-hidden rounded-full border border-white/12">
              <div class="bg-white/25" style="width:25%"></div>
              <div class="flex-1 bg-primary/70"></div>
            </div>
          </div>

          <div class="border-b border-white/12 py-[1.1rem]">
            <div class="flex items-baseline justify-between gap-[1rem]">
              <p class="font-cond text-[4.6rem] font-bold leading-none text-white">16,7%</p>
              <p class="text-center text-[22px] font-semibold uppercase tracking-[0.14em] text-white/45">Konversi gol</p>
              <p class="font-cond text-[4.6rem] font-bold leading-none text-primary">5,6%</p>
            </div>
            <div class="mt-[0.7rem] flex h-[0.9rem] overflow-hidden rounded-full border border-white/12">
              <div class="bg-white/25" style="width:75%"></div>
              <div class="flex-1 bg-primary/70"></div>
            </div>
          </div>

          <div class="border-b border-white/12 py-[1.1rem]">
            <div class="flex items-baseline justify-between gap-[1rem]">
              <p class="font-cond text-[4.6rem] font-bold leading-none text-white">48%</p>
              <p class="text-center text-[22px] font-semibold uppercase tracking-[0.14em] text-white/45">
                Penguasaan bola rata-rata
              </p>
              <p class="font-cond text-[4.6rem] font-bold leading-none text-primary">55%</p>
            </div>
            <div class="mt-[0.7rem] flex h-[0.9rem] overflow-hidden rounded-full border border-white/12">
              <div class="bg-white/25" style="width:47%"></div>
              <div class="flex-1 bg-primary/70"></div>
            </div>
          </div>
        </div>

        <div class="mt-[1.4rem] border-l-[0.45rem] border-l-primary bg-white/[0.03] px-[1.4rem] py-[1.1rem]">
          <p class="text-[24px] font-medium leading-[1.5] text-white/80">
            Gresik melepas lebih banyak tembakan, tetapi Persibo lebih tajam. Enam tembakan tepat sudah cukup untuk
            satu gol.
          </p>
        </div>

        <p class="mt-auto pt-[1rem] text-center text-[20px] uppercase tracking-[0.12em] text-white/35">
          Analisis berdasarkan dua laga pertama, bukan hasil pertandingan
        </p>

        <div class="mt-[1.3rem] flex items-center justify-between bg-primary px-[1.5rem] py-[1.3rem] text-[#08070a]">
          <p class="text-[24px] font-extrabold uppercase tracking-[0.2em]">Jadwal &amp; klasemen lengkap</p>
          <p class="font-cond text-[1.7rem] font-bold uppercase tracking-[0.12em]">persibo.com →</p>
        </div>

        <div class="mt-[1.1rem] flex items-end justify-between">
          <div>
            <p class="font-cond text-[2.6rem] font-bold uppercase leading-none text-white">
              Persibo<span class="text-primary">.</span>
            </p>
            <p class="mt-[0.35rem] text-[21px] uppercase tracking-[0.22em] text-white/35">Laskar Angling Dharma</p>
          </div>
          <p class="text-[20px] uppercase tracking-[0.18em] text-white/25">© 2026 Persibo Bojonegoro</p>
        </div>
      </div>
    </section>

    <!-- SLIDE 3: kunci kemenangan -->
    <section
      id="slide-3"
      class="relative overflow-hidden bg-[#0b0910] text-[#f5f2ec]"
      style="width:1080px;height:1350px;font-family:'Lexend',sans-serif"
    >
      <div
        class="pointer-events-none absolute inset-0"
        style="background:radial-gradient(circle at 82% 6%, rgba(249,115,22,0.16), transparent 46%)"
      >
      </div>

      <div class="relative flex h-full flex-col px-[3rem] py-[2.8rem]">
        <div class="flex items-center justify-between text-[22px] font-bold uppercase tracking-[0.26em]">
          <p class="flex items-center gap-[0.6rem] text-white/55">
            <span class="inline-block h-[0.5rem] w-[0.5rem] bg-primary"></span>
            Liga Nusantara 2026-27
          </p>
          <p class="text-white/35">Prediksi · Grup B</p>
        </div>
        <div class="mt-[0.9rem] h-px w-full bg-white/15"></div>

        <div class="mt-[1.8rem] border-b border-white/15 pb-[1.2rem]">
          <p class="text-[22px] font-bold uppercase tracking-[0.28em] text-white/45">Supaya menang</p>
          <p class="font-cond mt-[0.4rem] text-[5rem] font-bold uppercase leading-[0.8] text-primary">
            Kunci kemenangan
          </p>
        </div>

        <div class="mt-[1.2rem] flex flex-col justify-evenly">
          <div class="grid grid-cols-[7rem_1fr] gap-[1.4rem] border-b border-white/12 py-[1.3rem]">
            <p class="font-cond text-[6rem] font-bold leading-none text-primary">01</p>
            <div>
              <p class="font-cond text-[3rem] font-bold uppercase leading-none text-white">Tekan lini tengah</p>
              <p class="mt-[0.6rem] text-[24px] leading-[1.5] text-white/60">
                Gresik menguasai bola 52% dan 58% di dua laga. Potong aliran bola sebelum masuk ke area berbahaya.
              </p>
            </div>
          </div>

          <div class="grid grid-cols-[7rem_1fr] gap-[1.4rem] border-b border-white/12 py-[1.3rem]">
            <p class="font-cond text-[6rem] font-bold leading-none text-primary">02</p>
            <div>
              <p class="font-cond text-[3rem] font-bold uppercase leading-none text-white">Perbanyak tembakan tepat</p>
              <p class="mt-[0.6rem] text-[24px] leading-[1.5] text-white/60">
                Persibo hanya menghasilkan dua tembakan tepat ke Persipa. Target lima sampai enam kali.
              </p>
            </div>
          </div>

          <div class="grid grid-cols-[7rem_1fr] gap-[1.4rem] border-b border-white/12 py-[1.3rem]">
            <p class="font-cond text-[6rem] font-bold leading-none text-primary">03</p>
            <div>
              <p class="font-cond text-[3rem] font-bold uppercase leading-none text-white">Jaga fokus sampai akhir</p>
              <p class="mt-[0.6rem] text-[24px] leading-[1.5] text-white/60">
                Dua kebobolan terjadi di menit 90+3 dan 90+4. Jangan mundur terlalu dalam di menit 80 ke atas.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-[1.4rem] border border-white/12 bg-[#0c0b0f] px-[1.4rem] py-[1.1rem]">
          <p class="text-[22px] font-bold uppercase tracking-[0.18em] text-white/45">Risikonya</p>
          <p class="mt-[0.5rem] text-[24px] leading-[1.5] text-white/70">
            Kalau masih 0-0 sampai menit 75, Gresik punya bukti bisa mencetak gol di menit 78.
          </p>
        </div>

        <p class="mt-auto pt-[1rem] text-center text-[20px] uppercase tracking-[0.12em] text-white/35">
          Analisis berdasarkan dua laga pertama, bukan hasil pertandingan
        </p>

        <div class="mt-[1.3rem] flex items-center justify-between bg-primary px-[1.5rem] py-[1.3rem] text-[#08070a]">
          <p class="text-[24px] font-extrabold uppercase tracking-[0.2em]">Jadwal &amp; klasemen lengkap</p>
          <p class="font-cond text-[1.7rem] font-bold uppercase tracking-[0.12em]">persibo.com →</p>
        </div>

        <div class="mt-[1.1rem] flex items-end justify-between">
          <div>
            <p class="font-cond text-[2.6rem] font-bold uppercase leading-none text-white">
              Persibo<span class="text-primary">.</span>
            </p>
            <p class="mt-[0.35rem] text-[21px] uppercase tracking-[0.22em] text-white/35">Laskar Angling Dharma</p>
          </div>
          <p class="text-[20px] uppercase tracking-[0.18em] text-white/25">© 2026 Persibo Bojonegoro</p>
        </div>
      </div>
    </section>
  </body>
</html>
