---
import type { GetStaticPaths } from 'astro';
import posts from '../../../social/posts.json';
import assetsManifest from '../../data/assets-manifest.json';
import playersJson from '../../data/players.json';
import { loadFixtures, loadTeams, getScheduledFixtures, getTeamLogo } from '../../utils/dataLoader';
import { getWeekday } from '../../utils/dates';
import '../../styles/global.css';

type Post = {
  out: string;
  mode?: 'jadwal' | 'hasil' | 'lineup' | 'stats' | 'momentum';
  /** Header + date-panel label; set it for friendlies, which have no group or matchday. */
  competition?: string;
  /** Top-right chip; defaults to the group. */
  tag?: string;
  /** Ticket note, e.g. "Ekonomi Rp25.000 · VIP Rp90.000". Never the CTA. */
  ticket?: string;
  /** Side captions; friendlies have no group, so the away side needs one. */
  captions?: { home?: string; away?: string };
  date?: string;
  time?: string;
  home?: string;
  away?: string;
  venue?: string;
  grup?: string;
  md?: number;
  hs?: string;
  as?: string;
  scorers?: { minute?: string; player: string; team?: string }[];
  /** Lineup poster; rows render Penyerang → Kiper top to bottom on the pitch. */
  formation?: string;
  coach?: string;
  xi?: { no: number; name: string; pos: 'KIP' | 'BEK' | 'GEL' | 'PEN' }[];
  subs?: { no: number; name: string }[];
  /** Stats poster; numbers sourced from persibo-analytics outputs. */
  stats?: {
    possessionHome: number;
    possessionAway: number;
  /** Serangan per kanal [kiri, tengah, kanan], % aktivitas pemain. */
  home: { title: string; lanes: [number, number, number] };
  away: { title: string; lanes: [number, number, number] };
  };
  /** Kurva momentum: [menit laga, % kepemilikan Persibo], jeda istirahat sudah dipangkas. */
  momentumWave?: [number, number][];
};

// One static page per entry in social/posts.json; the render script screenshots each one.
export const getStaticPaths: GetStaticPaths = () =>
  (import.meta.env.DEV ? (posts as Post[]) : []).map((post) => ({ params: { poster: post.out }, props: { post } }));

const { post } = Astro.props as { post: Post };

const fixtures = await loadFixtures();
const teams = await loadTeams();
const next = getScheduledFixtures(fixtures)[0] ?? null;

const homeTeam = post.home ?? next?.home_team ?? '';
const awayTeam = post.away ?? next?.away_team ?? '';
const isHome = homeTeam.toUpperCase().includes('PERSIBO');

const longDate = post.date ?? next?.date ?? '';
const [day, month, year] = longDate.replace(/^[^,]+,\s*/, '').split(' ');
const weekday = getWeekday(longDate);


const venue = post.venue ?? next?.venue ?? 'Bojonegoro';
const group = post.grup ?? 'B';
// Only fixtures in the loaded season have a matchday; friendlies and archive games do not.
const derivedMatchday = fixtures.findIndex((fixture) => fixture.date === longDate) + 1;
const matchday = post.md ? String(post.md) : derivedMatchday > 0 ? String(derivedMatchday) : '';

const scorers = post.scorers ?? [];
const mode = ['hasil', 'lineup', 'stats', 'momentum'].includes(post.mode ?? '') ? post.mode! : 'jadwal';
const pct = (n: number) => n.toFixed(1).replace('.', ',');
// Kurva momentum -> path SVG (gunung): area = porsi Persibo, garis putus = 50%.
const wave = post.momentumWave ?? [];
const WV = { w: 900, h: 620, pad: 16 };
const wx = (m: number) => WV.pad + (m / 90) * (WV.w - 2 * WV.pad);
const wy = (v: number) => WV.pad + (1 - v / 100) * (WV.h - 2 * WV.pad);
const wavePts = wave.map(([m, v]) => `${wx(m).toFixed(1)},${wy(v).toFixed(1)}`);
const waveArea = `M ${wx(0).toFixed(1)},${(WV.h - WV.pad).toFixed(1)} L ${wavePts.join(' L ')} L ${wx(90).toFixed(1)},${(WV.h - WV.pad).toFixed(1)} Z`;
const waveLine = `M ${wavePts.join(' L ')}`;
const posOrder = [
  ['PEN', 'Penyerang'],
  ['GEL', 'Gelandang'],
  ['BEK', 'Bek'],
  ['KIP', 'Kiper'],
] as const;
const xiRows = posOrder
  .map(([pos, label]) => ({ label, players: (post.xi ?? []).filter((p) => p.pos === pos) }))
  .filter((row) => row.players.length > 0);
const photoByNumber = new Map(playersJson.map((p) => [Number(p.jersey_number), p.photo_local || p.photo_url || '']));
const photoFor = (no: number) => photoByNumber.get(no) || '';
const score = mode === 'hasil' ? `${post.hs ?? ''}:${post.as ?? ''}` : 'VS';
const isPersibo = (team: string) => team.toUpperCase().includes('PERSIBO');
// Mirrored crests are 50-105px wide, and the manifest points at last season's CDN path whose
// /h/200/ variant is gone. The current season's teams.json URL does have an 830px file, so
// map mirrored path → club name → current URL, and keep the mirror as the fallback.
type LogoAsset = { kind: string; name: string; path: string };
const teamLogoAssets = (assetsManifest.assets as LogoAsset[]).filter((asset) => asset.kind === 'team-logo');
const nameByPath = new Map(teamLogoAssets.map((asset) => [asset.path, asset.name]));
const remoteByName = new Map(teams.map((team) => [team.name.toUpperCase(), team.logo_url]));
const logoFor = (team: string) => {
  const local = getTeamLogo(teams, team);
  if (!local || isPersibo(team)) return { src: '/logo.png', fallback: '/logo.png' };
  const club = nameByPath.get(local);
  const remote = (club && remoteByName.get(club.toUpperCase())) || '';
  return { src: remote ? remote.replace('/h/50/', '/h/200/') : local, fallback: local };
};
const shortName = (team: string) => team.replace(/\s+(BOJONEGORO|FC|UNITED)$/i, '').toUpperCase();

const persiboGoals = Number(isPersibo(homeTeam) ? post.hs : post.as);
const rivalGoals = Number(isPersibo(homeTeam) ? post.as : post.hs);
const outcome = Number.isNaN(persiboGoals) || Number.isNaN(rivalGoals)
  ? ''
  : persiboGoals > rivalGoals
    ? 'Menang'
    : persiboGoals < rivalGoals
      ? 'Kalah'
      : 'Seri';

// Results have no published kick-off time; only use one the fixture actually has.
const kickoff = post.time ?? next?.time;
const time = (kickoff ?? '').replace(':', '.');

// Only fixtures after this one; ISO compare keeps the order right across months.
const refKickoff = fixtures.find((fixture) => fixture.date === longDate)?.kickoff_iso ?? '';
const upcoming = getScheduledFixtures(fixtures)
  .filter((fixture) => !refKickoff || (fixture.kickoff_iso ?? '') > refKickoff)
  .slice(0, 3);

const leftName = shortName(homeTeam);
const rightName = shortName(awayTeam);
const leftLogo = logoFor(homeTeam);
const rightLogo = logoFor(awayTeam);
// A friendly or archive fixture is not in this group table, so it gets no group caption.
const sideCaption = (team: string) =>
  isPersibo(team) ? 'Bojonegoro' : derivedMatchday > 0 ? `Grup ${group}` : '';
const leftCaption = post.captions?.home ?? sideCaption(homeTeam);
const rightCaption = post.captions?.away ?? sideCaption(awayTeam);
// Long club names would otherwise run into the centre column.
const nameClass = (name: string) =>
  `font-cond font-bold uppercase leading-[0.95] ${name.length > 13 ? 'text-[3rem]' : 'text-[4.2rem]'}`;
---


<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Poster laga — PERSIBO</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Lexend:wght@400;500;600;700;800&display=swap"
    />
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        background: #0b0910;
      }
    </style>
  </head>
  <body>
    <div
      id="poster"
      class="relative overflow-hidden bg-[#0b0910] text-[#f5f2ec]"
      style="width:1080px;height:1350px;font-family:'Lexend',sans-serif"
    >
      <!-- Backdrop: orange glow plus a tilted crest watermark. -->
      <div
        class="pointer-events-none absolute inset-0"
        style="background:radial-gradient(circle at 82% 6%, rgba(249,115,22,0.16), transparent 46%)"
      >
      </div>

      <div class="relative flex h-full flex-col px-[3rem] py-[2.8rem]">
        <!-- Header -->
        <div class="flex items-center justify-between text-[20px] font-bold uppercase tracking-[0.26em]">
          <p class="flex items-center gap-[0.6rem] text-white/55">
            <span class="inline-block h-[0.5rem] w-[0.5rem] bg-primary"></span>
            {post.competition ?? 'Liga Nusantara 2026-27'}
          </p>
          <p class="text-white/35">{post.tag ?? `Grup ${group}`}</p>
        </div>
        <div class="mt-[0.9rem] h-px w-full bg-white/15"></div>

        {(mode === 'jadwal' || mode === 'hasil') && (
        <>
        <!-- Date panel: the day is the hero, kick-off fills the opposite corner. -->
        <div class="mt-[1.8rem] border border-white/12 bg-[#0c0b0f] px-[2rem] py-[2rem]">
          <div class="flex items-start justify-between gap-[1rem]">
            <div>
              <p class="flex items-center gap-[0.7rem] text-[18px] font-bold uppercase tracking-[0.28em] text-white/45">
                <span class="inline-block h-px w-[1.6rem] bg-primary"></span>
                {[mode === 'hasil' ? 'Hasil' : matchday ? `Matchday ${matchday}` : 'Jadwal', weekday].filter(Boolean).join(' · ')}
              </p>
              <div class="mt-[1rem] flex items-end gap-[1.1rem]">
                <p class="font-cond text-[14rem] font-bold leading-[0.66] text-primary">{day ?? '--'}</p>
                <div class="pb-[0.5rem]">
                  <p class="font-cond text-[4.6rem] font-semibold uppercase leading-none">{(month ?? '').slice(0, 3)}</p>
                  <p class="mt-[0.35rem] text-[18px] font-semibold tracking-[0.3em] text-white/45">{year ?? ''}</p>
                </div>
              </div>
              {post.ticket && (
                <p class="mt-[1.3rem] flex items-center gap-[0.7rem] text-[17px] font-bold uppercase tracking-[0.18em] text-white/55">
                  <span class="inline-block h-[0.5rem] w-[0.5rem] bg-primary"></span>
                  Tiket · <span class="font-semibold text-white/75">{post.ticket}</span>
                </p>
              )}
            </div>

            <div class="shrink-0 border-l border-white/15 pl-[1.3rem] text-right">
              {mode === 'jadwal' && kickoff && (
                <>
                  <p class="text-[16px] uppercase tracking-[0.24em] text-white/40">Kick-off</p>
                  <p class="font-cond mt-[0.3rem] text-[4.6rem] font-semibold leading-none">{time}</p>
                  <p class="mt-[0.25rem] text-[17px] uppercase tracking-[0.2em] text-white/40">WIB</p>
                </>
              )}
              {mode === 'hasil' && outcome && (
                <>
                  <p class="text-[16px] uppercase tracking-[0.24em] text-white/40">Hasil</p>
                  <p class="font-cond mt-[0.2rem] text-[2.2rem] font-bold uppercase leading-none text-primary">{outcome}</p>
                </>
              )}
              <p class="mt-[0.9rem] text-[16px] uppercase tracking-[0.24em] text-white/40">Stadion</p>
              <p class="mt-[0.3rem] max-w-[15rem] text-[19px] font-semibold uppercase leading-[1.35] tracking-[0.06em] text-white/80">{venue}</p>
            </div>
          </div>
        </div>

        <!-- Teams: left is always the home side, so the poster never flips the fixture order. -->
        <div class={`mt-[2rem] grid grid-cols-[1fr_auto_1fr] items-center gap-[1.2rem] border-y border-white/15 py-[2.6rem] ${mode === 'hasil' ? 'flex-1 content-center' : ''}`}>
          <div class="flex min-w-0 flex-col items-start gap-[0.9rem]">
            <img
              src={leftLogo.src}
              alt=""
              class="h-[11.5rem] w-[11.5rem] object-contain"
              onerror={`this.onerror=null;this.src='${leftLogo.fallback}'`}
            />
            <div class="min-w-0">
              <p class={nameClass(leftName)}>{leftName}</p>
              <p class="mt-[0.3rem] text-[17px] uppercase tracking-[0.22em] text-white/45">{leftCaption}</p>
            </div>
          </div>

          <div class="flex flex-col items-center justify-center px-[0.4rem]">
            {mode === 'hasil' ? (
              <p class="font-cond text-[9rem] font-bold leading-none text-primary">{score}</p>
            ) : (
              <p class="font-cond text-[7rem] leading-none text-white/22">VS</p>
            )}
            <p class="mt-[0.5rem] text-[17px] uppercase tracking-[0.22em] text-white/25">
              {isHome ? 'Kandang' : 'Tandang'}
            </p>
          </div>

          <div class="flex min-w-0 flex-col items-end gap-[0.9rem] text-right">
            <img
              src={rightLogo.src}
              alt=""
              class="h-[11.5rem] w-[11.5rem] object-contain"
              onerror={`this.onerror=null;this.src='${rightLogo.fallback}'`}
            />
            <div class="min-w-0">
              <p class={nameClass(rightName)}>{rightName}</p>
              <p class="mt-[0.3rem] text-[17px] uppercase tracking-[0.22em] text-white/45">{rightCaption}</p>
            </div>
          </div>
        </div>

        <!-- Results get the scorers; fixtures get what comes next. -->
        {mode === 'hasil' && scorers.length > 0 ? (
          <div class="mt-[1.8rem]">
            <p class="text-[18px] font-bold uppercase tracking-[0.26em] text-white/40">Pencetak gol</p>
            <div class="mt-[0.7rem] border-t border-white/12">
              {scorers.map((goal) => (
                <div class="flex items-center gap-[1rem] border-b border-white/12 py-[1.15rem]">
                  {goal.minute && (
                    <p class="font-cond w-[4.5rem] shrink-0 text-[1.7rem] font-bold uppercase leading-none text-primary">
                      {goal.minute}
                    </p>
                  )}
                  <p class="font-cond min-w-0 flex-1 truncate text-[2.1rem] font-semibold uppercase leading-none text-white/85">
                    {goal.player}
                  </p>
                  <p class="w-[6.5rem] shrink-0 text-right text-[16px] uppercase tracking-[0.2em] text-white/35">
                    {(goal.team ?? '').toUpperCase()}
                  </p>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <div class="mt-[1.8rem]">
            <p class="text-[18px] font-bold uppercase tracking-[0.26em] text-white/40">Jadwal berikutnya</p>
            <div class="mt-[0.7rem] border-t border-white/12">
              {upcoming.map((fixture) => {
                const [d, m] = fixture.date.split(' ');
                const opponentName = (isPersibo(fixture.home_team) ? fixture.away_team : fixture.home_team);
                return (
                  <div class="flex items-center gap-[1rem] border-b border-white/12 py-[0.62rem]">
                    <p class="font-cond w-[7rem] shrink-0 text-[1.8rem] font-bold uppercase leading-none text-primary">
                      {d} {m.slice(0, 3)}
                    </p>
                    <p class="font-cond min-w-0 flex-1 truncate text-[2.1rem] font-semibold uppercase leading-none text-white/85">
                      {shortName(opponentName)}
                    </p>
                    <p class="w-[6.5rem] shrink-0 text-right text-[16px] uppercase tracking-[0.2em] text-white/35">
                      {isPersibo(fixture.home_team) ? 'Kandang' : 'Tandang'}
                    </p>
                  </div>
                );
              })}
            </div>
          </div>
        )}
        </>)}

        {mode === 'lineup' && (
        <>
        <!-- Formation hero left, fixture identity right. -->
        <div class="mt-[1.4rem] flex items-end justify-between gap-[1.5rem] border-b border-white/15 pb-[1.2rem]">
          <div class="shrink-0">
            <p class="flex items-center gap-[0.7rem] text-[18px] font-bold uppercase tracking-[0.28em] text-white/45">
              <span class="inline-block h-px w-[1.6rem] bg-primary"></span>
              Susunan pemain
            </p>
            <p class="font-cond mt-[0.4rem] text-[6.5rem] font-bold uppercase leading-[0.8] text-primary">{post.formation ?? '-'}</p>
          </div>
          <div class="min-w-0 pb-[0.4rem] text-right">
            <div class="flex items-center justify-end gap-[1rem]">
              <img src={leftLogo.src} alt="" class="h-[5.5rem] w-[5.5rem] shrink-0 object-contain" onerror={`this.onerror=null;this.src='${leftLogo.fallback}'`} />
              <p class="font-cond whitespace-nowrap text-[2.8rem] font-bold uppercase leading-none">{leftName}</p>
              <p class="font-cond text-[2rem] leading-none text-white/25">VS</p>
              <p class="font-cond whitespace-nowrap text-[2.8rem] font-bold uppercase leading-none">{rightName}</p>
              <img src={rightLogo.src} alt="" class="h-[5.5rem] w-[5.5rem] shrink-0 object-contain" onerror={`this.onerror=null;this.src='${rightLogo.fallback}'`} />
            </div>
            <p class="mt-[0.8rem] text-[16px] uppercase tracking-[0.22em] text-white/40">{longDate}{matchday ? ` · Matchday ${matchday}` : ''}</p>
          </div>
        </div>

        <!-- Pitch: own half, kiper at the bottom. -->
        <div class="relative mt-[1.4rem] min-h-0 flex-1 overflow-hidden rounded-[1rem] border border-white/12 bg-[#0e1a13] px-[2rem] py-[0.9rem]">
          <div class="pointer-events-none absolute inset-0">
            <div class="absolute inset-x-[9rem] bottom-0 h-[9.5rem] border-x border-t border-white/10"></div>
            <div class="absolute inset-x-[19rem] bottom-0 h-[3.4rem] border-x border-t border-white/10"></div>
            <div class="absolute bottom-[9.5rem] left-1/2 h-[10rem] w-[10rem] -translate-x-1/2 rounded-full border border-white/10"></div>
            <div class="absolute inset-x-0 top-0 h-[2px] bg-white/10"></div>
          </div>
          <div class="relative flex h-full flex-col justify-between py-[0.4rem]">
            {xiRows.map((row) => (
              <div class="flex items-start gap-[0.9rem]">
                <p class="w-[1.6rem] shrink-0 self-stretch font-cond text-[1.35rem] font-bold uppercase leading-none tracking-[0.18em] text-white/30" style="writing-mode:vertical-rl;transform:rotate(180deg)">{row.label}</p>
                <div class="flex flex-1 justify-evenly">
                  {row.players.map((player) => (
                    <div class="flex w-[11rem] flex-col items-center gap-[0.4rem]">
                      <div class="relative h-[5.1rem] w-[5.1rem] shrink-0">
                        <div class="h-full w-full overflow-hidden rounded-full border border-white/25 bg-white/10">
                          {photoFor(player.no) && <img src={photoFor(player.no)} alt="" class="h-full w-full object-cover object-top" />}
                        </div>
                        <span class="absolute -bottom-1 -right-1 flex h-[2.3rem] w-[2.3rem] items-center justify-center rounded-full bg-primary font-cond text-[1.4rem] font-bold leading-none text-[#08070a]">{player.no}</span>
                      </div>
                      <p class="max-w-[11rem] text-center text-[1.5rem] font-semibold uppercase leading-[1.1] text-white/85">{player.name}</p>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Bench wraps naturally; coach fills the right. -->
        <div class="mt-[1.4rem]">
          <div class="flex items-baseline justify-between gap-[1.5rem]">
            <p class="shrink-0 text-[18px] font-bold uppercase tracking-[0.26em] text-white/40">Pemain pengganti</p>
            {post.coach && <p class="truncate text-[16px] uppercase tracking-[0.2em] text-white/40">Pelatih · <span class="font-semibold text-white/70">{post.coach}</span></p>}
          </div>
          <div class="mt-[0.8rem] flex flex-wrap gap-x-[1.8rem] gap-y-[0.55rem] border-t border-white/12 pt-[1rem]">
            {(post.subs ?? []).map((player) => (
              <p class="flex items-center gap-[0.55rem] text-[1.65rem] font-semibold uppercase leading-none text-white/70">
                <span class="h-[2.5rem] w-[2.5rem] shrink-0 overflow-hidden rounded-full border border-white/20 bg-white/10">
                  {photoFor(player.no) && <img src={photoFor(player.no)} alt="" class="h-full w-full object-cover object-top" />}
                </span>
                <span class="font-cond w-[1.9rem] shrink-0 text-right text-[1.55rem] font-bold leading-none text-primary">{player.no}</span>
                {player.name}
              </p>
            ))}
          </div>
        </div>
        </>
        )}

        {mode === 'stats' && (
        <>
        <!-- Scoreboard strip: crests, score, date. -->
        <div class="mt-[1.4rem] flex items-center justify-between border-b border-white/15 pb-[1.5rem]">
          <div class="flex min-w-0 items-center gap-[1.1rem]">
            <img src={leftLogo.src} alt="" class="h-[6rem] w-[6rem] shrink-0 object-contain" onerror={`this.onerror=null;this.src='${leftLogo.fallback}'`} />
            <p class="font-cond truncate text-[3.4rem] font-bold uppercase leading-none">{leftName}</p>
          </div>
          <div class="shrink-0 text-center">
            <p class="font-cond text-[6.4rem] font-bold uppercase leading-none text-primary">{post.hs ?? '0'}:{post.as ?? '0'}</p>
            <p class="mt-[0.6rem] text-[16px] uppercase tracking-[0.22em] text-white/40">{longDate}{matchday ? ` · Matchday ${matchday}` : ''}</p>
          </div>
          <div class="flex min-w-0 items-center gap-[1.1rem] text-right">
            <p class="font-cond truncate text-[3.4rem] font-bold uppercase leading-none">{rightName}</p>
            <img src={rightLogo.src} alt="" class="h-[6rem] w-[6rem] shrink-0 object-contain" onerror={`this.onerror=null;this.src='${rightLogo.fallback}'`} />
          </div>
        </div>

        <div class="flex min-h-0 flex-1 flex-col justify-evenly">
          <!-- Possession as typographic hero: giant numbers, thin split bar. -->
          <div>
            <p class="text-center text-[18px] font-bold uppercase tracking-[0.26em] text-white/40">Penguasaan bola</p>
            <div class="mt-[0.5rem] flex items-baseline justify-between px-[0.6rem]">
              <p class="font-cond text-[10rem] font-bold leading-[0.85] text-primary">{pct(post.stats?.possessionHome ?? 50)}<span class="text-[3.6rem]">%</span></p>
              <p class="font-cond text-[10rem] font-bold leading-[0.85] text-white/85">{pct(post.stats?.possessionAway ?? 50)}<span class="text-[3.6rem]">%</span></p>
            </div>
            <div class="mt-[0.9rem] flex h-[1.1rem] overflow-hidden rounded-full border border-white/12">
              <div class="bg-primary" style={`width:${post.stats?.possessionHome ?? 50}%`}></div>
              <div class="flex-1 bg-white/15"></div>
            </div>
            <div class="mt-[0.6rem] flex justify-between text-[1.6rem] font-semibold uppercase tracking-[0.22em] text-white/55">
              <p>{leftName}</p>
              <p>{rightName}</p>
            </div>
          </div>

          <!-- Styles face off over a central VS. -->
          <div class="relative grid grid-cols-2 gap-[3rem]">
            <div class="absolute left-1/2 top-1/2 z-10 flex h-[4rem] w-[4rem] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-white/15 bg-[#0b0910] font-cond text-[1.7rem] font-bold text-white/60">VS</div>
            <div class="border border-white/12 border-l-[0.45rem] border-l-primary bg-[#0c0b0f] px-[1.8rem] py-[1.6rem]">
              <p class="font-cond text-[3.2rem] font-bold uppercase leading-none text-primary">{post.stats?.home.title}</p>
              <p class="mt-[1.3rem] text-[1.5rem] uppercase tracking-[0.1em] text-white/40">Distribusi serangan</p>
              <div class="mt-[0.7rem] flex h-[1.7rem] overflow-hidden rounded-full border border-white/10">
                <div class="bg-primary" style={`width:${post.stats?.home.lanes[0]}%`}></div>
                <div class="bg-primary/60" style={`width:${post.stats?.home.lanes[1]}%`}></div>
                <div class="bg-primary/30 flex-1"></div>
              </div>
              <div class="mt-[0.6rem] flex justify-between text-[1.5rem] font-semibold uppercase tracking-[0.08em] text-white/55">
                <p>Kiri <span class="font-cond text-[1.8rem] font-bold text-white/85">{pct(post.stats?.home.lanes[0] ?? 0)}</span></p>
                <p>Tengah <span class="font-cond text-[1.8rem] font-bold text-white/85">{pct(post.stats?.home.lanes[1] ?? 0)}</span></p>
                <p>Kanan <span class="font-cond text-[1.8rem] font-bold text-white/85">{pct(post.stats?.home.lanes[2] ?? 0)}</span></p>
              </div>
            </div>
            <div class="border border-white/12 border-r-[0.45rem] border-r-white/40 bg-[#0c0b0f] px-[1.8rem] py-[1.6rem] text-right">
              <p class="font-cond text-[3.2rem] font-bold uppercase leading-none text-white/85">{post.stats?.away.title}</p>
              <p class="mt-[1.3rem] text-[1.5rem] uppercase tracking-[0.1em] text-white/40">Distribusi serangan</p>
              <div class="mt-[0.7rem] flex h-[1.7rem] overflow-hidden rounded-full border border-white/10">
                <div class="bg-white/80" style={`width:${post.stats?.away.lanes[0]}%`}></div>
                <div class="bg-white/50" style={`width:${post.stats?.away.lanes[1]}%`}></div>
                <div class="bg-white/25 flex-1"></div>
              </div>
              <div class="mt-[0.6rem] flex justify-between text-[1.5rem] font-semibold uppercase tracking-[0.08em] text-white/55">
                <p><span class="font-cond text-[1.8rem] font-bold text-white/85">{pct(post.stats?.away.lanes[0] ?? 0)}</span> Kiri</p>
                <p><span class="font-cond text-[1.8rem] font-bold text-white/85">{pct(post.stats?.away.lanes[1] ?? 0)}</span> Tengah</p>
                <p><span class="font-cond text-[1.8rem] font-bold text-white/85">{pct(post.stats?.away.lanes[2] ?? 0)}</span> Kanan</p>
              </div>
            </div>
          </div>
        </div>
        </>
        )}

        {mode === 'momentum' && (
        <>
        <!-- Scoreboard strip: crests, score, date. -->
        <div class="mt-[1.4rem] flex items-center justify-between border-b border-white/15 pb-[1.5rem]">
          <div class="flex min-w-0 items-center gap-[1.1rem]">
            <img src={leftLogo.src} alt="" class="h-[6rem] w-[6rem] shrink-0 object-contain" onerror={`this.onerror=null;this.src='${leftLogo.fallback}'`} />
            <p class="font-cond truncate text-[3.4rem] font-bold uppercase leading-none">{leftName}</p>
          </div>
          <div class="shrink-0 text-center">
            <p class="font-cond text-[6.4rem] font-bold uppercase leading-none text-primary">{post.hs ?? '0'}:{post.as ?? '0'}</p>
            <p class="mt-[0.6rem] text-[16px] uppercase tracking-[0.22em] text-white/40">{longDate}{matchday ? ` · Matchday ${matchday}` : ''}</p>
          </div>
          <div class="flex min-w-0 items-center gap-[1.1rem] text-right">
            <p class="font-cond truncate text-[3.4rem] font-bold uppercase leading-none">{rightName}</p>
            <img src={rightLogo.src} alt="" class="h-[6rem] w-[6rem] shrink-0 object-contain" onerror={`this.onerror=null;this.src='${rightLogo.fallback}'`} />
          </div>
        </div>

        <div class="flex min-h-0 flex-1 flex-col justify-evenly">
          <div>
            <p class="text-center text-[18px] font-bold uppercase tracking-[0.26em] text-white/40">Pasang surut bola</p>
            <div class="mt-[0.9rem] flex justify-between text-[1.6rem] font-semibold uppercase tracking-[0.22em] text-white/55">
              <p class="flex items-center gap-[0.6rem]"><span class="inline-block h-[0.9rem] w-[0.9rem] rounded-full bg-primary"></span>{leftName}</p>
              <p class="flex items-center gap-[0.6rem]">{rightName}<span class="inline-block h-[0.9rem] w-[0.9rem] rounded-full bg-white/60"></span></p>
            </div>
          </div>

          <!-- Mountain chart: tinggi gunung = porsi bola Persibo; garis putus = 50%. -->
          <svg viewBox={`0 0 ${WV.w} ${WV.h + 44}`} class="w-full" role="img" aria-label="Grafik momentum kepemilikan bola">
            <line x1={WV.pad} y1={wy(25)} x2={WV.w - WV.pad} y2={wy(25)} style="stroke:rgba(255,255,255,0.07);stroke-width:1" />
            <line x1={WV.pad} y1={wy(75)} x2={WV.w - WV.pad} y2={wy(75)} style="stroke:rgba(255,255,255,0.07);stroke-width:1" />
            <line x1={WV.pad} y1={wy(50).toFixed(1)} x2={WV.w - WV.pad} y2={wy(50).toFixed(1)} style="stroke:rgba(255,255,255,0.25);stroke-width:2;stroke-dasharray:10 10" />
            <path d={waveArea} style="fill:rgba(249,115,22,0.30)" />
            <path d={waveLine} style="fill:none;stroke:#f97316;stroke-width:5;stroke-linejoin:round" />
            {[0, 15, 30, 45, 60, 75, 90].map((m) => (
              <text x={wx(m)} y={WV.h - WV.pad + 42} text-anchor={m === 0 ? 'start' : m === 90 ? 'end' : 'middle'} style="fill:rgba(255,255,255,0.40);font-family:'Barlow Condensed';font-weight:600;font-size:26px">{m}'</text>
            ))}
          </svg>

          <p class="text-center text-[1.7rem] leading-[1.5] text-white/50">Persipa menguasai porsi tengah laga, Persibo menutupnya lebih berani.</p>
        </div>
        </>
        )}

        <!-- Call to action -->
        <div class="mt-[1.6rem] flex items-center justify-between bg-primary px-[1.5rem] py-[1.35rem] text-[#08070a]">
          <p class="text-[19px] font-extrabold uppercase tracking-[0.2em]">Jadwal &amp; klasemen lengkap</p>
          <p class="font-cond text-[1.7rem] font-bold uppercase tracking-[0.12em]">persibo.com →</p>
        </div>

        <!-- Footer -->
        <div class="mt-[1.2rem] flex items-end justify-between">
          <div>
            <p class="font-cond text-[2.6rem] font-bold uppercase leading-none text-white">
              Persibo<span class="text-primary">.</span>
            </p>
            <p class="mt-[0.35rem] text-[16px] uppercase tracking-[0.22em] text-white/35">Laskar Angling Dharma</p>
          </div>
          <p class="text-[15px] uppercase tracking-[0.18em] text-white/25">© 2026 Persibo Bojonegoro</p>
        </div>

      </div>
    </div>
  </body>
</html>
