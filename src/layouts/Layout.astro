---
import GlobalSearch from '../components/GlobalSearch.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title = 'PERSIBO Bojonegoro', description = 'Situs penggemar PERSIBO Bojonegoro - Liga Nusantara 2026-27', ogImage } = Astro.props;
const siteOrigin = (Astro.site || Astro.url.origin).toString().replace(/\/+$/, '');
const defaultOgImage = `${siteOrigin}/logo.png`;
// If ogImage is provided and is already a full URL (http/https), use it directly
// If it's a local path (starts with /), prepend origin
// Otherwise use default
const finalOgImage = ogImage
  ? (ogImage.startsWith('http://') || ogImage.startsWith('https://')
      ? ogImage
      : `${siteOrigin}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`)
  : defaultOgImage;
// Built pages resolve to a trailing-slash pathname (`/klasemen/`); normalize so nav
// active-state comparisons work in both dev and production.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html class="dark" lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#121018" />
    <meta name="google-adsense-account" content="ca-pub-1300254481589524" />
    <meta name="generator" content={Astro.generator} />
    <!-- Disable Cloudflare Rocket Loader for better performance -->
    <meta name="cf-2xx-ok" content="" />
    <meta name="cf-browser-verification" content="" />
    <script is:inline>
      // Aggressively disable Rocket Loader before it loads
      (function() {
        if (typeof window !== 'undefined') {
          window.$RocketLoader = undefined;
          Object.defineProperty(window, '$RocketLoader', {
            value: undefined,
            writable: false,
            configurable: false
          });
        }
      })();
    </script>
    <title>{title}</title>
    
    <!-- SEO Meta Tags -->
    <meta name="keywords" content="PERSIBO Bojonegoro, Liga Nusantara, Sepak Bola Indonesia, Tim Sepak Bola Bojonegoro, Klasemen Liga Nusantara 2026-27" />
    <meta name="author" content="PERSIBO Bojonegoro" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Indonesian" />
    <meta name="revisit-after" content="7 days" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={finalOgImage} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content="PERSIBO Bojonegoro" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={Astro.url.href} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalOgImage} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url.href} />
    
    <!-- Preload Critical Resources (conditional based on route) -->
    {currentPath === '/' && (
      <link rel="preload" href="/hero.jpg" as="image" fetchpriority="high" />
    )}
    
    <!-- Additional Rocket Loader prevention -->
    <script is:inline>
      // Prevent Rocket Loader from loading
      (function() {
        if (typeof window !== 'undefined') {
          Object.defineProperty(window, '$RocketLoader', {
            value: undefined,
            writable: false,
            configurable: false
          });
        }
      })();
    </script>
    
    <!-- DNS Prefetch for External Resources -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

    <!-- Structured Data - Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "PERSIBO Bojonegoro",
      "alternateName": "Laskar Angling Dharma",
      "url": siteOrigin,
      "logo": `${siteOrigin}/logo-128.png`,
      "description": "Situs penggemar PERSIBO Bojonegoro - Tim sepak bola profesional dari Bojonegoro, Jawa Timur. Informasi lengkap tentang tim, pemain, klasemen, dan jadwal pertandingan di Liga Nusantara 2026-27.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "JL. UNTUNG SUROPATI NO. 39",
        "addressLocality": "Bojonegoro",
        "addressRegion": "Jawa Timur",
        "postalCode": "62115",
        "addressCountry": "ID"
      },
      "sameAs": [
        "https://www.ileague.id/clubs/single/LIGA_NUSANTARA_2026-27/PERSIBO_Bojonegoro"
      ]
    })} />
    <!-- Non-blocking Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Lexend:wght@400;500;700;800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Lexend:wght@400;500;700;800&display=swap" rel="stylesheet" /></noscript>
    
    <!-- Material Symbols - optimized subset, non-blocking -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet" /></noscript>
    
    <!-- Google AdSense - Keep original format as required by AdSense policy -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1300254481589524" crossorigin="anonymous" data-cfasync="false"></script>
    
    <!-- Google tag (gtag.js) - Load after user interaction or scroll to reduce unused JS -->
    <script is:inline>
      // Load GTM/GA only after user interaction or scroll (reduces unused JS)
      let gtmLoaded = false;
      
      function loadGTM() {
        if (gtmLoaded) return;
        gtmLoaded = true;
        
        const gtagScript = document.createElement('script');
        gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-W843MTD8G4';
        gtagScript.async = true;
        document.head.appendChild(gtagScript);
        
        gtagScript.onload = function() {
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-W843MTD8G4');
        };
      }
      
      // Load on user interaction (click, scroll, touch)
      ['click', 'scroll', 'touchstart', 'keydown'].forEach(function(event) {
        document.addEventListener(event, function() {
          loadGTM();
        }, { once: true, passive: true });
      });
      
      // Fallback: Load after 5 seconds if no interaction
      setTimeout(function() {
        loadGTM();
      }, 5000);
    </script>
  </head>
  <body class="bg-background-dark font-display min-h-screen text-[#f5f2ec]">
    <div class="relative flex h-auto min-h-screen w-full flex-col group/design-root overflow-x-hidden">
      <div class="hidden border-b border-white/10 text-[10px] uppercase tracking-[0.22em] text-white/45 lg:block">
        <div class="mx-auto flex h-9 max-w-7xl items-center justify-between px-4 lg:px-8">
          <span>Bojonegoro · Jawa Timur</span>
          <span class="hidden sm:block">Liga Nusantara 2026-27</span>
        </div>
      </div>

      <header class="sticky top-0 z-40 border-b border-white/15 bg-background-dark/95 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-2.5 lg:gap-4 lg:px-8 lg:py-4">
          <a href="/" class="flex items-center gap-2.5 lg:gap-3">
            <img src="/logo-64.png" alt="Logo PERSIBO Bojonegoro" class="h-9 w-9 object-contain lg:h-12 lg:w-12" width="48" height="48" fetchpriority="high" />
            <span>
              <span class="font-cond block text-2xl font-bold leading-none tracking-wide text-white lg:text-4xl">PERSIBO<span class="text-primary">.</span></span>
              <span class="block text-[10px] font-semibold tracking-[0.4em] text-primary lg:text-[11px] lg:tracking-[0.52em]">BOJONEGORO</span>
            </span>
          </a>

          <nav class="hidden items-center gap-6 text-[11px] font-semibold uppercase tracking-[0.16em] text-white/60 lg:flex">
            <a href="/" class={`pb-1 transition-colors ${currentPath === '/' ? 'border-b-2 border-primary text-white' : 'hover:text-white'}`}>Beranda</a>
            <a href="/pertandingan" class={`pb-1 transition-colors ${currentPath.startsWith('/pertandingan') ? 'border-b-2 border-primary text-white' : 'hover:text-white'}`}>Jadwal</a>
            <a href="/klasemen" class={`pb-1 transition-colors ${currentPath.startsWith('/klasemen') ? 'border-b-2 border-primary text-white' : 'hover:text-white'}`}>Klasemen</a>
            <a href="/pemain" class={`pb-1 transition-colors ${currentPath.startsWith('/pemain') ? 'border-b-2 border-primary text-white' : 'hover:text-white'}`}>Pemain</a>
            <a href="/tim" class={`pb-1 transition-colors ${currentPath.startsWith('/tim') ? 'border-b-2 border-primary text-white' : 'hover:text-white'}`}>Tim</a>
          </nav>

          <div class="flex shrink-0 items-center gap-3">
            <div class="hidden w-[260px] xl:block">
              <GlobalSearch />
            </div>
            <span class="hidden border border-primary px-3 py-2 text-[10px] font-bold uppercase tracking-[0.18em] text-primary sm:inline-flex">
              2026-27
            </span>
            <button
              id="mobile-search-toggle"
              type="button"
              class="flex h-10 w-10 items-center justify-center border border-white/15 text-white/60 transition-colors hover:border-primary hover:text-primary xl:hidden"
              aria-label="Buka pencarian"
              aria-expanded="false"
              aria-controls="mobile-search-panel"
            >
              <span class="material-symbols-outlined text-xl" data-search-toggle-icon>search</span>
            </button>
          </div>
        </div>

        <nav class="flex items-center justify-between gap-2 border-t border-white/10 px-4 py-2 text-[11px] font-bold uppercase tracking-[0.12em] text-white/45 sm:gap-4 sm:tracking-[0.16em] lg:hidden">
          <a href="/" class={`whitespace-nowrap border-b border-transparent pb-1 ${currentPath === '/' ? 'border-primary text-primary' : 'hover:text-white'}`}>Beranda</a>
          <a href="/pertandingan" class={`whitespace-nowrap border-b border-transparent pb-1 ${currentPath.startsWith('/pertandingan') ? 'border-primary text-primary' : 'hover:text-white'}`}>Jadwal</a>
          <a href="/klasemen" class={`whitespace-nowrap border-b border-transparent pb-1 ${currentPath.startsWith('/klasemen') ? 'border-primary text-primary' : 'hover:text-white'}`}>Klasemen</a>
          <a href="/pemain" class={`whitespace-nowrap border-b border-transparent pb-1 ${currentPath.startsWith('/pemain') ? 'border-primary text-primary' : 'hover:text-white'}`}>Pemain</a>
          <a href="/tim" class={`whitespace-nowrap border-b border-transparent pb-1 ${currentPath.startsWith('/tim') ? 'border-primary text-primary' : 'hover:text-white'}`}>Tim</a>
        </nav>

        <div id="mobile-search-panel" class="hidden border-t border-white/10 px-4 py-3 xl:hidden">
          <GlobalSearch />
        </div>
      </header>

      <script is:inline>
        (function () {
          var toggle = document.getElementById('mobile-search-toggle');
          var panel = document.getElementById('mobile-search-panel');
          var icon = document.querySelector('[data-search-toggle-icon]');
          if (!toggle || !panel) return;

          function setOpen(open) {
            panel.classList.toggle('hidden', !open);
            toggle.setAttribute('aria-expanded', String(open));
            toggle.setAttribute('aria-label', open ? 'Tutup pencarian' : 'Buka pencarian');
            if (icon) icon.textContent = open ? 'close' : 'search';
            if (open) {
              var input = panel.querySelector('[data-search-input]');
              if (input) input.focus();
            }
          }

          toggle.addEventListener('click', function () {
            setOpen(panel.classList.contains('hidden'));
          });

          document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && !panel.classList.contains('hidden')) {
              setOpen(false);
              toggle.focus();
            }
          });
        })();
      </script>

      <!-- Main Content -->
      <main class="relative z-10 flex-1 overflow-y-auto [-ms-scrollbar-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <slot />
      </main>

      <!-- Footer -->
      <footer class="mt-auto border-t border-white/10 bg-[#050407]">
        <div class="mx-auto max-w-7xl px-4 py-10 lg:px-8">
          <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
            <div>
              <div class="flex items-center gap-3">
                <img src="/logo-64.png" alt="Logo PERSIBO Bojonegoro" class="h-10 w-10 object-contain" width="40" height="40" />
                <span class="font-cond text-4xl font-bold uppercase leading-none text-white">PERSIBO<span class="text-primary">.</span></span>
              </div>
              <p class="mt-3 max-w-sm text-sm leading-relaxed text-white/40">
                Situs penggemar PERSIBO Bojonegoro. Data Liga Nusantara, jadwal, dan arsip musim dari iLeague.
              </p>
            </div>

            <div class="grid grid-cols-2 gap-8 text-[10px] uppercase tracking-[0.16em] sm:grid-cols-3">
              <div>
                <p class="mb-3 font-bold text-white/30">Navigasi</p>
                <ul class="space-y-2 text-white/45">
                  <li><a href="/" class="transition-colors hover:text-primary">Beranda</a></li>
                  <li><a href="/pertandingan" class="transition-colors hover:text-primary">Jadwal</a></li>
                  <li><a href="/klasemen" class="transition-colors hover:text-primary">Klasemen</a></li>
                  <li><a href="/pemain" class="transition-colors hover:text-primary">Pemain</a></li>
                  <li><a href="/tim" class="transition-colors hover:text-primary">Tim</a></li>
                </ul>
              </div>
              <div>
                <p class="mb-3 font-bold text-white/30">Informasi</p>
                <ul class="space-y-2 text-white/45">
                  <li><a href="/tim/profil" class="transition-colors hover:text-primary">Profil Tim</a></li>
                  <li><a href="/tim/official" class="transition-colors hover:text-primary">Ofisial & Staf</a></li>
                  <li><a href="/tim/berita" class="transition-colors hover:text-primary">Berita</a></li>
                  <li><a href="/privasi" class="transition-colors hover:text-primary">Kebijakan Privasi</a></li>
                </ul>
              </div>
              <div>
                <p class="mb-3 font-bold text-white/30">Musim</p>
                <ul class="space-y-2 text-white/45">
                  <li><a href="/" class="text-primary">2026-27 · Aktif</a></li>
                  <li><a href="/arsip/2025-26" class="transition-colors hover:text-primary">Arsip 2025-26 ↗</a></li>
                  <li><a href="/arsip/2024-25" class="transition-colors hover:text-primary">Arsip 2024-25 ↗</a></li>
                  <li><a href="/arsip/pemain" class="transition-colors hover:text-primary">Semua pemain ↗</a></li>
                  <li>
                    <a href="https://www.ileague.id/clubs/single/LIGA_NUSANTARA_2026-27/PERSIBO_Bojonegoro"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="inline-flex items-center gap-1 transition-colors hover:text-primary">
                      iLeague.id
                      <span class="material-symbols-outlined text-xs">open_in_new</span>
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="mt-8 flex flex-col gap-2 border-t border-white/10 pt-4 text-[11px] uppercase tracking-[0.16em] text-white/25 sm:flex-row sm:items-center sm:justify-between">
            <span>Jengker Proudly Present · Persibo v2 · © 2026</span>
            <span>Tidak berafiliasi dengan manajemen resmi PERSIBO</span>
          </div>
        </div>
      </footer>

      <!-- Stadium backdrop: pinned to the viewport bottom on every page, purely decorative. -->
      <img
        src="/img/stadium-silhouette.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none fixed bottom-0 left-0 z-0 h-auto max-h-[46vh] w-auto max-w-full select-none object-left-bottom opacity-[0.055] [mask-image:linear-gradient(to_top,black_35%,transparent_100%)]"
      />
      
      <!-- Scroll to Top Button -->
      <button 
        id="scroll-to-top"
        class="fixed bottom-6 right-4 z-30 hidden w-12 h-12 rounded-full bg-primary text-slate-950 shadow-lg hover:bg-primary/90 transition-all opacity-0 pointer-events-none flex items-center justify-center"
        aria-label="Scroll to top"
      >
        <span class="material-symbols-outlined text-2xl">arrow_upward</span>
      </button>
    </div>
  </body>
</html>

<script is:inline>
  // Defer scroll-to-top script
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollToTop);
  } else {
    initScrollToTop();
  }
  
  function initScrollToTop() {
    const scrollToTopBtn = document.getElementById('scroll-to-top');
    if (!scrollToTopBtn) return;

    function toggleScrollButton() {
      if (window.scrollY > 300) {
        scrollToTopBtn.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
        scrollToTopBtn.classList.add('opacity-100');
      } else {
        scrollToTopBtn.classList.add('opacity-0', 'pointer-events-none');
        scrollToTopBtn.classList.remove('opacity-100');
      }
    }

    // Throttle scroll event for performance
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          toggleScrollButton();
          ticking = false;
        });
        ticking = true;
      }
    });
    
    scrollToTopBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
</script>

<style is:global>
  body {
    font-family: 'Lexend', sans-serif;
    min-height: max(884px, 100dvh);
  }
  
  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  
  .font-lexend-extrabold {
    font-family: 'Lexend', sans-serif;
    font-weight: 800;
  }
  
  .bg-gradient-nyeleh {
    background: linear-gradient(135deg, #f97316, #6d28d9);
  }
</style>
